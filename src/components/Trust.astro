---
// Sección de confianza — 6 cards con efecto de disolución turbulenta.
// Frente: sólo el título (impacto visual). Reverso: la explicación.
// El frente se DISUELVE (fractalNoise + luminanceToAlpha + threshold)
// para revelar el reverso — mismo efecto que las fotos puerto-1/puerto-2.
// Trigger: hover en desktop, tap en mobile.

const attributes = [
  {
    title: 'Escalabilidad probada',
    body:
      'Diseñado para pasar de 50 a 500 nodos viales con menos de 15 % de latencia adicional.',
  },
  {
    title: 'Simulación desacoplada',
    body:
      'El motor corre completo antes de reconstruir la visualización. Cero riesgo de decisiones sobre datos parciales.',
  },
  {
    title: 'Trazabilidad de resultados',
    body:
      'Cada ejecución queda registrada con seed, políticas y métricas. Reproducibilidad total.',
  },
  {
    title: 'IA aprendida, no programada',
    body:
      'Las políticas emergen de aprendizaje por refuerzo profundo, no de reglas fijas.',
  },
  {
    title: 'Bimodal por diseño',
    body:
      'Diferencia camiones y livianos desde la simulación: métricas y políticas nunca los promedian.',
  },
];
---

<section class="trust">
  <div class="wrap">
    <div class="trust-head">
      <div class="eyebrow">POR QUÉ CONFIAR</div>
      <h2>Ingeniería para decisiones que importan.</h2>
    </div>
    <div class="trust-grid">
      {
        attributes.map((a, i) => (
          <article class="trust-card" tabindex="0" data-flip data-idx={i}>
            <div class="tc-inner">
              <div class="tc-face tc-back">
                <p>{a.body}</p>
              </div>
              <div
                class="tc-face tc-front"
                style={`filter: url(#tc-dissolve-${i}); -webkit-filter: url(#tc-dissolve-${i})`}
              >
                <span class="tc-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" opacity="0.35" />
                    <path d="M8 12 L16 12" />
                    <path d="M12 8 L16 12 L12 16" />
                  </svg>
                </span>
                <h3>{a.title}</h3>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  {/* SVG con los 6 filtros de disolución (una por card, con seed distinto
      para que ninguna disuelva igual). Oculto pero referenciado por CSS. */}
  <svg class="tc-defs" aria-hidden="true" width="0" height="0" style="position:absolute">
    <defs>
      {attributes.map((_, i) => (
        <filter id={`tc-dissolve-${i}`} x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.022" seed={i * 11 + 3} result="noise" />
          <feColorMatrix in="noise" type="luminanceToAlpha" result="noiseAlpha" />
          <feComponentTransfer in="noiseAlpha">
            <feFuncA type="linear" slope="2">
              <animate
                class="anim-fwd"
                attributeName="slope"
                from="2"
                to="0"
                dur="850ms"
                begin="indefinite"
                fill="freeze"
              />
              <animate
                class="anim-bwd"
                attributeName="slope"
                from="0"
                to="2"
                dur="850ms"
                begin="indefinite"
                fill="freeze"
              />
            </feFuncA>
          </feComponentTransfer>
          <feComponentTransfer>
            <feFuncA type="discrete" tableValues="0 1" />
          </feComponentTransfer>
          <feGaussianBlur stdDeviation="0.5" />
          <feComposite operator="in" in="SourceGraphic" />
        </filter>
      ))}
    </defs>
  </svg>
</section>

<style>
  .trust {
    padding: 110px 0;
    background: rgba(255, 248, 234, 0.72);
    position: relative;
  }
  .trust-head {
    max-width: 640px;
    margin-bottom: 56px;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 600;
    color: var(--navy);
    opacity: 0.55;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 38px;
    margin-top: 14px;
    line-height: 1.2;
    color: var(--navy);
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* ============ DISSOLVE CARD ============
     Estructura simple: back debajo, front encima con filter SVG
     dinámico. Cuando el filter's slope va 2 → 0 el front se disuelve
     píxel a píxel revelando el back. No hay 3D, no rotateY. */
  .trust-card {
    position: relative;
    height: 200px;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    outline: none;
  }
  .tc-inner {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .tc-face {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }
  .tc-back {
    background: var(--navy);
    border: 1px solid rgba(97, 225, 230, 0.35);
    box-shadow: 0 8px 22px rgba(4, 69, 89, 0.2);
    z-index: 1;
  }
  .tc-back p {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 248, 234, 0.92);
    margin: 0;
  }
  .tc-front {
    background: #fff;
    border: 1px solid rgba(4, 69, 89, 0.14);
    box-shadow: 0 6px 18px rgba(4, 69, 89, 0.06);
    z-index: 2;
    /* filter: url(#tc-dissolve-N) — aplicado inline por card */
  }
  .tc-front h3 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.2px;
  }

  .tc-badge {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(97, 225, 230, 0.15);
    color: var(--navy);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 400ms ease, color 400ms ease;
  }
  .trust-card:hover .tc-badge,
  .trust-card:focus-visible .tc-badge,
  .trust-card.flipped .tc-badge {
    background: var(--cyan);
    color: var(--navy-deep);
  }

  /* Focus ring accesible */
  .trust-card:focus-visible {
    box-shadow: 0 0 0 3px rgba(97, 225, 230, 0.55);
    border-radius: 14px;
  }

  @media (max-width: 860px) {
    .trust-grid { grid-template-columns: 1fr; }
    .trust-card { height: 180px; }
    .tc-front h3 { font-size: 20px; }
    .tc-back p { font-size: 13.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tc-badge { transition: none; }
    /* Sin disolución — el hover simplemente cambia opacity del front */
    .tc-front { transition: opacity 300ms ease; }
    .trust-card:hover .tc-front,
    .trust-card:focus-visible .tc-front,
    .trust-card.flipped .tc-front { opacity: 0; }
  }
</style>

<script>
  /**
   * Trust cards con disolución turbulenta.
   *
   * En vez de rotateY 3D, cada card tiene un SVG filter con feTurbulence
   * cuya `slope` va animándose entre 2 (front visible) y 0 (front invisible,
   * back revelado) al pasar el mouse o tap.
   *
   * - Desktop (mouse):  hover in → disuelve. Hover out → recompone.
   * - Mobile (touch):   tap toggle entre estados.
   * - Teclado:          Enter/Espacio hace toggle.
   */
  const cards = document.querySelectorAll<HTMLElement>('[data-flip]');
  cards.forEach((card, i) => {
    const fwd = document.querySelector<SVGAnimateElement>(
      `#tc-dissolve-${i} .anim-fwd`,
    );
    const bwd = document.querySelector<SVGAnimateElement>(
      `#tc-dissolve-${i} .anim-bwd`,
    );
    let flipped = false;

    const dissolveOut = () => {
      try {
        fwd?.beginElement();
      } catch (e) { /* SMIL puede fallar en algunos navegadores muy viejos */ }
    };
    const dissolveIn = () => {
      try {
        bwd?.beginElement();
      } catch (e) {}
    };

    // Hover — sólo dispositivos con puntero real (mouse), evita que en
    // mobile el tap dispare hover fantasma.
    card.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType !== 'mouse') return;
      if (flipped) return; // ya en estado disuelto por tap, no re-disparar
      dissolveOut();
    });
    card.addEventListener('pointerleave', (e) => {
      if ((e as PointerEvent).pointerType !== 'mouse') return;
      if (flipped) return;
      dissolveIn();
    });

    // Tap/click — toggle persistente (útil en mobile y para "fijar" el reverso)
    card.addEventListener('click', () => {
      flipped = !flipped;
      card.classList.toggle('flipped', flipped);
      if (flipped) dissolveOut();
      else dissolveIn();
    });

    // Teclado
    card.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') {
        ke.preventDefault();
        flipped = !flipped;
        card.classList.toggle('flipped', flipped);
        if (flipped) dissolveOut();
        else dissolveIn();
      }
    });
  });
</script>
