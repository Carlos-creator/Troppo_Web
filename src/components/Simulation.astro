---
// Simulación showcase — 4 escenarios auto-ciclando cada 9 segundos.
//
// Escenarios:
//   1. Congestión sin IA — semáforos rojos + cars queueing (atochamiento visible)
//   2. Con IA: flujo optimizado — semáforos verdes, tráfico fluido
//   3. Contingencia manejada — accidente bloquea Ruta Norte, cars se acumulan
//   4. Bimodal — camiones prioritarios en corredor + autos separados
//
// Físicas visuales implementadas:
//   - Car-following: cars mantienen distancia mínima, si el de adelante frena
//     ellos también frenan (queueing natural)
//   - Semáforos rojos DETIENEN cars antes de la línea de stop
//   - Cars restringidos al mapa de tierra vía SVG clipPath (nunca sobre agua)
//   - Aceleración/frenado suave (no cambios instantáneos)
---

<section class="simulation-demo" id="demo">
  <div class="wrap">
    <div class="sim-head">
      <div class="eyebrow">CÓMO SE VE</div>
      <h2>El tráfico del puerto, en 4 escenarios.</h2>
      <p>
        Cada pocos segundos verás una situación distinta: desde el atochamiento
        actual hasta cómo cambia con la IA controlando los semáforos.
      </p>
    </div>

    <div class="sim-shell">
      <div class="sim-viewport" data-scenario="0">
        <svg
          class="sim-map"
          viewBox="0 0 800 500"
          preserveAspectRatio="xMidYMid meet"
          aria-label="Simulación del acceso al Puerto de San Antonio"
        >
          <defs>
            <linearGradient id="oceanGradient" x1="0" x2="1" y1="0" y2="0.5">
              <stop offset="0" stop-color="#022a37" />
              <stop offset="1" stop-color="#044559" />
            </linearGradient>
            <pattern id="waterLines" width="12" height="12" patternUnits="userSpaceOnUse">
              <path d="M 0 6 Q 3 4, 6 6 T 12 6" stroke="rgba(97,225,230,0.14)" stroke-width="0.8" fill="none" />
            </pattern>
            <!-- Clip que restringe vehículos al área de tierra (nunca sobre agua) -->
            <clipPath id="landClip">
              <path d="M 180 0 Q 155 90, 190 180 Q 155 250, 200 320 Q 170 410, 210 500 L 800 500 L 800 0 Z" />
            </clipPath>
          </defs>

          <!-- Océano -->
          <rect x="0" y="0" width="800" height="500" fill="url(#oceanGradient)" />
          <rect x="0" y="0" width="800" height="500" fill="url(#waterLines)" />

          <!-- Costa (tierra irregular) — cream ligeramente más grisáceo
               que #FFF8EA para bajar el contraste con las etiquetas y
               los vehículos sin perder la sensación cálida. -->
          <path
            d="M 180 0 Q 155 90, 190 180 Q 155 250, 200 320 Q 170 410, 210 500 L 800 500 L 800 0 Z"
            fill="#EDE6D3"
          />

          <!-- Puerto: terminales -->
          <g class="port-area">
            <rect x="195" y="30" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <rect x="195" y="48" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <rect x="195" y="66" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <rect x="223" y="39" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <rect x="223" y="57" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <rect x="223" y="75" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <text x="197" y="108" fill="#044559" font-family="Montserrat" font-size="8" font-weight="700" letter-spacing="0.5">PUERTO SAN ANTONIO</text>
          </g>

          <!-- Red vial (asfalto) -->
          <g class="roads" stroke="#151B20" fill="none">
            <!-- Corredor logístico (grueso) -->
            <line x1="185" y1="240" x2="800" y2="240" stroke-width="16" />
            <!-- Ruta norte -->
            <line x1="200" y1="140" x2="800" y2="140" stroke-width="9" />
            <!-- Ruta sur -->
            <line x1="210" y1="340" x2="800" y2="340" stroke-width="9" />
            <!-- Vertical arterial -->
            <line x1="520" y1="0" x2="520" y2="500" stroke-width="9" />
          </g>

          <!-- Líneas de carril -->
          <g class="lanes" stroke="#FFF8EA" fill="none" opacity="0.55">
            <line x1="185" y1="240" x2="800" y2="240" stroke-width="1.5" stroke-dasharray="12 8" />
            <line x1="200" y1="140" x2="800" y2="140" stroke-width="1" stroke-dasharray="8 6" />
            <line x1="210" y1="340" x2="800" y2="340" stroke-width="1" stroke-dasharray="8 6" />
            <line x1="520" y1="0" x2="520" y2="500" stroke-width="1" stroke-dasharray="8 6" />
          </g>

          <!-- Rotonda -->
          <circle cx="520" cy="240" r="34" fill="#FFF8EA" stroke="#151B20" stroke-width="9" />
          <circle cx="520" cy="240" r="12" fill="#61E1E6" opacity="0.4" />
          <circle cx="520" cy="240" r="6" fill="#61E1E6" opacity="0.7" />

          <!-- Semáforos (postes 3-luces en esquinas) -->
          <g class="signal" data-signal="north" transform="translate(500, 115)">
            <rect x="-7" y="-17" width="14" height="34" rx="3" fill="#151B20" />
            <circle class="lens" data-lens="red" cx="0" cy="-10" r="3.5" />
            <circle class="lens" data-lens="yellow" cx="0" cy="0" r="3.5" />
            <circle class="lens" data-lens="green" cx="0" cy="10" r="3.5" />
          </g>
          <g class="signal" data-signal="south" transform="translate(540, 365)">
            <rect x="-7" y="-17" width="14" height="34" rx="3" fill="#151B20" />
            <circle class="lens" data-lens="red" cx="0" cy="-10" r="3.5" />
            <circle class="lens" data-lens="yellow" cx="0" cy="0" r="3.5" />
            <circle class="lens" data-lens="green" cx="0" cy="10" r="3.5" />
          </g>
          <g class="signal" data-signal="east" transform="translate(720, 210)">
            <rect x="-7" y="-17" width="14" height="34" rx="3" fill="#151B20" />
            <circle class="lens" data-lens="red" cx="0" cy="-10" r="3.5" />
            <circle class="lens" data-lens="yellow" cx="0" cy="0" r="3.5" />
            <circle class="lens" data-lens="green" cx="0" cy="10" r="3.5" />
          </g>

          <!-- Etiquetas -->
          <g class="labels" font-family="Montserrat" font-weight="600">
            <text x="30" y="45" fill="#61E1E6" opacity="0.55" font-size="10" letter-spacing="1">OCÉANO PACÍFICO</text>
            <text x="475" y="245" fill="#044559" font-size="8" text-anchor="end" opacity="0.6">Rotonda</text>
            <text x="795" y="228" fill="#044559" font-size="9" text-anchor="end" font-weight="700" letter-spacing="0.5">CORREDOR LOGÍSTICO</text>
            <text x="795" y="128" fill="#044559" font-size="8" text-anchor="end" opacity="0.65">Ruta Norte</text>
            <text x="795" y="328" fill="#044559" font-size="8" text-anchor="end" opacity="0.65">Ruta Sur</text>
            <text x="524" y="14" fill="#044559" font-size="8" opacity="0.65">Vía Central</text>
          </g>

          <!-- Alert overlay para escenario contingencia -->
          <g class="alert-overlay" data-alert="off">
            <circle cx="360" cy="140" r="20" fill="#ff5b5b" opacity="0.25" />
            <circle cx="360" cy="140" r="12" fill="#ff5b5b" opacity="0.5" />
            <path d="M 353 132 L 367 148 M 367 132 L 353 148" stroke="#151B20" stroke-width="2.5" stroke-linecap="round" />
            <text x="360" y="115" fill="#ff5b5b" text-anchor="middle" font-family="Montserrat" font-size="9" font-weight="700" letter-spacing="1">ACCIDENTE</text>
          </g>

          <!-- Vehículos (clip a tierra: nunca sobre agua) -->
          <g class="cars" clip-path="url(#landClip)"></g>
        </svg>

        <!-- HUD flotante -->
        <div class="sim-hud">
          <div class="hud-badge" data-hud-tone="off">
            <span class="hud-dot"></span>
            <span data-hud="badge">CARGANDO</span>
          </div>
        </div>
      </div>

      <!-- Panel lateral (métricas) -->
      <aside class="sim-side">
        <div class="side-counter">
          <span data-side="index">1</span>
          <small>/ 4 escenarios</small>
        </div>
        <div class="side-content">
          <h3 data-side="title">—</h3>
          <p data-side="desc">—</p>
        </div>
        <div class="side-metrics">
          <div class="metric-row">
            <span class="metric-label">Vehículos activos</span>
            <span class="metric-value" data-metric="vehicles">—</span>
          </div>
          <div class="metric-row">
            <span class="metric-label">Espera promedio</span>
            <span class="metric-value" data-metric="wait">—</span>
          </div>
          <div class="metric-row">
            <span class="metric-label">Emisiones CO₂</span>
            <span class="metric-value" data-metric="co2">—</span>
          </div>
          <div class="metric-row highlight" data-highlight="off">
            <span class="metric-label">Reducción CO₂ con Troppo</span>
            <span class="metric-value" data-metric="reduction">—</span>
          </div>
        </div>
      </aside>

      <!-- Selector de escenario (dots).
           Está fuera del panel lateral para que en mobile pueda
           colocarse justo debajo del viewport y no obligue a scrollear
           por todo el metric panel para cambiar de escenario. -->
      <div class="side-dots" role="tablist" aria-label="Elegir escenario">
        <button type="button" class="dot" aria-label="Escenario 1"></button>
        <button type="button" class="dot" aria-label="Escenario 2"></button>
        <button type="button" class="dot" aria-label="Escenario 3"></button>
        <button type="button" class="dot" aria-label="Escenario 4"></button>
      </div>
    </div>
  </div>
</section>

<style>
  .simulation-demo {
    padding: 110px 0;
    background: rgba(3, 53, 68, 0.84);
    color: var(--cream);
  }
  .sim-head { max-width: 640px; margin-bottom: 48px; }
  .eyebrow {
    font-size: 14px;
    font-weight: 600;
    color: var(--cyan);
    opacity: 0.9;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 38px;
    margin-top: 14px;
    line-height: 1.2;
    color: var(--cream);
  }
  .sim-head p {
    margin-top: 16px;
    font-size: 15px;
    color: rgba(255, 248, 234, 0.75);
    max-width: 520px;
  }

  .sim-shell {
    display: grid;
    grid-template-columns: 1fr 320px;
    grid-template-areas:
      "view side"
      "dots side";
    grid-template-rows: 1fr auto;
    gap: 24px;
    align-items: stretch;
  }
  .sim-viewport { grid-area: view; }
  .sim-side { grid-area: side; }
  .side-dots { grid-area: dots; }
  .sim-viewport {
    position: relative;
    background: var(--navy);
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 8 / 5;
  }
  .sim-map { display: block; width: 100%; height: 100%; }

  /* Semáforos */
  .signal {
    transition: opacity 500ms ease;
  }
  .sim-viewport[data-show-signals="false"] .signal {
    opacity: 0;
    pointer-events: none;
  }
  .signal .lens {
    fill: rgba(255, 248, 234, 0.12);
    transition: fill 300ms ease, filter 300ms ease;
  }
  .signal[data-state="red"] .lens[data-lens="red"] {
    fill: #ff5b5b;
    filter: drop-shadow(0 0 6px #ff5b5b);
  }
  .signal[data-state="yellow"] .lens[data-lens="yellow"] {
    fill: #ffc93c;
    filter: drop-shadow(0 0 6px #ffc93c);
  }
  .signal[data-state="green"] .lens[data-lens="green"] {
    fill: var(--lime);
    filter: drop-shadow(0 0 6px var(--lime));
  }

  /* Vehículos */
  .cars :global(rect.car) {
    fill: var(--cyan);
    stroke: rgba(0, 0, 0, 0.35);
    stroke-width: 0.5;
  }
  .cars :global(rect.truck) {
    fill: var(--lime);
    stroke: rgba(0, 0, 0, 0.35);
    stroke-width: 0.5;
  }

  /* Alert overlay */
  .alert-overlay {
    opacity: 0;
    transition: opacity 400ms ease;
    pointer-events: none;
  }
  .alert-overlay[data-alert="on"] {
    opacity: 1;
    animation: alert-blink 1.4s ease-in-out infinite;
  }
  @keyframes alert-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.55; }
  }

  /* HUD */
  .sim-hud {
    position: absolute;
    top: 16px;
    left: 16px;
    pointer-events: none;
  }
  .hud-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    background: rgba(21, 27, 32, 0.78);
    backdrop-filter: blur(8px);
    border-radius: 100px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--cyan);
    border: 1px solid rgba(97, 225, 230, 0.28);
    transition: color 250ms, border-color 250ms;
  }
  .hud-badge[data-hud-tone="bad"] {
    color: #ff5b5b;
    border-color: rgba(255, 91, 91, 0.4);
  }
  .hud-badge[data-hud-tone="good"] {
    color: var(--lime);
    border-color: rgba(209, 235, 120, 0.5);
  }
  .hud-badge[data-hud-tone="warn"] {
    color: #ffc93c;
    border-color: rgba(255, 201, 60, 0.4);
  }
  .hud-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
    animation: hud-pulse 1.2s ease-in-out infinite;
  }
  @keyframes hud-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }

  /* Panel lateral */
  .sim-side {
    background: var(--navy);
    border-radius: 20px;
    padding: 24px;
    color: var(--cream);
    display: flex;
    flex-direction: column;
    gap: 18px;
    overflow: hidden;
    min-width: 0;
  }
  .side-counter {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-serif);
    color: var(--cyan);
    flex-wrap: wrap;
  }
  .side-counter span {
    font-size: 34px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .side-counter small {
    font-family: var(--font-sans);
    font-size: 11px;
    color: rgba(255, 248, 234, 0.55);
    font-weight: 500;
    letter-spacing: 0.3px;
  }
  .side-content {
    min-width: 0;
  }
  .side-content h3 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.25;
    color: var(--cream);
    margin-bottom: 8px;
    min-height: 48px;
    overflow-wrap: break-word;
  }
  .side-content p {
    font-size: 13px;
    color: rgba(255, 248, 234, 0.7);
    line-height: 1.45;
  }
  .side-metrics { display: flex; flex-direction: column; }
  .metric-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px solid rgba(255, 248, 234, 0.1);
  }
  .metric-row:first-child { border-top: 1px solid rgba(255, 248, 234, 0.1); }
  .metric-label {
    font-size: 12px;
    color: rgba(255, 248, 234, 0.6);
    letter-spacing: 0.3px;
  }
  .metric-value {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
    color: var(--cream);
    font-variant-numeric: tabular-nums;
    transition: color 300ms;
  }
  .metric-row.highlight .metric-value {
    color: var(--lime);
    font-size: 22px;
  }
  .metric-row.highlight[data-highlight="off"] .metric-value {
    color: rgba(255, 248, 234, 0.3);
  }
  .side-dots {
    display: flex;
    gap: 14px;
    justify-content: center;
    align-items: center;
    padding: 14px 8px;
    background: rgba(255, 248, 234, 0.04);
    border: 1px solid rgba(255, 248, 234, 0.10);
    border-radius: 100px;
  }
  .dot {
    width: 34px;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 248, 234, 0.2);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }
  .dot:hover { background: rgba(255, 248, 234, 0.4); }
  .dot.is-active,
  .dot[aria-current="true"] {
    background: var(--lime);
    box-shadow: 0 0 10px rgba(209, 235, 120, 0.7);
  }

  @media (max-width: 860px) {
    .sim-shell {
      grid-template-columns: 1fr;
      /* Dots quedan JUSTO debajo del viewport, antes del panel de
         métricas — así no hay que scrollear para cambiar escenario. */
      grid-template-areas:
        "view"
        "dots"
        "side";
      grid-template-rows: auto auto 1fr;
    }
    .sim-viewport { aspect-ratio: 4 / 3; }
    h2 { font-size: 30px; }

    /* Dots más grandes y con más aire en mobile — se acceden con tap
       cómodo (min ~48px de área táctil por dot). */
    .side-dots {
      gap: 12px;
      padding: 14px 12px;
    }
    .dot {
      width: 54px;
      height: 10px;
      border-radius: 5px;
      /* Aumentar el hit-area con box-shadow invisible no aporta a11y —
         mejor un pseudo-elemento que extiende el touch target. */
      position: relative;
    }
    .dot::before {
      content: '';
      position: absolute;
      inset: -18px -6px;
    }
    .dot.is-active,
    .dot[aria-current="true"] {
      transform: scale(1.05);
    }
  }
</style>

<script>
  type Point = { x: number; y: number };
  type LightState = 'red' | 'yellow' | 'green';
  type VehicleKind = 'car' | 'truck';

  const SVG_NS = 'http://www.w3.org/2000/svg';

  // Rutas: cada una es una polilínea 2 puntos horizontal/vertical.
  // Los extremos están fuera del viewport para que cars entren/salen naturalmente
  // (los que quedan "sobre agua" son ocultados por el clipPath del <g class="cars">).
  const ROUTES: Record<string, { path: Point[]; length: number }> = {};
  const routeLength = (path: Point[]): number => {
    let t = 0;
    for (let i = 1; i < path.length; i++) t += Math.hypot(path[i].x - path[i - 1].x, path[i].y - path[i - 1].y);
    return t;
  };
  const defRoute = (id: string, path: Point[]) => {
    ROUTES[id] = { path, length: routeLength(path) };
  };
  // Corredor y vertical BYPAS la rotonda en (520,240) r=34. Waypoints extra
  // hacen que los cars roden por encima/al lado en vez de atravesarla.
  defRoute('corredorWE', [
    { x: -40, y: 240 },
    { x: 470, y: 240 }, // aproximación
    { x: 490, y: 210 }, // bump NE
    { x: 550, y: 210 }, // top
    { x: 570, y: 240 }, // bump SE
    { x: 830, y: 240 },
  ]);
  defRoute('corredorEW', [
    { x: 830, y: 240 },
    { x: 570, y: 240 },
    { x: 550, y: 270 },
    { x: 490, y: 270 },
    { x: 470, y: 240 },
    { x: -40, y: 240 },
  ]);
  defRoute('verticalNS', [
    { x: 520, y: -40 },
    { x: 520, y: 205 },
    { x: 550, y: 225 },
    { x: 550, y: 255 },
    { x: 520, y: 275 },
    { x: 520, y: 530 },
  ]);
  defRoute('verticalSN', [
    { x: 520, y: 530 },
    { x: 520, y: 275 },
    { x: 490, y: 255 },
    { x: 490, y: 225 },
    { x: 520, y: 205 },
    { x: 520, y: -40 },
  ]);
  // Rutas rectas (no cruzan la rotonda)
  defRoute('norteWE',    [{ x: -40, y: 140 }, { x: 830, y: 140 }]);
  defRoute('norteEW',    [{ x: 830, y: 140 }, { x: -40, y: 140 }]);
  defRoute('surWE',      [{ x: -40, y: 340 }, { x: 830, y: 340 }]);
  defRoute('surEW',      [{ x: 830, y: 340 }, { x: -40, y: 340 }]);

  // Puntos de detención por semáforo (rojo). Progress = 0..1 sobre la ruta.
  // Valores recalculados para las rutas con bypass de rotonda (más largas).
  const SIGNAL_STOPS: Record<string, Array<{ routeId: string; progress: number }>> = {
    east:  [
      { routeId: 'corredorWE', progress: 0.87 }, // stop x≈712 (después del bypass)
      { routeId: 'corredorEW', progress: 0.11 }, // stop desde el este
    ],
    north: [
      { routeId: 'verticalNS', progress: 0.27 }, // stop y≈120 (antes del bypass)
    ],
    south: [
      { routeId: 'verticalSN', progress: 0.28 }, // stop y≈360 (antes del bypass)
    ],
  };

  interface Vehicle {
    kind: VehicleKind;
    routeId: string;
    offset: number;
    baseSpeed: number; // unidades: progress por 100ms
  }

  interface FrictionZone {
    routeId: string;
    from: number;
    to: number;
    multiplier: number; // 0..1 — velocidad reducida dentro de la zona
    truckExtra?: number; // multiplier extra para camiones (más lento aún)
  }

  interface Scenario {
    id: string;
    title: string;
    desc: string;
    hud: string;
    hudTone: 'bad' | 'good' | 'warn' | 'off';
    signals: { north: LightState; south: LightState; east: LightState };
    hideSignals?: boolean; // jam scenario oculta los semáforos (no son la causa)
    alert: boolean;
    speedMul: number;
    vehicles: Vehicle[];
    extraStops?: Array<{ routeId: string; progress: number }>;
    frictionZones?: FrictionZone[];
    metrics: { vehicles: string; wait: string; co2: string; reduction: string };
    highlight: 'on' | 'off';
  }

  // JAM POOL: MUCHOS camiones en corredor + más vehículos en general.
  // La causa del atochamiento son las friction zones en la rotonda
  // (camiones frenan mucho al entrar) — no hay semáforos rojos.
  const jamPool: Vehicle[] = [
    // Corredor WE: 8 camiones + 3 cars formando cola larga hacia la rotonda
    { kind: 'truck', routeId: 'corredorWE', offset: 0.05, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.14, baseSpeed: 0.020 },
    { kind: 'car',   routeId: 'corredorWE', offset: 0.22, baseSpeed: 0.025 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.30, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.38, baseSpeed: 0.020 },
    { kind: 'car',   routeId: 'corredorWE', offset: 0.45, baseSpeed: 0.025 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.52, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.58, baseSpeed: 0.020 },
    // Corredor EW: 4 vehículos también atascados
    { kind: 'truck', routeId: 'corredorEW', offset: 0.10, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorEW', offset: 0.22, baseSpeed: 0.020 },
    { kind: 'car',   routeId: 'corredorEW', offset: 0.35, baseSpeed: 0.025 },
    { kind: 'truck', routeId: 'corredorEW', offset: 0.60, baseSpeed: 0.020 },
    // Vertical NS: 3 cars aproximándose a la rotonda desde el norte
    { kind: 'car',   routeId: 'verticalNS', offset: 0.15, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'verticalNS', offset: 0.26, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'verticalNS', offset: 0.35, baseSpeed: 0.028 },
    // Vertical SN: 3 desde el sur
    { kind: 'car',   routeId: 'verticalSN', offset: 0.18, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'verticalSN', offset: 0.30, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'verticalSN', offset: 0.42, baseSpeed: 0.028 },
    // Norte y sur (no cruzan rotonda pero dan sensación de tráfico general)
    { kind: 'car',   routeId: 'norteWE',    offset: 0.25, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteWE',    offset: 0.55, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteEW',    offset: 0.35, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteEW',    offset: 0.70, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surWE',      offset: 0.30, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surWE',      offset: 0.65, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surEW',      offset: 0.45, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surEW',      offset: 0.75, baseSpeed: 0.028 },
  ];

  // FLOW POOL: mismos vehículos que jam pero sin friction — IA optimiza el flujo
  const flowPool: Vehicle[] = jamPool.map((v) => ({ ...v }));

  // Escenario 3 (contingencia): cars atascados + redirigidos.
  // Balanceado a 26 vehículos (mismo tamaño que jam/flow).
  const contingencyPool: Vehicle[] = [
    // Corredor WE (redirigidos, muchos)
    { kind: 'truck', routeId: 'corredorWE', offset: 0.10, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.28, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.46, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.64, baseSpeed: 0.020 },
    { kind: 'car',   routeId: 'corredorWE', offset: 0.82, baseSpeed: 0.025 },
    { kind: 'truck', routeId: 'corredorEW', offset: 0.15, baseSpeed: 0.020 },
    { kind: 'car',   routeId: 'corredorEW', offset: 0.35, baseSpeed: 0.025 },
    { kind: 'truck', routeId: 'corredorEW', offset: 0.55, baseSpeed: 0.020 },
    { kind: 'car',   routeId: 'corredorEW', offset: 0.78, baseSpeed: 0.025 },
    // Ruta Norte WE: cars atascados desde el oeste (stop en 0.44)
    { kind: 'truck', routeId: 'norteWE', offset: 0.20, baseSpeed: 0.025 },
    { kind: 'car',   routeId: 'norteWE', offset: 0.28, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteWE', offset: 0.34, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteWE', offset: 0.40, baseSpeed: 0.028 },
    // Ruta Norte EW: cars atascados desde el este (stop en 0.52)
    { kind: 'car',   routeId: 'norteEW', offset: 0.35, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteEW', offset: 0.42, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteEW', offset: 0.48, baseSpeed: 0.028 },
    // Sur (redirigidos — el flujo se va por acá)
    { kind: 'car',   routeId: 'surWE', offset: 0.15, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surWE', offset: 0.40, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surWE', offset: 0.65, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surWE', offset: 0.85, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surEW', offset: 0.25, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surEW', offset: 0.60, baseSpeed: 0.028 },
    // Vertical
    { kind: 'car',   routeId: 'verticalNS', offset: 0.25, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'verticalNS', offset: 0.60, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'verticalSN', offset: 0.35, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'verticalSN', offset: 0.70, baseSpeed: 0.028 },
  ];

  // Escenario 4 (bimodal): muchos camiones en corredor + autos en secundarias.
  // Balanceado a 26 vehículos (mismo tamaño que jam/flow/contingencia).
  const bimodalPool: Vehicle[] = [
    // Corredor WE — muchos camiones (feature bimodal principal)
    { kind: 'truck', routeId: 'corredorWE', offset: 0.05, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.18, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.32, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.45, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.58, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.72, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.86, baseSpeed: 0.020 },
    // Corredor EW — camiones y autos mixtos
    { kind: 'truck', routeId: 'corredorEW', offset: 0.15, baseSpeed: 0.020 },
    { kind: 'truck', routeId: 'corredorEW', offset: 0.42, baseSpeed: 0.020 },
    { kind: 'car',   routeId: 'corredorEW', offset: 0.68, baseSpeed: 0.025 },
    { kind: 'truck', routeId: 'corredorEW', offset: 0.88, baseSpeed: 0.020 },
    // Ruta norte — autos
    { kind: 'car',   routeId: 'norteWE',    offset: 0.15, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteWE',    offset: 0.40, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteWE',    offset: 0.65, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteWE',    offset: 0.88, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteEW',    offset: 0.25, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'norteEW',    offset: 0.60, baseSpeed: 0.028 },
    // Ruta sur — autos
    { kind: 'car',   routeId: 'surWE',      offset: 0.18, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surWE',      offset: 0.52, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surWE',      offset: 0.82, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surEW',      offset: 0.30, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'surEW',      offset: 0.65, baseSpeed: 0.028 },
    // Vertical — autos
    { kind: 'car',   routeId: 'verticalNS', offset: 0.25, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'verticalNS', offset: 0.65, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'verticalSN', offset: 0.30, baseSpeed: 0.028 },
    { kind: 'car',   routeId: 'verticalSN', offset: 0.70, baseSpeed: 0.028 },
  ];

  const SCENARIOS: Scenario[] = [
    {
      id: 'jam',
      title: 'Congestión sin IA',
      desc: 'Sin coordinación de semáforos, los camiones frenan al entrar a la rotonda y la cola se acumula por todo el corredor logístico.',
      hud: 'CONGESTIÓN',
      hudTone: 'bad',
      signals: { north: 'green', south: 'green', east: 'green' },
      hideSignals: true, // no hay semaforos operativos en este escenario
      alert: false,
      speedMul: 1.0,
      vehicles: jamPool,
      // Friction fuerte en la zona de bypass de la rotonda para todos los sentidos
      frictionZones: [
        { routeId: 'corredorWE', from: 0.55, to: 0.75, multiplier: 0.12 },
        { routeId: 'corredorEW', from: 0.28, to: 0.48, multiplier: 0.12 },
        { routeId: 'verticalNS', from: 0.40, to: 0.60, multiplier: 0.18 },
        { routeId: 'verticalSN', from: 0.42, to: 0.62, multiplier: 0.18 },
      ],
      metrics: { vehicles: '26', wait: '9.2 s', co2: '87 kg/h', reduction: '—' },
      highlight: 'off',
    },
    {
      id: 'ai-flow',
      title: 'Optimización con IA',
      desc: 'La red neuronal coordina la rotonda y los semáforos en tiempo real. Los vehículos mantienen su velocidad al cruzar.',
      hud: 'FLUJO OPTIMIZADO',
      hudTone: 'good',
      signals: { north: 'green', south: 'green', east: 'green' },
      alert: false,
      speedMul: 1.5,
      vehicles: flowPool,
      // Sin friction — IA gestiona la rotonda sin frenar
      metrics: { vehicles: '26', wait: '2.6 s', co2: '49 kg/h', reduction: '−44 %' },
      highlight: 'on',
    },
    {
      id: 'contingency',
      title: 'Contingencia manejada',
      desc: 'Un accidente bloquea la Ruta Norte en ambos sentidos. Los vehículos se acumulan antes del incidente y la IA redirige por corredor y sur.',
      hud: 'REDIRECCIONANDO',
      hudTone: 'warn',
      signals: { north: 'red', south: 'green', east: 'green' },
      alert: true,
      speedMul: 1.3,
      vehicles: contingencyPool,
      extraStops: [
        { routeId: 'norteWE', progress: 0.44 }, // desde el oeste, antes del accidente (x=340)
        { routeId: 'norteEW', progress: 0.52 }, // desde el este (x=380 aprox)
      ],
      metrics: { vehicles: '26', wait: '4.1 s', co2: '58 kg/h', reduction: '−32 %' },
      highlight: 'on',
    },
    {
      id: 'bimodal',
      title: 'Bimodal: carga + livianos',
      desc: 'La IA prioriza el corredor logístico para camiones mientras los autos siguen fluidos por rutas secundarias.',
      hud: 'PRIORIDAD BIMODAL',
      hudTone: 'good',
      signals: { north: 'green', south: 'green', east: 'green' },
      alert: false,
      speedMul: 1.4,
      vehicles: bimodalPool,
      metrics: { vehicles: '26', wait: '3.0 s', co2: '52 kg/h', reduction: '−38 %' },
      highlight: 'on',
    },
  ];

  const SCENARIO_DURATION = 9000;
  // Constantes de física (en unidades de progress relativas al mapa)
  const MIN_GAP_PX = 12;   // distancia mínima entre bumpers (queueing tight)
  const SLOW_GAP_PX = 65;  // empezar a frenar cuando hay este gap
  const STOP_APPROACH_PX = 90; // empezar a frenar antes de un stop
  const STOP_LINE_PX = 6;  // distancia final ante línea de stop

  const viewport = document.querySelector<HTMLElement>('.sim-viewport');
  const svg = viewport?.querySelector<SVGSVGElement>('.sim-map');
  const carsGroup = svg?.querySelector<SVGGElement>('.cars');
  const alertOverlay = svg?.querySelector<SVGGElement>('.alert-overlay');
  const signalEls: Record<string, SVGGElement | null> = {
    north: svg?.querySelector<SVGGElement>('[data-signal="north"]') ?? null,
    south: svg?.querySelector<SVGGElement>('[data-signal="south"]') ?? null,
    east: svg?.querySelector<SVGGElement>('[data-signal="east"]') ?? null,
  };
  const hudBadge = document.querySelector<HTMLElement>('.hud-badge');
  const hudText = document.querySelector<HTMLElement>('[data-hud="badge"]');
  const sideIndex = document.querySelector<HTMLElement>('[data-side="index"]');
  const sideTitle = document.querySelector<HTMLElement>('[data-side="title"]');
  const sideDesc = document.querySelector<HTMLElement>('[data-side="desc"]');
  const metricEls = {
    vehicles: document.querySelector<HTMLElement>('[data-metric="vehicles"]'),
    wait: document.querySelector<HTMLElement>('[data-metric="wait"]'),
    co2: document.querySelector<HTMLElement>('[data-metric="co2"]'),
    reduction: document.querySelector<HTMLElement>('[data-metric="reduction"]'),
  };
  const highlightRow = document.querySelector<HTMLElement>('[data-highlight]');
  // Scoped a .side-dots — evita capturar el <span class="dot"> del Hero
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.side-dots .dot'));

  interface RuntimeCar extends Vehicle {
    el: SVGRectElement;
    progress: number;
    speed: number; // actual current speed (interpolado)
  }
  let runtimeCars: RuntimeCar[] = [];
  let currentIdx = 0;
  let advanceTimer = 0;
  let animationFrame = 0;
  let lastTs = 0;
  let currentSpeedMul = 1;
  let currentStops: Array<{ routeId: string; progress: number }> = [];
  let currentFrictionZones: FrictionZone[] = [];

  const routePoint = (path: Point[], progress: number) => {
    const totalLen = routeLength(path);
    const target = progress * totalLen;
    let acc = 0;
    for (let i = 1; i < path.length; i++) {
      const dx = path[i].x - path[i - 1].x;
      const dy = path[i].y - path[i - 1].y;
      const seg = Math.hypot(dx, dy);
      if (acc + seg >= target) {
        const t = (target - acc) / seg;
        return {
          p: { x: path[i - 1].x + dx * t, y: path[i - 1].y + dy * t },
          angle: (Math.atan2(dy, dx) * 180) / Math.PI,
        };
      }
      acc += seg;
    }
    return { p: path[path.length - 1], angle: 0 };
  };

  const buildCars = (vehicles: Vehicle[]) => {
    if (!carsGroup) return;
    carsGroup.innerHTML = '';
    runtimeCars = vehicles.map((v) => {
      const el = document.createElementNS(SVG_NS, 'rect');
      el.setAttribute('class', v.kind);
      el.setAttribute('width', v.kind === 'truck' ? '22' : '11');
      el.setAttribute('height', v.kind === 'truck' ? '8' : '6');
      el.setAttribute('rx', '1');
      carsGroup.appendChild(el);
      return { ...v, el, progress: v.offset, speed: v.baseSpeed * currentSpeedMul };
    });
  };

  // Motor de física: car-following + stopping en semáforos rojos.
  const tick = (dt: number) => {
    // Agrupar cars por ruta y ordenar por progress (para car-following)
    const carsByRoute: Record<string, RuntimeCar[]> = {};
    runtimeCars.forEach((c) => {
      if (!carsByRoute[c.routeId]) carsByRoute[c.routeId] = [];
      carsByRoute[c.routeId].push(c);
    });

    Object.entries(carsByRoute).forEach(([routeId, group]) => {
      const routeInfo = ROUTES[routeId];
      if (!routeInfo) return;
      // Ordenar ascendente por progress (car en menor progress = "atrás")
      group.sort((a, b) => a.progress - b.progress);

      // Stops activos para esta ruta
      const stopsHere = currentStops.filter((s) => s.routeId === routeId);

      group.forEach((car, i) => {
        let targetFactor = 1;

        // 1. Car-following: revisar el car de adelante (i+1 en el orden ascendente)
        const nextCar = group[i + 1];
        if (nextCar) {
          const gapProgress = nextCar.progress - car.progress;
          const gapPx = gapProgress * routeInfo.length - (nextCar.kind === 'truck' ? 22 : 11);
          if (gapPx < MIN_GAP_PX) {
            targetFactor = 0;
          } else if (gapPx < SLOW_GAP_PX) {
            const f = (gapPx - MIN_GAP_PX) / (SLOW_GAP_PX - MIN_GAP_PX);
            if (f < targetFactor) targetFactor = f;
          }
        }

        // 2. Stops ahead (semáforos rojos, accidentes)
        stopsHere.forEach((stop) => {
          if (car.progress >= stop.progress) return; // ya lo pasó
          const distPx = (stop.progress - car.progress) * routeInfo.length;
          if (distPx < STOP_LINE_PX) {
            targetFactor = 0;
          } else if (distPx < STOP_APPROACH_PX) {
            const f = (distPx - STOP_LINE_PX) / (STOP_APPROACH_PX - STOP_LINE_PX);
            if (f < targetFactor) targetFactor = f;
          }
        });

        // 3. Friction zones (rotonda sin IA — camiones frenan al entrar)
        currentFrictionZones.forEach((zone) => {
          if (zone.routeId !== routeId) return;
          if (car.progress >= zone.from && car.progress <= zone.to) {
            // Camiones se frenan aún más si truckExtra está definido
            let mul = zone.multiplier;
            if (car.kind === 'truck' && zone.truckExtra !== undefined) {
              mul *= zone.truckExtra;
            }
            if (mul < targetFactor) targetFactor = mul;
          }
        });

        // 3. Interpolar velocidad hacia el target (frenado/aceleración suave)
        const desiredSpeed = car.baseSpeed * currentSpeedMul * targetFactor;
        car.speed += (desiredSpeed - car.speed) * 0.18;

        // Avanzar
        car.progress += car.speed * (dt / 100);
        if (car.progress > 1) car.progress -= 1;

        // Render
        const { p, angle } = routePoint(routeInfo.path, car.progress);
        const w = car.kind === 'truck' ? 22 : 11;
        const h = car.kind === 'truck' ? 8 : 6;
        car.el.setAttribute('x', String(p.x - w / 2));
        car.el.setAttribute('y', String(p.y - h / 2));
        car.el.setAttribute('transform', `rotate(${angle} ${p.x} ${p.y})`);
      });
    });
  };

  const loop = (ts: number) => {
    const dt = lastTs ? Math.min(ts - lastTs, 50) : 16;
    lastTs = ts;
    tick(dt);
    animationFrame = requestAnimationFrame(loop);
  };

  // Calcular los stops activos (semáforos rojos + extras del escenario)
  const computeActiveStops = (sc: Scenario) => {
    const stops: Array<{ routeId: string; progress: number }> = [];
    (['north', 'south', 'east'] as const).forEach((sig) => {
      if (sc.signals[sig] === 'red') stops.push(...SIGNAL_STOPS[sig]);
    });
    if (sc.extraStops) stops.push(...sc.extraStops);
    return stops;
  };

  const applyScenario = (index: number) => {
    const sc = SCENARIOS[index];
    if (!sc) return;
    currentIdx = index;
    currentSpeedMul = sc.speedMul;
    currentStops = computeActiveStops(sc);
    currentFrictionZones = sc.frictionZones ?? [];

    viewport?.setAttribute('data-scenario', String(index));
    viewport?.setAttribute('data-show-signals', sc.hideSignals ? 'false' : 'true');

    // Signals
    signalEls.north?.setAttribute('data-state', sc.signals.north);
    signalEls.south?.setAttribute('data-state', sc.signals.south);
    signalEls.east?.setAttribute('data-state', sc.signals.east);

    // Alert
    alertOverlay?.setAttribute('data-alert', sc.alert ? 'on' : 'off');

    // HUD
    if (hudText) hudText.textContent = sc.hud;
    hudBadge?.setAttribute('data-hud-tone', sc.hudTone);

    // Panel
    if (sideIndex) sideIndex.textContent = String(index + 1);
    if (sideTitle) sideTitle.textContent = sc.title;
    if (sideDesc) sideDesc.textContent = sc.desc;

    // Metrics
    if (metricEls.vehicles) metricEls.vehicles.textContent = sc.metrics.vehicles;
    if (metricEls.wait) metricEls.wait.textContent = sc.metrics.wait;
    if (metricEls.co2) metricEls.co2.textContent = sc.metrics.co2;
    if (metricEls.reduction) metricEls.reduction.textContent = sc.metrics.reduction;
    highlightRow?.setAttribute('data-highlight', sc.highlight);

    // Dots — belt & suspenders: aria-current (semántico) + clase (fallback)
    dots.forEach((d, i) => {
      if (i === index) {
        d.setAttribute('aria-current', 'true');
        d.classList.add('is-active');
      } else {
        d.removeAttribute('aria-current');
        d.classList.remove('is-active');
      }
    });

    // Rebuild cars con pool de este escenario
    buildCars(sc.vehicles);
  };

  const advance = () => applyScenario((currentIdx + 1) % SCENARIOS.length);

  const startAutoAdvance = () => {
    window.clearInterval(advanceTimer);
    advanceTimer = window.setInterval(advance, SCENARIO_DURATION);
  };

  const jumpTo = (index: number) => {
    applyScenario(index);
    startAutoAdvance(); // resetear timer al saltar manualmente
  };

  if (viewport && svg && carsGroup) {
    applyScenario(0);
    animationFrame = requestAnimationFrame(loop);
    startAutoAdvance();

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => jumpTo(index));
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        window.clearInterval(advanceTimer);
        cancelAnimationFrame(animationFrame);
      } else {
        lastTs = 0;
        animationFrame = requestAnimationFrame(loop);
        startAutoAdvance();
      }
    });
  }
</script>
