---
// Simulación showcase — 4 escenarios auto-ciclando cada 8 segundos.
//
// Escenarios:
//   1. Congestión sin IA — semáforos rojos, muchos vehículos lentos (atochamiento)
//   2. Con IA: flujo optimizado — semáforos coordinados verdes, tráfico fluido
//   3. Contingencia manejada — accidente en ruta norte, IA redirige tráfico
//   4. Bimodal — camiones prioritarios en corredor logístico + autos separados
//
// Es 100% visual. Los mismos ~20 vehículos siguen circulando por las rutas
// entre escenarios; lo que cambia por escenario es velocidad, semáforos,
// alertas visuales y las métricas del panel lateral.
---

<section class="simulation-demo" id="demo">
  <div class="wrap">
    <div class="sim-head">
      <div class="eyebrow">CÓMO SE VE</div>
      <h2>El tráfico del puerto, en 4 escenarios.</h2>
      <p>
        Cada pocos segundos verás una situación distinta: desde el atochamiento
        actual hasta cómo cambia con la IA controlando los semáforos.
      </p>
    </div>

    <div class="sim-shell">
      <div class="sim-viewport" data-scenario="0">
        <svg
          class="sim-map"
          viewBox="0 0 800 500"
          preserveAspectRatio="xMidYMid meet"
          aria-label="Simulación del acceso al Puerto de San Antonio"
        >
          <defs>
            <linearGradient id="oceanGradient" x1="0" x2="1" y1="0" y2="0.5">
              <stop offset="0" stop-color="#022a37" />
              <stop offset="1" stop-color="#044559" />
            </linearGradient>
            <pattern id="waterLines" width="12" height="12" patternUnits="userSpaceOnUse">
              <path d="M 0 6 Q 3 4, 6 6 T 12 6" stroke="rgba(97,225,230,0.14)" stroke-width="0.8" fill="none" />
            </pattern>
          </defs>

          <!-- Océano -->
          <rect x="0" y="0" width="800" height="500" fill="url(#oceanGradient)" />
          <rect x="0" y="0" width="800" height="500" fill="url(#waterLines)" />

          <!-- Costa (tierra irregular) -->
          <path
            d="M 180 0 Q 155 90, 190 180 Q 155 250, 200 320 Q 170 410, 210 500 L 800 500 L 800 0 Z"
            fill="#FFF8EA"
          />

          <!-- Zona del puerto: terminales -->
          <g class="port-area">
            <rect x="195" y="30" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <rect x="195" y="48" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <rect x="195" y="66" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <rect x="223" y="39" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <rect x="223" y="57" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <rect x="223" y="75" width="26" height="14" fill="#044559" opacity="0.4" rx="1" />
            <text x="197" y="108" fill="#044559" font-family="Montserrat" font-size="8" font-weight="700" letter-spacing="0.5">PUERTO SAN ANTONIO</text>
          </g>

          <!-- Red vial (asfalto) -->
          <g class="roads" stroke="#151B20" fill="none">
            <!-- Corredor logístico (grueso) — carga pesada -->
            <line x1="185" y1="240" x2="800" y2="240" stroke-width="16" />
            <!-- Ruta norte -->
            <line x1="200" y1="140" x2="800" y2="140" stroke-width="9" />
            <!-- Ruta sur -->
            <line x1="210" y1="340" x2="800" y2="340" stroke-width="9" />
            <!-- Vertical arterial -->
            <line x1="520" y1="0" x2="520" y2="500" stroke-width="9" />
          </g>

          <!-- Líneas de carril -->
          <g class="lanes" stroke="#FFF8EA" fill="none" opacity="0.55">
            <line x1="185" y1="240" x2="800" y2="240" stroke-width="1.5" stroke-dasharray="12 8" />
            <line x1="200" y1="140" x2="800" y2="140" stroke-width="1" stroke-dasharray="8 6" />
            <line x1="210" y1="340" x2="800" y2="340" stroke-width="1" stroke-dasharray="8 6" />
            <line x1="520" y1="0" x2="520" y2="500" stroke-width="1" stroke-dasharray="8 6" />
          </g>

          <!-- Rotonda (donde el corredor cruza con la vertical) -->
          <circle cx="520" cy="240" r="34" fill="#FFF8EA" stroke="#151B20" stroke-width="9" />
          <circle cx="520" cy="240" r="12" fill="#61E1E6" opacity="0.4" />
          <circle cx="520" cy="240" r="6" fill="#61E1E6" opacity="0.7" />

          <!-- Semáforos (postes con housing negro + 3 lentes) en esquinas de intersecciones -->
          <g class="signal" data-signal="north" transform="translate(500, 115)">
            <rect x="-7" y="-17" width="14" height="34" rx="3" fill="#151B20" />
            <circle class="lens" data-lens="red" cx="0" cy="-10" r="3.5" />
            <circle class="lens" data-lens="yellow" cx="0" cy="0" r="3.5" />
            <circle class="lens" data-lens="green" cx="0" cy="10" r="3.5" />
          </g>
          <g class="signal" data-signal="south" transform="translate(540, 365)">
            <rect x="-7" y="-17" width="14" height="34" rx="3" fill="#151B20" />
            <circle class="lens" data-lens="red" cx="0" cy="-10" r="3.5" />
            <circle class="lens" data-lens="yellow" cx="0" cy="0" r="3.5" />
            <circle class="lens" data-lens="green" cx="0" cy="10" r="3.5" />
          </g>
          <g class="signal" data-signal="east" transform="translate(720, 210)">
            <rect x="-7" y="-17" width="14" height="34" rx="3" fill="#151B20" />
            <circle class="lens" data-lens="red" cx="0" cy="-10" r="3.5" />
            <circle class="lens" data-lens="yellow" cx="0" cy="0" r="3.5" />
            <circle class="lens" data-lens="green" cx="0" cy="10" r="3.5" />
          </g>

          <!-- Etiquetas -->
          <g class="labels" font-family="Montserrat" font-weight="600">
            <text x="30" y="45" fill="#61E1E6" opacity="0.55" font-size="10" letter-spacing="1">OCÉANO PACÍFICO</text>
            <text x="475" y="245" fill="#044559" font-size="8" text-anchor="end" opacity="0.6">Rotonda</text>
            <text x="795" y="228" fill="#044559" font-size="9" text-anchor="end" font-weight="700" letter-spacing="0.5">CORREDOR LOGÍSTICO</text>
            <text x="795" y="128" fill="#044559" font-size="8" text-anchor="end" opacity="0.65">Ruta Norte</text>
            <text x="795" y="328" fill="#044559" font-size="8" text-anchor="end" opacity="0.65">Ruta Sur</text>
            <text x="524" y="14" fill="#044559" font-size="8" opacity="0.65">Vía Central</text>
          </g>

          <!-- Alert overlay: accidente en ruta norte (solo contingencia) -->
          <g class="alert-overlay" data-alert="off">
            <circle cx="360" cy="140" r="20" fill="#ff5b5b" opacity="0.25" />
            <circle cx="360" cy="140" r="12" fill="#ff5b5b" opacity="0.45" />
            <path d="M 353 132 L 367 148 M 367 132 L 353 148" stroke="#151B20" stroke-width="2.5" stroke-linecap="round" />
            <text x="360" y="115" fill="#ff5b5b" text-anchor="middle" font-family="Montserrat" font-size="9" font-weight="700" letter-spacing="1">ACCIDENTE</text>
          </g>

          <!-- Vehículos (poblados en runtime) -->
          <g class="cars"></g>
        </svg>

        <!-- HUD flotante -->
        <div class="sim-hud">
          <div class="hud-badge" data-hud-tone="off">
            <span class="hud-dot"></span>
            <span data-hud="badge">CARGANDO</span>
          </div>
        </div>
      </div>

      <!-- Panel lateral -->
      <aside class="sim-side">
        <div class="side-counter">
          <span data-side="index">1</span>
          <small>/ 4 escenarios</small>
        </div>
        <div class="side-content">
          <h3 data-side="title">—</h3>
          <p data-side="desc">—</p>
        </div>
        <div class="side-metrics">
          <div class="metric-row">
            <span class="metric-label">Vehículos activos</span>
            <span class="metric-value" data-metric="vehicles">—</span>
          </div>
          <div class="metric-row">
            <span class="metric-label">Espera promedio</span>
            <span class="metric-value" data-metric="wait">—</span>
          </div>
          <div class="metric-row">
            <span class="metric-label">Emisiones CO₂</span>
            <span class="metric-value" data-metric="co2">—</span>
          </div>
          <div class="metric-row highlight" data-highlight="off">
            <span class="metric-label">Reducción vs sin IA</span>
            <span class="metric-value" data-metric="reduction">—</span>
          </div>
        </div>
        <div class="side-dots" role="tablist" aria-label="Elegir escenario">
          <button type="button" data-dot="0" aria-label="Escenario 1" class="dot active"></button>
          <button type="button" data-dot="1" aria-label="Escenario 2" class="dot"></button>
          <button type="button" data-dot="2" aria-label="Escenario 3" class="dot"></button>
          <button type="button" data-dot="3" aria-label="Escenario 4" class="dot"></button>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .simulation-demo {
    padding: 110px 0;
    background: var(--cream);
  }
  .sim-head {
    max-width: 640px;
    margin-bottom: 48px;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 600;
    color: var(--navy);
    opacity: 0.55;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 38px;
    margin-top: 14px;
    line-height: 1.2;
    color: var(--navy);
  }
  .sim-head p {
    margin-top: 16px;
    font-size: 15px;
    color: rgba(21, 27, 32, 0.7);
    max-width: 520px;
  }

  .sim-shell {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 24px;
    align-items: stretch;
  }
  .sim-viewport {
    position: relative;
    background: var(--navy);
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 8 / 5;
  }
  .sim-map {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ---------- Semáforos ---------- */
  .signal .lens {
    fill: rgba(255, 248, 234, 0.12);
    transition: fill 300ms ease, filter 300ms ease;
  }
  .signal[data-state="red"] .lens[data-lens="red"] {
    fill: #ff5b5b;
    filter: drop-shadow(0 0 6px #ff5b5b);
  }
  .signal[data-state="yellow"] .lens[data-lens="yellow"] {
    fill: #ffc93c;
    filter: drop-shadow(0 0 6px #ffc93c);
  }
  .signal[data-state="green"] .lens[data-lens="green"] {
    fill: var(--lime);
    filter: drop-shadow(0 0 6px var(--lime));
  }

  /* ---------- Vehículos ---------- */
  .cars :global(rect.car) {
    fill: var(--cyan);
    stroke: rgba(0, 0, 0, 0.35);
    stroke-width: 0.5;
    transition: opacity 400ms ease;
  }
  .cars :global(rect.truck) {
    fill: var(--lime);
    stroke: rgba(0, 0, 0, 0.35);
    stroke-width: 0.5;
    transition: opacity 400ms ease;
  }

  /* ---------- Alert overlay ---------- */
  .alert-overlay {
    opacity: 0;
    transition: opacity 400ms ease;
    pointer-events: none;
  }
  .alert-overlay[data-alert="on"] {
    opacity: 1;
    animation: alert-blink 1.4s ease-in-out infinite;
  }
  @keyframes alert-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.55; }
  }

  /* ---------- HUD ---------- */
  .sim-hud {
    position: absolute;
    top: 16px;
    left: 16px;
    pointer-events: none;
  }
  .hud-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    background: rgba(21, 27, 32, 0.78);
    backdrop-filter: blur(8px);
    border-radius: 100px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--cyan);
    border: 1px solid rgba(97, 225, 230, 0.28);
    transition: color 250ms, border-color 250ms;
  }
  .hud-badge[data-hud-tone="bad"] {
    color: #ff5b5b;
    border-color: rgba(255, 91, 91, 0.4);
  }
  .hud-badge[data-hud-tone="good"] {
    color: var(--lime);
    border-color: rgba(209, 235, 120, 0.5);
  }
  .hud-badge[data-hud-tone="warn"] {
    color: #ffc93c;
    border-color: rgba(255, 201, 60, 0.4);
  }
  .hud-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
    animation: hud-pulse 1.2s ease-in-out infinite;
  }
  @keyframes hud-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }

  /* ---------- Panel lateral ---------- */
  .sim-side {
    background: var(--navy);
    border-radius: 20px;
    padding: 26px;
    color: var(--cream);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .side-counter {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-serif);
    color: var(--cyan);
  }
  .side-counter span {
    font-size: 44px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .side-counter small {
    font-family: var(--font-sans);
    font-size: 12px;
    color: rgba(255, 248, 234, 0.55);
    font-weight: 500;
  }
  .side-content h3 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.25;
    color: var(--cream);
    margin-bottom: 6px;
    min-height: 55px;
  }
  .side-content p {
    font-size: 13px;
    color: rgba(255, 248, 234, 0.7);
    line-height: 1.45;
  }
  .side-metrics {
    display: flex;
    flex-direction: column;
  }
  .metric-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px solid rgba(255, 248, 234, 0.1);
  }
  .metric-row:first-child {
    border-top: 1px solid rgba(255, 248, 234, 0.1);
  }
  .metric-label {
    font-size: 12px;
    color: rgba(255, 248, 234, 0.6);
    letter-spacing: 0.3px;
  }
  .metric-value {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
    color: var(--cream);
    font-variant-numeric: tabular-nums;
    transition: color 300ms;
  }
  .metric-row.highlight .metric-value {
    color: var(--lime);
    font-size: 22px;
  }
  .metric-row.highlight[data-highlight="off"] .metric-value {
    color: rgba(255, 248, 234, 0.3);
  }
  .side-dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: auto;
    padding-top: 8px;
  }
  .dot {
    width: 30px;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 248, 234, 0.2);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 250ms, transform 200ms;
  }
  .dot:hover {
    background: rgba(255, 248, 234, 0.4);
  }
  .dot.active {
    background: var(--lime);
    transform: scaleX(1.15);
  }

  @media (max-width: 860px) {
    .sim-shell { grid-template-columns: 1fr; }
    .sim-viewport { aspect-ratio: 4 / 3; }
    h2 { font-size: 30px; }
  }
</style>

<script>
  type Point = { x: number; y: number };
  type LightState = 'red' | 'yellow' | 'green';
  type VehicleKind = 'car' | 'truck';

  const SVG_NS = 'http://www.w3.org/2000/svg';

  // Rutas que siguen las carreteras del mapa.
  // Cars entran off-screen y salen off-screen para look natural.
  const ROUTES: Record<string, Point[]> = {
    corredorWE: [{ x: -30, y: 240 }, { x: 830, y: 240 }],
    corredorEW: [{ x: 830, y: 240 }, { x: -30, y: 240 }],
    norteWE: [{ x: -30, y: 140 }, { x: 830, y: 140 }],
    norteEW: [{ x: 830, y: 140 }, { x: -30, y: 140 }],
    surWE: [{ x: -30, y: 340 }, { x: 830, y: 340 }],
    surEW: [{ x: 830, y: 340 }, { x: -30, y: 340 }],
    verticalNS: [{ x: 520, y: -30 }, { x: 520, y: 530 }],
    verticalSN: [{ x: 520, y: 530 }, { x: 520, y: -30 }],
  };

  interface Vehicle {
    kind: VehicleKind;
    routeId: string;
    offset: number; // 0..1 posición inicial en la ruta
    baseSpeed: number; // px per ms base
  }

  interface Scenario {
    id: string;
    title: string;
    desc: string;
    hud: string;
    hudTone: 'bad' | 'good' | 'warn' | 'off';
    signals: { north: LightState; south: LightState; east: LightState };
    alert: boolean;
    speedMul: number;
    vehicles: Vehicle[];
    metrics: {
      vehicles: string;
      wait: string;
      co2: string;
      reduction: string;
    };
    highlight: 'on' | 'off';
  }

  // Vehicle pools reutilizables entre escenarios
  const jamPool: Vehicle[] = [
    { kind: 'truck', routeId: 'corredorWE', offset: 0.05, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.14, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.22, baseSpeed: 0.02 },
    { kind: 'car', routeId: 'corredorWE', offset: 0.32, baseSpeed: 0.025 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.42, baseSpeed: 0.02 },
    { kind: 'car', routeId: 'corredorWE', offset: 0.55, baseSpeed: 0.025 },
    { kind: 'car', routeId: 'corredorEW', offset: 0.15, baseSpeed: 0.025 },
    { kind: 'car', routeId: 'corredorEW', offset: 0.55, baseSpeed: 0.025 },
    { kind: 'car', routeId: 'norteWE', offset: 0.1, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'norteWE', offset: 0.3, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'norteWE', offset: 0.55, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'norteEW', offset: 0.7, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'surWE', offset: 0.2, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'surEW', offset: 0.4, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'verticalNS', offset: 0.15, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'verticalNS', offset: 0.45, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'verticalNS', offset: 0.75, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'verticalSN', offset: 0.35, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'verticalSN', offset: 0.65, baseSpeed: 0.028 },
  ];

  // Escenario 3 (contingencia): sin cars en ruta norte (bloqueada por accidente),
  // más cars redirigidos por corredor y sur
  const contingencyPool: Vehicle[] = [
    { kind: 'truck', routeId: 'corredorWE', offset: 0.1, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.3, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.5, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.7, baseSpeed: 0.02 },
    { kind: 'car', routeId: 'corredorWE', offset: 0.85, baseSpeed: 0.025 },
    { kind: 'car', routeId: 'corredorEW', offset: 0.2, baseSpeed: 0.025 },
    { kind: 'car', routeId: 'corredorEW', offset: 0.6, baseSpeed: 0.025 },
    { kind: 'car', routeId: 'surWE', offset: 0.05, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'surWE', offset: 0.3, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'surWE', offset: 0.55, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'surWE', offset: 0.8, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'surEW', offset: 0.15, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'surEW', offset: 0.45, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'verticalNS', offset: 0.2, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'verticalNS', offset: 0.6, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'verticalSN', offset: 0.4, baseSpeed: 0.028 },
  ];

  // Escenario 4 (bimodal): más camiones en corredor, autos en rutas secundarias
  const bimodalPool: Vehicle[] = [
    { kind: 'truck', routeId: 'corredorWE', offset: 0.05, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.2, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.35, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.5, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.65, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorWE', offset: 0.8, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorEW', offset: 0.3, baseSpeed: 0.02 },
    { kind: 'truck', routeId: 'corredorEW', offset: 0.7, baseSpeed: 0.02 },
    { kind: 'car', routeId: 'norteWE', offset: 0.15, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'norteWE', offset: 0.4, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'norteWE', offset: 0.65, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'norteEW', offset: 0.25, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'norteEW', offset: 0.6, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'surWE', offset: 0.2, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'surWE', offset: 0.55, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'surEW', offset: 0.35, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'verticalNS', offset: 0.25, baseSpeed: 0.028 },
    { kind: 'car', routeId: 'verticalSN', offset: 0.6, baseSpeed: 0.028 },
  ];

  const SCENARIOS: Scenario[] = [
    {
      id: 'jam',
      title: 'Congestión sin IA',
      desc: 'Ciclos fijos de semaforización. El corredor logístico se atocha y los camiones esperan minutos por cada fase.',
      hud: 'CONGESTIÓN',
      hudTone: 'bad',
      signals: { north: 'red', south: 'red', east: 'red' },
      alert: false,
      speedMul: 0.3,
      vehicles: jamPool,
      metrics: {
        vehicles: '19',
        wait: '9.2 s',
        co2: '87 kg/h',
        reduction: '—',
      },
      highlight: 'off',
    },
    {
      id: 'ai-flow',
      title: 'Optimización con IA',
      desc: 'La red neuronal coordina las tres intersecciones en tiempo real. Los ciclos se adaptan a la demanda observada.',
      hud: 'FLUJO OPTIMIZADO',
      hudTone: 'good',
      signals: { north: 'green', south: 'green', east: 'green' },
      alert: false,
      speedMul: 1.4,
      vehicles: jamPool,
      metrics: {
        vehicles: '19',
        wait: '2.6 s',
        co2: '49 kg/h',
        reduction: '−44 %',
      },
      highlight: 'on',
    },
    {
      id: 'contingency',
      title: 'Contingencia manejada',
      desc: 'Un accidente bloquea la Ruta Norte. La IA redirige tráfico por el corredor y la ruta sur en segundos.',
      hud: 'REDIRECCIONANDO',
      hudTone: 'warn',
      signals: { north: 'red', south: 'green', east: 'green' },
      alert: true,
      speedMul: 1.1,
      vehicles: contingencyPool,
      metrics: {
        vehicles: '16',
        wait: '4.1 s',
        co2: '58 kg/h',
        reduction: '−32 %',
      },
      highlight: 'on',
    },
    {
      id: 'bimodal',
      title: 'Bimodal: carga + livianos',
      desc: 'La IA prioriza el corredor logístico para camiones mientras los autos siguen fluidos por rutas secundarias.',
      hud: 'PRIORIDAD BIMODAL',
      hudTone: 'good',
      signals: { north: 'green', south: 'green', east: 'green' },
      alert: false,
      speedMul: 1.25,
      vehicles: bimodalPool,
      metrics: {
        vehicles: '18',
        wait: '3.0 s',
        co2: '52 kg/h',
        reduction: '−38 %',
      },
      highlight: 'on',
    },
  ];

  const SCENARIO_DURATION = 8000; // ms

  // ---------- Setup DOM refs ----------
  const viewport = document.querySelector<HTMLElement>('.sim-viewport');
  const svg = viewport?.querySelector<SVGSVGElement>('.sim-map');
  const carsGroup = svg?.querySelector<SVGGElement>('.cars');
  const alertOverlay = svg?.querySelector<SVGGElement>('.alert-overlay');
  const signalNorth = svg?.querySelector<SVGGElement>('[data-signal="north"]');
  const signalSouth = svg?.querySelector<SVGGElement>('[data-signal="south"]');
  const signalEast = svg?.querySelector<SVGGElement>('[data-signal="east"]');
  const hudBadge = document.querySelector<HTMLElement>('.hud-badge');
  const hudBadgeText = document.querySelector<HTMLElement>('[data-hud="badge"]');
  const sideIndex = document.querySelector<HTMLElement>('[data-side="index"]');
  const sideTitle = document.querySelector<HTMLElement>('[data-side="title"]');
  const sideDesc = document.querySelector<HTMLElement>('[data-side="desc"]');
  const metricEls = {
    vehicles: document.querySelector<HTMLElement>('[data-metric="vehicles"]'),
    wait: document.querySelector<HTMLElement>('[data-metric="wait"]'),
    co2: document.querySelector<HTMLElement>('[data-metric="co2"]'),
    reduction: document.querySelector<HTMLElement>('[data-metric="reduction"]'),
  };
  const highlightRow = document.querySelector<HTMLElement>('[data-highlight]');
  const dots = document.querySelectorAll<HTMLButtonElement>('.dot');

  // ---------- Vehicle animation state ----------
  interface VehicleRuntime extends Vehicle {
    el: SVGRectElement;
    progress: number;
  }
  let runtimeCars: VehicleRuntime[] = [];
  let currentScenario = 0;
  let advanceTimer = 0;
  let animationFrame = 0;
  let lastTs = 0;
  let currentSpeedMul = 1;

  const routeLength = (route: Point[]) => {
    let total = 0;
    for (let i = 1; i < route.length; i++) {
      total += Math.hypot(route[i].x - route[i - 1].x, route[i].y - route[i - 1].y);
    }
    return total;
  };

  const routePoint = (route: Point[], progress: number) => {
    const total = routeLength(route);
    const target = progress * total;
    let acc = 0;
    for (let i = 1; i < route.length; i++) {
      const dx = route[i].x - route[i - 1].x;
      const dy = route[i].y - route[i - 1].y;
      const seg = Math.hypot(dx, dy);
      if (acc + seg >= target) {
        const t = (target - acc) / seg;
        return {
          p: { x: route[i - 1].x + dx * t, y: route[i - 1].y + dy * t },
          angle: (Math.atan2(dy, dx) * 180) / Math.PI,
        };
      }
      acc += seg;
    }
    return { p: route[route.length - 1], angle: 0 };
  };

  const buildCars = (vehicles: Vehicle[]) => {
    if (!carsGroup) return;
    carsGroup.innerHTML = '';
    runtimeCars = vehicles.map((v) => {
      const el = document.createElementNS(SVG_NS, 'rect');
      el.setAttribute('class', v.kind);
      el.setAttribute('width', v.kind === 'truck' ? '22' : '11');
      el.setAttribute('height', v.kind === 'truck' ? '8' : '6');
      el.setAttribute('rx', '1');
      carsGroup.appendChild(el);
      return { ...v, el, progress: v.offset };
    });
  };

  const tick = (dt: number) => {
    runtimeCars.forEach((car) => {
      car.progress += car.baseSpeed * currentSpeedMul * (dt / 100);
      if (car.progress > 1) car.progress -= 1;
      const route = ROUTES[car.routeId];
      if (!route) return;
      const { p, angle } = routePoint(route, car.progress);
      const w = car.kind === 'truck' ? 22 : 11;
      const h = car.kind === 'truck' ? 8 : 6;
      car.el.setAttribute('x', String(p.x - w / 2));
      car.el.setAttribute('y', String(p.y - h / 2));
      car.el.setAttribute('transform', `rotate(${angle} ${p.x} ${p.y})`);
    });
  };

  const loop = (ts: number) => {
    const dt = lastTs ? ts - lastTs : 16;
    lastTs = ts;
    tick(dt);
    animationFrame = requestAnimationFrame(loop);
  };

  // ---------- Scenario application ----------
  const applyScenario = (index: number, rebuildVehicles = true) => {
    const sc = SCENARIOS[index];
    if (!sc) return;
    currentScenario = index;
    currentSpeedMul = sc.speedMul;
    viewport?.setAttribute('data-scenario', String(index));

    // Signals
    signalNorth?.setAttribute('data-state', sc.signals.north);
    signalSouth?.setAttribute('data-state', sc.signals.south);
    signalEast?.setAttribute('data-state', sc.signals.east);

    // Alert overlay
    alertOverlay?.setAttribute('data-alert', sc.alert ? 'on' : 'off');

    // HUD
    if (hudBadgeText) hudBadgeText.textContent = sc.hud;
    hudBadge?.setAttribute('data-hud-tone', sc.hudTone);

    // Side panel
    if (sideIndex) sideIndex.textContent = String(index + 1);
    if (sideTitle) sideTitle.textContent = sc.title;
    if (sideDesc) sideDesc.textContent = sc.desc;

    // Metrics
    if (metricEls.vehicles) metricEls.vehicles.textContent = sc.metrics.vehicles;
    if (metricEls.wait) metricEls.wait.textContent = sc.metrics.wait;
    if (metricEls.co2) metricEls.co2.textContent = sc.metrics.co2;
    if (metricEls.reduction) metricEls.reduction.textContent = sc.metrics.reduction;
    highlightRow?.setAttribute('data-highlight', sc.highlight);

    // Dots
    dots.forEach((d, i) => d.classList.toggle('active', i === index));

    // Rebuild cars if pool changed
    if (rebuildVehicles) buildCars(sc.vehicles);
  };

  const advance = () => {
    applyScenario((currentScenario + 1) % SCENARIOS.length);
  };

  const startAutoAdvance = () => {
    window.clearInterval(advanceTimer);
    advanceTimer = window.setInterval(advance, SCENARIO_DURATION);
  };

  const jumpTo = (index: number) => {
    applyScenario(index);
    startAutoAdvance();
  };

  // ---------- Init ----------
  if (viewport && svg && carsGroup) {
    applyScenario(0);
    lastTs = 0;
    animationFrame = requestAnimationFrame(loop);
    startAutoAdvance();

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.dataset.dot);
        if (!Number.isNaN(idx)) jumpTo(idx);
      });
    });

    // Pausar cuando la pestaña no está visible (ahorra CPU)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        window.clearInterval(advanceTimer);
        cancelAnimationFrame(animationFrame);
      } else {
        lastTs = 0;
        animationFrame = requestAnimationFrame(loop);
        startAutoAdvance();
      }
    });
  }
</script>
