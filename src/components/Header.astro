---
// Header notch alargado — 3 pills flotantes (brand · nav · cta) sobre
// el borde superior del Hero (que ahora tiene esquinas redondeadas).
// Position fixed en el top del viewport. pointer-events: none en el
// contenedor deja pasar clicks a la brújula del Hero por debajo.
---

<header class="pf-header">
  <div class="pf-inner">

    <a href="#top" class="pf-pill pf-brand" aria-label="Troppo — inicio">
      <img class="pf-brand-logo" src="/images/logo/logo_troppo_azul.png" alt="Troppo" />
    </a>

    <nav class="pf-pill pf-nav" aria-label="Navegación principal">
      <a href="#empresa">Nosotros</a>
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#equipo">Equipo</a>
    </nav>

    <a href="#contacto" class="pf-pill pf-cta">
      <span class="pf-cta-label">Contacto</span>
      <svg class="pf-cta-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 8 L13 8" />
        <path d="M9 4 L13 8 L9 12" />
      </svg>
    </a>

  </div>
</header>

<style>
  /* ---------- CONTENEDOR ---------- */
  header.pf-header {
    position: fixed;
    top: 20px;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0 24px;
    pointer-events: none;
  }
  header.pf-header .pf-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* ---------- PILL BASE ---------- */
  header.pf-header .pf-pill {
    pointer-events: auto;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 248, 234, 0.92);
    border: 1px solid rgba(255, 248, 234, 0.55);
    border-radius: 100px;
    color: #044559;
    text-decoration: none;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow:
      0 10px 28px rgba(4, 69, 89, 0.18),
      0 2px 6px rgba(4, 69, 89, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.55);
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 260ms ease;
    white-space: nowrap;
    line-height: 1;
  }
  header.pf-header .pf-pill:hover {
    transform: translateY(-2px);
    box-shadow:
      0 16px 34px rgba(4, 69, 89, 0.22),
      0 3px 8px rgba(4, 69, 89, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.55);
  }

  /* ---------- BRAND PILL ----------
     El PNG ya viene recortado a su bbox (aspect ~4.92), o sea que
     height controla la altura y width se ajusta solo — el pill queda
     ceñido al logo sin espacio muerto. */
  header.pf-header .pf-brand {
    padding: 8px 18px;
  }
  header.pf-header .pf-brand-logo {
    display: block;
    height: 26px;
    width: auto;
    object-fit: contain;
  }

  /* ---------- NAV PILL (NOTCH con concave curves) ----------
     El pill del centro cuelga desde el techo con esquinas superiores
     rectas y sólo las inferiores redondeadas. Además, los pseudo-elementos
     ::before y ::after (fuera del pill, a los costados) dibujan cuartos
     de círculo cream que crean las curvas cóncavas suaves hacia el techo.
     Truco clásico con radial-gradient (ver ideas/cosas_random/navbar_ex.html). */
  header.pf-header .pf-nav {
    position: relative;
    align-self: flex-start;
    margin-top: -20px;
    padding: 32px 28px 14px;
    gap: 24px;
    border-radius: 0 0 28px 28px;
    border-top: none;
    /* Sombra solo bajo el notch — sin sombras laterales que interfieran
       con los pseudo-elementos de curva cóncava */
    box-shadow:
      0 12px 28px rgba(4, 69, 89, 0.2),
      inset 0 -1px 0 rgba(255, 255, 255, 0.55);
    /* backdrop-filter se hereda del .pf-pill base */
  }
  /* Curva cóncava IZQUIERDA — extiende visualmente el notch con un
     cuarto de círculo que fluye hacia el techo. */
  header.pf-header .pf-nav::before {
    content: '';
    position: absolute;
    top: 0;
    left: -28px;
    width: 28px;
    height: 28px;
    background: radial-gradient(
      circle at 0 100%,
      transparent 28px,
      rgba(255, 248, 234, 0.94) 28px
    );
    pointer-events: none;
  }
  /* Curva cóncava DERECHA — espejo de la izquierda */
  header.pf-header .pf-nav::after {
    content: '';
    position: absolute;
    top: 0;
    right: -28px;
    width: 28px;
    height: 28px;
    background: radial-gradient(
      circle at 100% 100%,
      transparent 28px,
      rgba(255, 248, 234, 0.94) 28px
    );
    pointer-events: none;
  }
  /* El hover del pill base (translateY -2px) no aplica al notch —
     el notch está anclado al techo, no debe "levantarse". */
  header.pf-header .pf-nav:hover {
    transform: none;
    box-shadow:
      0 16px 34px rgba(4, 69, 89, 0.24),
      inset 0 -1px 0 rgba(255, 255, 255, 0.55);
  }
  header.pf-header .pf-nav a {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: #044559;
    opacity: 0.72;
    text-decoration: none;
    line-height: 1;
    transition: opacity 200ms ease;
  }
  header.pf-header .pf-nav a:hover {
    opacity: 1;
  }

  /* ---------- CTA PILL ---------- */
  header.pf-header .pf-cta {
    background-color: #D1EB78;
    border-color: rgba(4, 69, 89, 0.1);
    color: #033544;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 14px;
    padding: 13px 20px;
    gap: 8px;
  }
  header.pf-header .pf-cta:hover {
    box-shadow:
      0 14px 30px rgba(209, 235, 120, 0.45),
      0 3px 8px rgba(4, 69, 89, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  header.pf-header .pf-cta-label {
    display: inline-block;
    line-height: 1;
  }
  header.pf-header .pf-cta-icon {
    display: inline-block;
    transition: transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  header.pf-header .pf-cta:hover .pf-cta-icon {
    transform: translateX(3px);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 860px) {
    header.pf-header { top: 12px; padding: 0 16px; }
    header.pf-header .pf-inner { gap: 8px; }
    header.pf-header .pf-nav { display: none; }
    header.pf-header .pf-brand { padding: 6px 14px; }
    header.pf-header .pf-brand-logo { height: 20px; }
    header.pf-header .pf-cta { padding: 10px 16px; font-size: 13px; }
    header.pf-header .pf-cta-icon { width: 12px; height: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    header.pf-header .pf-pill,
    header.pf-header .pf-cta-icon {
      transition: none;
    }
    header.pf-header .pf-pill:hover {
      transform: none;
    }
  }
</style>
