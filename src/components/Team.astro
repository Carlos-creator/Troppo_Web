---
// Sección de equipo — parte de "Zona empresa" (rúbrica sección 8).
// Cada miembro con foto de perfil, nombre, rol, email y LinkedIn.
// Fotos self-hosted en /public/images/team/*.png

const members = [
  {
    name: 'Cristóbal Césped',
    role: 'Product Owner',
    email: 'cristobal.cespedg@usm.cl',
    linkedin: 'https://www.linkedin.com/in/cristobal-cesped/',
    photo: '/images/team/Cristobal.png',
  },
  {
    name: 'Carlos Ramírez',
    role: 'UI/UX Lead',
    email: 'carlos.ramirezval@usm.cl',
    linkedin: 'https://www.linkedin.com/in/carlos-ram%C3%ADrez-b51a5339b/',
    photo: '/images/team/Carlos.png',
  },
  {
    name: 'Cristian Tapia',
    role: 'Marketing',
    email: 'cristian.tapial@usm.cl',
    linkedin: 'https://www.linkedin.com/in/cristi%C3%A1n-alexis-tapia-llant%C3%A9n-71a091257/',
    photo: '/images/team/Cristian.png',
  },
  {
    name: 'Andrés Araya D.',
    role: 'Scrum Master',
    email: 'andres.arayad@usm.cl',
    linkedin: 'https://www.linkedin.com/in/andresarayadiaz/',
    photo: '/images/team/Andres.png',
  },
  {
    name: 'Leonardo Chacón G.',
    role: 'Tester + Brand Identity Lead',
    email: 'leonardo.chacon@usm.cl',
    linkedin: 'https://www.linkedin.com/in/leonardo-chac%C3%B3n-geminiani-513b813b8/',
    photo: '/images/team/Leonardo.png',
  },
  {
    name: 'Baltazar Portilla R.',
    role: 'Lead Developer',
    email: 'baltazar.portilla@usm.cl',
    linkedin: 'https://www.linkedin.com/in/baltazar-portilla-reyes/',
    photo: '/images/team/Baltazar.png',
  },
