---

<section class="team" id="equipo">
  <div class="wrap">
    <header class="team-head">
      <div class="team-eyebrow">¿QUIÉNES SOMOS?</div>
      <h2>El equipo detrás del gemelo digital.</h2>
    </header>
    <div class="team-grid">
      {
        members.map((m) => (
          <article class="member" data-reveal>
            <div class="avatar">
              <img src={m.photo} alt={`Foto de ${m.name}`} loading="lazy" width="72" height="72" />
            </div>
            <h4>{m.name}</h4>
            <div class="role">{m.role}</div>
            <div class="member-links">
              <a class="member-link email" href={`mailto:${m.email}`} aria-label={`Enviar email a ${m.name}`}>
                <svg class="email-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2.5" y="4.5" width="15" height="11" rx="2" />
                  <path d="M2.5 6 L10 11 L17.5 6" />
                </svg>
                <span>{m.email}</span>
              </a>
              <a
                class="member-link linkedin"
                href={m.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`LinkedIn de ${m.name}`}
              >
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2.5" y="2.5" width="15" height="15" rx="2" />
                  <path d="M6.4 8.4 L6.4 14" />
                  <circle cx="6.4" cy="6" r="0.9" fill="currentColor" stroke="none" />
                  <path d="M9.4 14 L9.4 8.4 M9.4 11 C 9.4 9.5 10.5 8.4 11.9 8.4 C 13.3 8.4 13.9 9.5 13.9 11 L13.9 14" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team {
    padding: 100px 0 120px;
    background: rgba(3, 53, 68, 0.84);
    color: var(--cream);
    position: relative;
    overflow: hidden;
  }
  .wrap { position: relative; z-index: 1; }

  .team-head {
    max-width: 640px;
    margin: 0 auto 52px;
    text-align: center;
  }
  .team-eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2.5px;
    color: var(--cyan);
    opacity: 0.9;
    margin-bottom: 14px;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 34px;
    line-height: 1.2;
    color: var(--cream);
    margin: 0;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    max-width: 1180px;
    margin: 0 auto;
  }
  .member {
    background: rgba(255, 248, 234, 0.045);
    border: 1px solid rgba(255, 248, 234, 0.14);
    border-radius: 16px;
    padding: 26px 24px;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      background 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease;
  }
  .member:hover {
    transform: translateY(-4px);
    background: rgba(97, 225, 230, 0.055);
    border-color: rgba(97, 225, 230, 0.4);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.25);
  }
  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--cyan);
    overflow: hidden;
    margin-bottom: 18px;
    position: relative;
    box-shadow: 0 0 0 2px rgba(97, 225, 230, 0.35);
    transition: box-shadow 300ms ease, transform 300ms ease;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .member:hover .avatar {
    box-shadow: 0 0 0 3px var(--cyan);
    transform: scale(1.04);
  }
  .member h4 {
    font-family: var(--font-title);
    font-size: 16px;
    font-weight: 700;
    color: var(--cream);
    margin: 0;
    letter-spacing: 0.2px;
  }
  .member .role {
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--cyan);
    margin-top: 4px;
    font-weight: 600;
    letter-spacing: 0.2px;
  }
  .member-links {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    flex-wrap: wrap;
    align-items: center;
  }
  .member-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    background: rgba(255, 248, 234, 0.06);
    border: 1px solid rgba(255, 248, 234, 0.14);
    border-radius: 100px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: rgba(255, 248, 234, 0.75);
    text-decoration: none;
    transition:
      background 260ms ease,
      border-color 260ms ease,
      color 260ms ease,
      transform 260ms ease;
  }
  .member-link:hover {
    background: rgba(97, 225, 230, 0.12);
    border-color: rgba(97, 225, 230, 0.42);
    color: var(--cream);
    transform: translateY(-1px);
  }
  .member-link svg {
    width: 14px;
    height: 14px;
    color: var(--cyan);
    flex-shrink: 0;
  }
  /* El chip de LinkedIn es sólo el icono — más chico, cuadrado-ish */
  .member-link.linkedin {
    padding: 7px 10px;
  }
  .email-icon {
    /* Selector legado, mantenido para el mail */
    width: 14px;
    height: 14px;
    color: var(--cyan);
    flex-shrink: 0;
  }

  /* Reveal */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease, transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .team-grid { grid-template-columns: 1fr; max-width: 480px; }
    h2 { font-size: 26px; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .member, .email { transition: none; }
  }
</style>

<script>
  // Se re-anima cada vez que los items vuelven al viewport
  const items = document.querySelectorAll<HTMLElement>('.team [data-reveal]');
  if (items.length) {
    const timers = new WeakMap<Element, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e, i) => {
          const prev = timers.get(e.target);
          if (prev) window.clearTimeout(prev);
          if (e.isIntersecting) {
            const t = window.setTimeout(() => {
              e.target.classList.add('revealed');
              timers.delete(e.target);
            }, i * 80);
            timers.set(e.target, t);
          } else {
            e.target.classList.remove('revealed');
          }
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );
    items.forEach((el) => observer.observe(el));
  }
</script>
