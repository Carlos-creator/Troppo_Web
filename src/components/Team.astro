---
// Tarjetas del equipo — se usan dentro de la "Zona empresa" (Empresa.astro),
// que aporta el fondo y los títulos. Cada miembro con foto de perfil,
// nombre, rol, email y LinkedIn.
// Fotos self-hosted en /public/images/team/ (PNG o JPG cuadradas, 400×400).
//
// El mismo componente renderiza los dos bloques con idéntico formato:
//   <Team />                      → equipo (id="equipo")
//   <Team grupo="colaboradores" /> → colaboradores (id="colaboradores")
// Si la foto de una persona aún no existe en /public, la tarjeta muestra
// sus iniciales en el mismo círculo; al agregar el archivo y recompilar,
// la foto aparece sin tocar el código.
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  grupo?: 'equipo' | 'colaboradores';
}
const { grupo = 'equipo' } = Astro.props;

const equipo = [
  {
    name: 'Cristóbal Césped G.',
    role: 'Product Owner',
    email: 'cristobal.cespedg@usm.cl',
    linkedin: 'https://www.linkedin.com/in/cristobal-cesped/',
    photo: '/images/team/Cristobal.png',
  },
  {
    name: 'Carlos Ramírez V.',
    role: 'UI/UX Lead',
    email: 'carlos.ramirezval@usm.cl',
    linkedin: 'https://www.linkedin.com/in/carlos-ram%C3%ADrez-b51a5339b/',
    photo: '/images/team/Carlos.png',
  },
  {
    name: 'Cristian Tapia L.',
    role: 'Marketing',
    email: 'cristian.tapial@usm.cl',
    linkedin: 'https://www.linkedin.com/in/cristi%C3%A1n-alexis-tapia-llant%C3%A9n-71a091257/',
    photo: '/images/team/Cristian.png',
  },
  {
    name: 'Andrés Araya D.',
    role: 'Scrum Master',
    email: 'andres.arayad@usm.cl',
    linkedin: 'https://www.linkedin.com/in/andresarayadiaz/',
    photo: '/images/team/Andres.png',
  },
  {
    name: 'Leonardo Chacón G.',
    role: 'Tester',
    email: 'leonardo.chacon@usm.cl',
    linkedin: 'https://www.linkedin.com/in/leonardo-chac%C3%B3n-geminiani-513b813b8/',
    photo: '/images/team/Leonardo.png',
  },
  {
    name: 'Baltazar Portilla R.',
    role: 'Tech Lead',
    email: 'baltazar.portilla@usm.cl',
    linkedin: 'https://www.linkedin.com/in/baltazar-portilla-reyes/',
    photo: '/images/team/Baltazar.png',
  },
];

const colaboradores = [
  {
    name: 'Kamila Narváez P.',
    role: 'Visual Communicator',
    email: 'kamila.narvaez.p@gmail.com',
    linkedin: 'https://www.linkedin.com/in/kamila-narv%C3%A1ez-p%C3%A1ez/',
    photo: '/images/team/Kamila.jpg',
  },
  {
    name: 'Franco Guerrero L.',
    role: 'Growth Partner',
    email: 'franco.guerrerol@sansano.usm.cl',
    linkedin: 'https://www.linkedin.com/in/francoguerrero-/',
    photo: '/images/team/Franco.jpg',
  },
];

const esColab = grupo === 'colaboradores';
const members = (esColab ? colaboradores : equipo).map((m) => ({
  ...m,
  hasPhoto: existsSync(join(process.cwd(), 'public', m.photo)),
  // Iniciales de nombre + primer apellido (p. ej. "Kamila Narváez P." → "KN")
  initials: m.name.split(' ').slice(0, 2).map((w) => w[0]).join(''),
}));
---

<div class:list={['team', { 'team--colab': esColab }]} id={esColab ? 'colaboradores' : 'equipo'}>
  <div class="team-grid">
    {
      members.map((m) => (
        <article class="member" data-reveal>
          <div class="avatar">
            {m.hasPhoto ? (
              <img src={m.photo} alt={`Foto de ${m.name}`} loading="lazy" width="72" height="72" />
            ) : (
              <span class="avatar-initials" aria-hidden="true">{m.initials}</span>
            )}
          </div>
          <h4>{m.name}</h4>
          <div class="role">{m.role}</div>
          <div class="member-links">
            <a class="member-link email" href={`mailto:${m.email}`} aria-label={`Enviar email a ${m.name}`}>
              <svg class="email-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2.5" y="4.5" width="15" height="11" rx="2" />
                <path d="M2.5 6 L10 11 L17.5 6" />
              </svg>
              <span>{m.email}</span>
            </a>
            <a
              class="member-link linkedin"
              href={m.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`LinkedIn de ${m.name}`}
            >
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2.5" y="2.5" width="15" height="15" rx="2" />
                <path d="M6.4 8.4 L6.4 14" />
                <circle cx="6.4" cy="6" r="0.9" fill="currentColor" stroke="none" />
                <path d="M9.4 14 L9.4 8.4 M9.4 11 C 9.4 9.5 10.5 8.4 11.9 8.4 C 13.3 8.4 13.9 9.5 13.9 11 L13.9 14" />
              </svg>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</div>

<style>
  /* Bloque sin fondo ni padding propios: los aporta .empresa */
  .team {
    position: relative;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    max-width: 1180px;
    margin: 0 auto;
  }
  /* Colaboradores: las tarjetas mantienen el ancho de una columna del
     equipo y quedan centradas. */
  .team--colab .team-grid {
    grid-template-columns: repeat(2, calc((100% - 44px) / 3));
    justify-content: center;
  }
  .member {
    background: rgba(255, 248, 234, 0.045);
    border: 1px solid rgba(255, 248, 234, 0.14);
    border-radius: 16px;
    padding: 26px 24px;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      background 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease;
  }
  .member:hover {
    transform: translateY(-4px);
    background: rgba(97, 225, 230, 0.055);
    border-color: rgba(97, 225, 230, 0.4);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.25);
  }
  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--cyan);
    overflow: hidden;
    margin-bottom: 18px;
    position: relative;
    box-shadow: 0 0 0 2px rgba(97, 225, 230, 0.35);
    transition: box-shadow 300ms ease, transform 300ms ease;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Respaldo mientras falta la foto: iniciales sobre el círculo cyan */
  .avatar-initials {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 24px;
    color: var(--navy-deep);
  }
  .member:hover .avatar {
    box-shadow: 0 0 0 3px var(--cyan);
    transform: scale(1.04);
  }
  .member h4 {
    font-family: var(--font-title);
    font-size: 16px;
    font-weight: 700;
    color: var(--cream);
    margin: 0;
    letter-spacing: 0.2px;
  }
  .member .role {
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--cyan);
    margin-top: 4px;
    font-weight: 600;
    letter-spacing: 0.2px;
  }
  .member-links {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    flex-wrap: wrap;
    align-items: center;
  }
  .member-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    background: rgba(255, 248, 234, 0.06);
    border: 1px solid rgba(255, 248, 234, 0.14);
    border-radius: 100px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: rgba(255, 248, 234, 0.75);
    text-decoration: none;
    transition:
      background 260ms ease,
      border-color 260ms ease,
      color 260ms ease,
      transform 260ms ease;
  }
  .member-link:hover {
    background: rgba(97, 225, 230, 0.12);
    border-color: rgba(97, 225, 230, 0.42);
    color: var(--cream);
    transform: translateY(-1px);
  }
  .member-link svg {
    width: 14px;
    height: 14px;
    color: var(--cyan);
    flex-shrink: 0;
  }
  /* El chip de LinkedIn es sólo el icono — más chico, cuadrado-ish */
  .member-link.linkedin {
    padding: 7px 10px;
  }
  .email-icon {
    /* Selector legado, mantenido para el mail */
    width: 14px;
    height: 14px;
    color: var(--cyan);
    flex-shrink: 0;
  }

  /* Reveal */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease, transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .team-grid,
    .team--colab .team-grid { grid-template-columns: 1fr; max-width: 480px; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .member, .email { transition: none; }
  }
</style>

<script>
  import { revealOnScroll } from '../scripts/reveal';
  // Se re-anima cada vez que los items vuelven al viewport
  const items = document.querySelectorAll<HTMLElement>('.team [data-reveal]');
  if (items.length) {
    // Histéresis: salida 48px sobre la pantalla (> 24px del translateY
    // oculto) para que la tarjeta no vuelva a entrar al ocultarse.
    revealOnScroll(items, {
      enterMargin: '0px 0px -12% 0px',
      threshold: 0.15,
      exitMargin: '48px 0px -12% 0px',
      staggerMs: 80,
    });
  }
</script>
