---
// Sección de contacto — inmediatamente después de Equipo.
// Reúne los medios de contacto de Troppo: correo (el mismo publicado en
// Footer y Feria), LinkedIn e Instagram. Reutiliza el lenguaje visual del
// sitio: fondo cream translúcido, eyebrow cyan-ink, h2 en la fuente de
// títulos y tarjetas con gradient cyan sutil → blanco. Sin animaciones
// de scroll: la sección es estática.

const canales = [
  {
    id: 'mail',
    label: 'Correo electrónico',
    value: 'troppo2026@gmail.com',
    href: 'mailto:troppo2026@gmail.com',
    external: false,
    aria: 'Enviar un correo a Troppo (troppo2026@gmail.com)',
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    value: 'troppo-traffic',
    href: 'https://www.linkedin.com/company/troppo-traffic',
    external: true,
    aria: 'LinkedIn de Troppo (se abre en una pestaña nueva)',
  },
  {
    id: 'instagram',
    label: 'Instagram',
    value: '@troppo.cl',
    href: 'https://www.instagram.com/troppo.cl/',
    external: true,
    aria: 'Instagram de Troppo (se abre en una pestaña nueva)',
  },
];
---

<section class="contacto sec-light" id="contacto">
  <div class="wrap">
    <header class="contacto-head">
      <div class="contacto-eyebrow sec-title">
        Contacto
      </div>
      <h2 class="sec-subtitle">Escríbenos o síguenos <em>en nuestras redes.</em></h2>
      <p class="contacto-hint">
        Haz clic en cualquiera de nuestros contactos para comunicarte con nosotros.
      </p>
    </header>

    <ul class="contacto-grid">
      {
        canales.map((c) => (
          <li>
            <a
              class="contacto-card"
              href={c.href}
              aria-label={c.aria}
              {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="contacto-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  {c.id === 'mail' && (
                    <>
                      <rect x="2.5" y="4.5" width="15" height="11" rx="2" />
                      <path d="M2.5 6 L10 11 L17.5 6" />
                    </>
                  )}
                  {c.id === 'linkedin' && (
                    <>
                      <rect x="3" y="3" width="14" height="14" rx="2" />
                      <path d="M6.5 8.5 L6.5 14" />
                      <circle cx="6.5" cy="6" r="0.9" fill="currentColor" stroke="none" />
                      <path d="M9.5 14 L9.5 8.5 M9.5 11 C 9.5 9.5 10.6 8.5 12 8.5 C 13.4 8.5 14 9.5 14 11 L14 14" />
                    </>
                  )}
                  {c.id === 'instagram' && (
                    <>
                      <rect x="3" y="3" width="14" height="14" rx="4" />
                      <circle cx="10" cy="10" r="3.4" />
                      <circle cx="14.4" cy="5.6" r="0.6" fill="currentColor" />
                    </>
                  )}
                </svg>
              </span>
              <span class="contacto-label">{c.label}</span>
              <span class="contacto-value">{c.value}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contacto {
    padding: 100px 0 110px;
    background: rgba(255, 248, 234, 0.72);
    position: relative;
  }

  /* ---- HEAD (título y subtítulo: tipografía en global.css) ---- */
  .contacto-head {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }
  .contacto-eyebrow {
    display: inline-flex;
    align-items: center;
    margin-bottom: 24px;
  }
  .contacto h2 {
    margin: 0;
  }
  /* Indicación de que las tarjetas de contacto son clicables */
  .contacto-hint {
    margin: 16px auto 0;
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: rgba(21, 27, 32, 0.72);
  }

  /* ---- TARJETAS (gradient cyan sutil → blanco, como stat-card / hito) ---- */
  .contacto-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .contacto-grid li {
    display: flex;
  }
  .contacto-card {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 26px 28px 28px;
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.06), #fff);
    border: 1px solid rgba(97, 225, 230, 0.28);
    border-radius: 16px;
    box-shadow: 0 10px 28px rgba(4, 69, 89, 0.06);
    color: var(--navy);
    transition:
      border-color 260ms ease,
      box-shadow 260ms ease;
  }
  .contacto-card:hover,
  .contacto-card:focus-visible {
    border-color: rgba(97, 225, 230, 0.55);
    box-shadow:
      0 14px 32px rgba(4, 69, 89, 0.14),
      0 0 0 3px rgba(97, 225, 230, 0.28);
  }
  .contacto-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgba(97, 225, 230, 0.12);
    border: 1px solid rgba(97, 225, 230, 0.28);
    color: var(--cyan-ink);
    margin-bottom: 12px;
  }
  .contacto-label {
    font-family: var(--font-sans);
    /* Un poco más grande que el dato de contacto (16px) para marcar jerarquía */
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--cyan-ink);
  }
  .contacto-value {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--navy);
    /* Por si un valor no cabe en pantallas muy angostas */
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .contacto { padding: 72px 0 80px; }
    .contacto-head { margin-bottom: 36px; }
    .contacto-hint { font-size: 16px; }
    .contacto-grid {
      grid-template-columns: 1fr;
      gap: 14px;
      max-width: 480px;
    }
    .contacto-card { padding: 22px 22px 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .contacto-card { transition: none; }
  }
</style>
