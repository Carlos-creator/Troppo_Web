---
// Sección de video del pitch — YouTube embed
// TEMP: video de prueba (Michael Jackson) para validar el embed funciona.
// Reemplazar el VIDEO_ID cuando esté grabado el pitch real.
const YT_VIDEO_ID = 'crbFmpezO4A';
---

<section class="video-section" id="pitch">
  <div class="wrap">
    <div class="video-head">
      <div class="eyebrow">EL PITCH EN 90 SEGUNDOS</div>
      <h2>Verlo funcionando dice más que cualquier slide.</h2>
    </div>
    <div class="video-frame">
      <iframe
        class="video-embed"
        src={`https://www.youtube.com/embed/${YT_VIDEO_ID}?rel=0`}
        title="Pitch de Troppo"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .video-section {
    padding: 110px 0;
    background: rgba(255, 248, 234, 0.72);
  }
  .video-head {
    max-width: 640px;
    margin-bottom: 48px;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 600;
    color: var(--navy);
    opacity: 0.55;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 38px;
    margin-top: 14px;
    line-height: 1.2;
  }
  .video-frame {
    aspect-ratio: 16 / 9;
    background: var(--navy);
    border-radius: 20px;
    overflow: hidden;
    position: relative;
  }
  .video-embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
