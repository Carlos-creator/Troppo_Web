---
// Sección de video del pitch — YouTube embed.
// Pitch oficial de Troppo (34.ª Feria de Software USM).
const YT_VIDEO_ID = 'uqM7lYhbgQM';
---

<section class="video-section sec-light" id="pitch">
  <div class="wrap">
    <div class="video-head">
      <div class="eyebrow sec-title">El pitch en 90 segundos</div>
    </div>
    <div class="video-frame">
      <iframe
        class="video-embed"
        src={`https://www.youtube.com/embed/${YT_VIDEO_ID}?rel=0`}
        title="Pitch de Troppo"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .video-section {
    padding: 110px 0;
    background: rgba(255, 248, 234, 0.72);
  }
  .video-head {
    max-width: 640px;
    margin-bottom: 36px;
  }
  .video-frame {
    aspect-ratio: 16 / 9;
    background: var(--navy);
    border-radius: 20px;
    overflow: hidden;
    position: relative;
  }
  .video-embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
