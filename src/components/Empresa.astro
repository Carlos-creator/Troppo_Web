---
// Sección 8 rúbrica — "Nosotros" (antes "Zona empresa"): una única sección continua (mismo
// fondo) con cuatro bloques en este orden:
//   1. Equipo (Team.astro)          2. Colaboradores (Team.astro)
//   3. Propósito y dirección (Misión + Visión)   4. Los 5 valores
import Team from './Team.astro';

const valores = [
  {
    num: '01',
    titulo: 'Innovación',
    desc: 'Troppo integra simulación de tráfico, inteligencia artificial y monitoreo en vivo para transformar la forma en que se evalúan y gestionan las decisiones de movilidad.',
    icon: 'spark',
  },
  {
    num: '02',
    titulo: 'Precisión',
    desc: 'Cada implementación se sustenta en datos reales y validación, y el programa se calibra a medida de cada zona de estudio.',
    icon: 'target',
  },
  {
    num: '03',
    titulo: 'Transparencia',
    desc: 'Los reportes incluyen la configuración completa utilizada; cada mejora se justifica en métricas y no en meras promesas.',
    icon: 'eye',
  },
  {
    num: '04',
    titulo: 'Cercanía',
    desc: 'Diseñamos con quien nos contrata, no para él. Escuchamos, iteramos y validamos en conjunto.',
    icon: 'handshake',
  },
  {
    num: '05',
    titulo: 'Sustentabilidad operacional',
    desc: 'Optimizar el flujo reduce el combustible quemado en detención y la huella de la operación logística.',
    icon: 'leaf',
  },
];
---

<section class="empresa sec-dark" id="empresa">
  <div class="wrap">
    <header class="empresa-head">
      <div class="empresa-eyebrow sec-title">Nosotros</div>
      <h2 class="sec-subtitle">El equipo detrás de Troppo</h2>
    </header>

    <!-- 1. Equipo -->
    <Team />

    <!-- 2. Colaboradores -->
    <div class="bloque-head" data-reveal>
      <div class="bloque-eyebrow sec-subtitle">COLABORADORES</div>
    </div>
    <Team grupo="colaboradores" />

    <!-- 3. Propósito y dirección: Misión + Visión lado a lado -->
    <div class="bloque-head" data-reveal>
      <div class="bloque-eyebrow sec-subtitle">PROPÓSITO Y DIRECCIÓN</div>
    </div>
    <div class="mv-grid">
      <article class="mv-card mv-mision" data-reveal>
        <div class="mv-label">
          <svg class="mv-label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" opacity="0.35" />
            <circle cx="12" cy="12" r="6" opacity="0.55" />
            <circle cx="12" cy="12" r="2" fill="currentColor" />
            <line x1="12" y1="2" x2="12" y2="4" />
            <line x1="12" y1="20" x2="12" y2="22" />
            <line x1="2" y1="12" x2="4" y2="12" />
            <line x1="20" y1="12" x2="22" y2="12" />
          </svg>
          <span>Misión</span>
        </div>
        <p>
          Optimizar la gestión del tráfico portuario mediante
          <strong>simulación</strong> y
          <strong>análisis inteligente en tiempo real</strong>, entregando a
          entidades importantes herramientas basadas en datos que reduzcan
          tiempos de espera, mejoren el flujo vehicular y respalden decisiones
          operativas con <em>evidencia cuantificable</em>.
        </p>
      </article>

      <article class="mv-card mv-vision" data-reveal>
        <div class="mv-label">
          <svg class="mv-label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12 C 6 6, 18 6, 21 12 C 18 18, 6 18, 3 12 Z" />
            <circle cx="12" cy="12" r="3.5" />
            <circle cx="12" cy="12" r="1.2" fill="currentColor" />
          </svg>
          <span>Visión</span>
        </div>
        <p>
          Ser la <strong>plataforma de referencia</strong> en gestión inteligente
          de tráfico para la industria portuaria y logística de
          <strong>Chile y Latinoamérica</strong>, integrando gemelos digitales,
          IA aplicada y sensórica real para transformar la manera en que puertos,
          municipalidades y entidades grandes planifican y operan su
          infraestructura vial.
        </p>
      </article>
    </div>

    <!-- 4. Valores -->
    <div class="valores-head" data-reveal>
      <div class="valores-eyebrow sec-subtitle">LOS 5 VALORES QUE NOS GUÍAN</div>
    </div>
    <div class="valores-grid">
      {
        valores.map((v) => (
          <article class="valor-card" data-reveal>
            <div class="valor-head">
              <span class="valor-num">{v.num}</span>
              <div class="valor-icon-wrap">
                <svg class="valor-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {v.icon === 'spark' && (
                    <>
                      <path d="M12 3 L14 10 L21 12 L14 14 L12 21 L10 14 L3 12 L10 10 Z" />
                    </>
                  )}
                  {v.icon === 'target' && (
                    <>
                      <circle cx="12" cy="12" r="10" opacity="0.5" />
                      <circle cx="12" cy="12" r="6" opacity="0.75" />
                      <circle cx="12" cy="12" r="2" fill="currentColor" />
                    </>
                  )}
                  {v.icon === 'eye' && (
                    <>
                      <path d="M2 12 C 5 6, 19 6, 22 12 C 19 18, 5 18, 2 12 Z" />
                      <circle cx="12" cy="12" r="3.5" />
                      <circle cx="12" cy="12" r="1" fill="currentColor" />
                    </>
                  )}
                  {v.icon === 'handshake' && (
                    <>
                      <path d="M4 14 L8 10 L12 12 L16 10 L20 14" />
                      <path d="M8 10 L10 8 L14 8 L16 10" opacity="0.6" />
                      <path d="M4 14 L4 18 L20 18 L20 14" />
                    </>
                  )}
                  {v.icon === 'leaf' && (
                    <>
                      <path d="M4 20 C 4 12, 12 4, 20 4 C 20 12, 12 20, 4 20 Z" />
                      <path d="M4 20 L12 12" opacity="0.6" />
                    </>
                  )}
                </svg>
              </div>
            </div>
            <h4>{v.titulo}</h4>
            <p>{v.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Fondo navy único para toda la zona (antes cream aquí y navy en el
     equipo): equipo, colaboradores, propósito y valores se leen como una
     sola sección. Es el mismo fondo que tenía la sección del equipo, así
     sus tarjetas quedan exactamente igual. */
  .empresa {
    padding: 110px 0 120px;
    background: rgba(3, 53, 68, 0.84);
    color: var(--cream);
    position: relative;
    overflow: hidden;
  }
  .wrap { position: relative; z-index: 1; }

  /* ---- HEAD ---- */
  .empresa-head {
    max-width: 760px;
    margin: 0 auto 60px;
    text-align: center;
  }
  .empresa-eyebrow {
    margin-bottom: 14px;
  }
  .empresa-head h2 {
    margin: 0;
  }

  /* ---- MISIÓN + VISIÓN ---- */
  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    max-width: 1080px;
    margin: 0 auto;
  }
  /* Tarjetas de vidrio sobre el fondo navy de la zona: mismo lenguaje
     que las tarjetas de equipo y las de "¿Qué ofrece Troppo?" (fondo
     cream casi transparente, borde cream sutil, halo cyan en la esquina
     al hacer hover, borde cyan + sombra profunda en hover). */
  .mv-card {
    background: rgba(255, 248, 234, 0.045);
    border: 1px solid rgba(255, 248, 234, 0.14);
    border-radius: 20px;
    padding: 38px 40px;
    position: relative;
    overflow: hidden;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      background 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease;
  }
  .mv-card::before,
  .valor-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 90% at 100% 0%,
      rgba(97, 225, 230, 0.14) 0%,
      transparent 55%
    );
    opacity: 0;
    transition: opacity 500ms ease;
    pointer-events: none;
  }
  .mv-card:hover::before,
  .valor-card:hover::before { opacity: 1; }
  .mv-card:hover {
    transform: translateY(-4px);
    background: rgba(97, 225, 230, 0.055);
    border-color: rgba(97, 225, 230, 0.4);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.25);
  }
  .mv-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    background: rgba(97, 225, 230, 0.10);
    border: 1px solid rgba(97, 225, 230, 0.22);
    border-radius: 100px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.6px;
    color: var(--cream);
    text-transform: uppercase;
    margin-bottom: 20px;
    position: relative;
  }
  .mv-label-icon {
    width: 22px;
    height: 22px;
    padding: 4px;
    background: var(--cyan);
    border-radius: 50%;
    color: var(--navy-deep);
    box-sizing: border-box;
  }
  .mv-card p {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.55;
    color: rgba(255, 248, 234, 0.82);
    margin: 0;
    font-weight: 500;
    position: relative;
  }
  .mv-card strong {
    font-weight: 700;
    color: var(--cream);
  }
  .mv-card em {
    font-style: italic;
    color: var(--cyan);
    font-weight: 500;
  }


  /* ---- SUBTÍTULOS DE BLOQUE (Colaboradores, Propósito y dirección,
     Valores) — mismo estilo para los tres ---- */
  .bloque-head,
  .valores-head {
    max-width: 900px;
    margin: 76px auto 40px;
    text-align: center;
  }

  /* ---- VALORES ---- */
  .valores-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
    max-width: 1180px;
    margin: 0 auto;
  }
  .valor-card {
    background: rgba(255, 248, 234, 0.045);
    border: 1px solid rgba(255, 248, 234, 0.14);
    /* Se mantiene la barra superior de acento, en cyan para el fondo navy */
    border-top: 4px solid var(--cyan);
    border-radius: 4px 4px 20px 20px;
    padding: 24px 22px 26px;
    position: relative;
    overflow: hidden;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      background 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease;
  }
  .valor-card:hover {
    transform: translateY(-4px);
    background: rgba(97, 225, 230, 0.055);
    border-color: rgba(97, 225, 230, 0.4);
    border-top-color: var(--cyan);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.25);
  }
  .valor-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    position: relative;
  }
  .valor-num {
    font-family: var(--font-title);
    font-size: 22px;
    color: var(--cyan);
    font-weight: 700;
    line-height: 1;
  }
  .valor-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(97, 225, 230, 0.10);
    border: 1px solid rgba(97, 225, 230, 0.22);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cyan);
    transition:
      transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1),
      background 400ms ease,
      border-color 400ms ease;
  }
  .valor-card:hover .valor-icon-wrap {
    transform: scale(1.08) rotate(-3deg);
    background: rgba(97, 225, 230, 0.18);
    border-color: var(--cyan);
  }
  .valor-icon { width: 22px; height: 22px; }
  .valor-card h4 {
    font-family: var(--font-title);
    font-size: 15px;
    font-weight: 700;
    color: var(--cream);
    margin: 0 0 8px;
    letter-spacing: 0.2px;
    position: relative;
  }
  .valor-card p {
    font-size: 13px;
    line-height: 1.55;
    color: rgba(255, 248, 234, 0.78);
    margin: 0;
    position: relative;
  }

  /* ---- REVEAL ---- */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease, transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- MOBILE --- */
  @media (max-width: 960px) {
    .mv-grid { grid-template-columns: 1fr; }
    .valores-grid { grid-template-columns: repeat(2, 1fr); }
    .mv-card { padding: 28px 26px; }
    .mv-card p { font-size: 15px; }
  }
  @media (max-width: 520px) {
    .valores-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .mv-card, .valor-card, .valor-icon-wrap { transition: none; }
  }
</style>

<script>
  import { revealOnScroll } from '../scripts/reveal';
  // Se re-anima cada vez que los items vuelven al viewport
  // Excluye las tarjetas del equipo/colaboradores (.member): su reveal
  // lo maneja el script de Team.astro.
  const items = document.querySelectorAll<HTMLElement>('.empresa [data-reveal]:not(.member)');
  if (items.length) {
    // Histéresis: salida 48px sobre la pantalla (> 24px del translateY
    // oculto) para que la tarjeta no vuelva a entrar al ocultarse.
    revealOnScroll(items, {
      enterMargin: '0px 0px -10% 0px',
      threshold: 0.12,
      exitMargin: '48px 0px -10% 0px',
      staggerMs: 90,
    });
  }
</script>
