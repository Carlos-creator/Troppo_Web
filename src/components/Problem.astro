---
// Sección del problema — cifras duras del acceso a San Antonio.
// Banda superior con un degradado que continúa el que empieza al final
// del Hero y se funde con el fondo cream de la sección. Debajo, ya sobre
// el cream, el título (eyebrow) y el subtítulo (h2) junto a las cifras.
---

<section class="problem sec-light" id="problema">
  <!-- Banda de transición Hero → Problema (sólo degradado) -->
  <div class="port-band" aria-hidden="true"></div>

  <div class="wrap">
    <!-- Título + subtítulo de la sección, agrupados con las cifras -->
    <header class="problem-head">
      <span class="problem-eyebrow sec-title">El problema de la congestión en la red vial</span>
      <h2 class="sec-subtitle">
        San Antonio mueve el país.
        <em>Y el país espera en la fila.</em>
      </h2>
    </header>

    <div class="stat-grid">
      <div class="stat-card">
        <!-- El "+" queda fuera del contador para que la animación no lo borre -->
        <div class="num">+<span data-count-to="900000" data-suffix="">900.000</span></div>
        <p>Camiones al año circulando por los accesos.</p>
      </div>
      <div class="stat-card">
        <div class="num">+<span data-count-to="30" data-suffix=" min">30 min</span></div>
        <p>De espera por camión.</p>
      </div>
    </div>

    <!-- Escala nacional: la cifra sistémica del rúbrica -->
    <div class="stat-nacional">
      <div class="stat-nacional-eyebrow">Impacto sistémico · Escala nacional</div>
      <div class="stat-nacional-num">
        <span class="nac-currency">$</span>
        <span class="nac-num" data-count-to="11000" data-suffix="">11.000</span>
        <em>millones de pesos chilenos</em>
      </div>
      <p>
        Es lo que pierde el sector portuario chileno <strong>cada año</strong> por
        congestión y brechas de gestión en sus accesos viales.
      </p>
    </div>

    <!-- Cierre de la sección: texto libre (sin caja) -->
    <p class="problem-close">
      Evaluar alternativas antes de implementar cambios es clave: las decisiones
      sobre semáforos e infraestructura son <strong>costosas y riesgosas</strong>.
    </p>
  </div>
</section>

<style>
  /* El fondo cream empieza DEBAJO de la banda superior (--band-h): así
     el degradado de la banda se apoya directamente sobre el bioma, igual
     que el Hero, y la transición Hero → Problema no tiene corte. */
  .problem {
    --band-h: clamp(160px, 18vw, 240px);
    padding: 0 0 110px;
    background:
      linear-gradient(rgba(255, 248, 234, 0.72), rgba(255, 248, 234, 0.72))
      0 var(--band-h) / 100% 100% no-repeat;
  }

  /* ------- BANDA SUPERIOR: TRANSICIÓN DESDE EL HERO ------- */
  /* Degradado sin cortes: el aclarado empieza ya en el último tramo del
     Hero (navy 0.55 → 0.42, ver Hero.astro); aquí arranca en ese mismo
     navy 0.42 y se funde con el cream 0.72 del fondo de la sección. */
  .port-band {
    position: relative;
    width: 100%;
    height: var(--band-h);
    background: linear-gradient(
      180deg,
      rgba(4, 69, 89, 0.42) 0%,
      rgba(255, 248, 234, 0.72) 100%
    );
  }
  /* ------- CARTEL SOBRE EL DEGRADADO ------- */
  /* Contenedor centrado vertical/horizontal con halo radial oscuro detrás
     para legibilidad del texto. */
  /* ------- TÍTULO + SUBTÍTULO (sobre el cream) -------
     Mismo tamaño y jerarquía que antes; colores de sección clara
     (navy + acento cyan-ink) en vez de los de texto sobre foto. */
  .problem-head {
    /* ancho completo: el título de sección (38px) cabe en una línea */
    max-width: none;
    margin: 0 auto;
    padding-top: 8px;
    text-align: center;
  }
  .problem-eyebrow {
    display: inline-block;
    margin-bottom: 20px;
  }
  .problem-head h2 {
    margin: 0;
  }

  /* ------- STATS (contenido original) ------- */
  .stat-grid {
    display: grid;
    /* 2 indicadores (antes 3): 2 columnas para no dejar un hueco */
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    margin-top: 48px;
  }
  .stat-card {
    /* Gradient cyan sutil → blanco + barra cyan-ink (oscuro) gruesa
       ARRIBA como acento distintivo. */
    padding: 22px 24px 24px;
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.05), #fff);
    border: 1px solid rgba(97, 225, 230, 0.28);
    border-top: 4px solid var(--cyan-ink);
    border-radius: 4px 4px 20px 20px;
    box-shadow: 0 10px 28px rgba(4, 69, 89, 0.06);
  }
  .stat-card .num {
    font-family: var(--font-title);
    font-size: 46px;
    color: var(--navy);
    font-weight: 700;
  }
  .stat-card p {
    margin-top: 10px;
    font-size: 15px;
    color: rgba(21, 27, 32, 0.7);
    max-width: 230px;
  }

  /* ---- BLOQUE NACIONAL (cifra sistémica 11.000 MM al año) ---- */
  .stat-nacional {
    margin-top: 72px;
    padding: 40px 46px;
    /* Gradient cyan sutil → blanco como el resto de bloques descriptivos,
       pero manteniendo una barra cyan brillante gruesa a la izquierda
       como acento distintivo — es la cifra más importante de la sección. */
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.05), #fff);
    border: 1px solid rgba(97, 225, 230, 0.28);
    border-left: 4px solid var(--cyan);
    border-radius: 4px 20px 20px 4px;
    box-shadow: 0 10px 28px rgba(4, 69, 89, 0.06);
    position: relative;
  }
  .stat-nacional-eyebrow {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 2.5px;
    color: var(--cyan-ink);
    text-transform: uppercase;
    opacity: 1;
  }
  .stat-nacional-num {
    margin-top: 14px;
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--navy);
    line-height: 1;
    letter-spacing: -1.5px;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }
  .nac-currency {
    font-size: 42px;
    font-weight: 500;
    color: var(--navy);
    opacity: 0.75;
    margin-right: 2px;
  }
  .nac-num {
    font-size: 68px;
    font-weight: 500;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
  }
  .stat-nacional-num em {
    font-family: var(--font-title);
    font-style: italic;
    font-size: 30px;
    font-weight: 400;
    color: var(--navy);
    opacity: 0.7;
    margin-left: 10px;
  }
  .stat-nacional > p {
    margin-top: 20px;
    font-size: 15.5px;
    line-height: 1.6;
    color: rgba(21, 27, 32, 0.78);
    max-width: 640px;
  }
  .stat-nacional > p strong {
    color: var(--navy);
    font-weight: 700;
  }

  /* ---- CIERRE (texto libre, sin contenedor) ---- */
  .problem-close {
    margin: 56px auto 0;
    max-width: 760px;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 19px;
    line-height: 1.55;
    color: var(--navy);
  }
  .problem-close strong {
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .problem {
      --band-h: clamp(120px, 30vw, 160px);
    }
    .problem-eyebrow {
      margin-bottom: 14px;
    }
    .stat-grid {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }
    .stat-nacional {
      padding: 28px 24px;
      margin-top: 52px;
    }
    .nac-currency { font-size: 30px; }
    .nac-num { font-size: 48px; }
    .stat-nacional-num em { font-size: 22px; margin-left: 6px; }
    .stat-nacional > p { font-size: 14.5px; }
    .problem-close { margin-top: 40px; font-size: 16.5px; }
  }
</style>

<script>
  import { observeReveal } from '../scripts/reveal';
  // Animación de conteo — re-anima cada vez que el elemento vuelve al
  // viewport (para dar sensación de "vivo" al scrollear ida y vuelta).
  // Cuando el elemento SALE del viewport se resetea a 0; al re-entrar,
  // el contador vuelve a subir hasta el valor. Cancela el rAF anterior
  // si el usuario entra/sale rápido para evitar solapes.
  const nums = document.querySelectorAll<HTMLElement>('[data-count-to]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (nums.length && !reducedMotion && 'IntersectionObserver' in window) {
    const easeOutCubic = (t: number): number => 1 - Math.pow(1 - t, 3);

    // Guardamos el rAF handle por elemento para poder cancelarlo
    const rafHandles = new WeakMap<HTMLElement, number>();

    // Estado inicial: mostrar 0 en todos
    nums.forEach((el) => {
      const suffix = el.dataset.suffix ?? '';
      el.textContent = '0' + suffix;
    });

    const startCount = (el: HTMLElement) => {
      const prev = rafHandles.get(el);
      if (prev) cancelAnimationFrame(prev);

      const target = Number(el.dataset.countTo);
      const suffix = el.dataset.suffix ?? '';
      const duration = 1400;
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = easeOutCubic(progress);
        const current = Math.floor(target * eased);
        el.textContent = current.toLocaleString('es-CL') + suffix;
        if (progress < 1) {
          rafHandles.set(el, requestAnimationFrame(tick));
        } else {
          rafHandles.delete(el);
        }
      };

      rafHandles.set(el, requestAnimationFrame(tick));
    };

    const resetCount = (el: HTMLElement) => {
      const prev = rafHandles.get(el);
      if (prev) {
        cancelAnimationFrame(prev);
        rafHandles.delete(el);
      }
      const suffix = el.dataset.suffix ?? '';
      el.textContent = '0' + suffix;
    };

    // Histéresis: el conteo arranca al superar el 40% visible y sólo se
    // reinicia (vuelve a 0) cuando el número sale por completo de la
    // pantalla (exitThreshold 0). Cruzar el 40% en cualquier sentido ya
    // no reinicia un contador que está contando o que terminó, y el
    // reinicio a 0 ocurre fuera de la vista. Sin transform → la zona de
    // salida puede ser la pantalla misma.
    observeReveal(nums, {
      enterMargin: '0px',
      threshold: 0.4,
      exitMargin: '0px',
      exitThreshold: 0,
      onEnter: (el) => startCount(el),
      onExit: (el) => resetCount(el),
    });
  }
</script>
