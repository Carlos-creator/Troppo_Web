---
// Sección del problema — cifras duras del acceso a San Antonio.
// Banda cinematográfica arriba: dos fotos del puerto que hacen transición
// dissolve orgánica (fractalNoise) mientras un filtro cyan de marca las
// tinta como en el mockup puerto_cyan.png.
---

<section class="problem" id="problema">
  <div class="port-band" aria-hidden="true">
    <svg
      class="port-svg"
      viewBox="0 0 1600 500"
      preserveAspectRatio="xMidYMid slice"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
    >
      <defs>
        <!--
          Filtro turbulent-dissolve:
          feTurbulence genera ruido fractal → convertimos a alpha por
          luminancia → animamos el slope para que el umbral suba y baje
          (0 → 2 → 0) creando el efecto de disolución orgánica entre
          la imagen SourceGraphic (puerto-1) y feImage (puerto-2).
        -->
        <filter id="turbulent-dissolve" x="0%" y="0%" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency=".009" seed="5" />
          <feColorMatrix type="luminanceToAlpha" />
          <feComponentTransfer>
            <feFuncA type="linear" slope="0">
              <animate
                attributeName="slope"
                values="0;0;0;0;0;0.5;1;1.5;2;2;2;2;2;2;1.5;1;0.5;0"
                dur="14s"
                repeatCount="indefinite"
              />
            </feFuncA>
          </feComponentTransfer>
          <feComponentTransfer>
            <feFuncA type="discrete" tableValues="0 1" />
          </feComponentTransfer>
          <feGaussianBlur stdDeviation="1" />
          <feComposite operator="in" in="SourceGraphic" result="overlay" />
          <feImage
            href="/images/puerto/puerto-2.jpg"
            xlink:href="/images/puerto/puerto-2.jpg"
            width="1600"
            height="500"
            preserveAspectRatio="xMidYMid slice"
            result="underlay"
          />
          <feComposite operator="over" in="overlay" in2="underlay" />
        </filter>
      </defs>

      <image
        filter="url(#turbulent-dissolve)"
        width="1600"
        height="500"
        href="/images/puerto/puerto-1.jpg"
        xlink:href="/images/puerto/puerto-1.jpg"
        preserveAspectRatio="xMidYMid slice"
      />
    </svg>

    <div class="port-overlay"></div>

    <div class="port-caption">
      <span class="port-loc">PUERTO DE SAN ANTONIO</span>
      <span class="port-sep"></span>
      <span class="port-sub">Corredor logístico bajo presión</span>
    </div>
  </div>

  <div class="wrap">
    <div class="problem-head">
      <div class="eyebrow">El punto de partida</div>
      <h2>San Antonio mueve el país. Y el país espera en la fila.</h2>
    </div>
    <div class="stat-grid">
      <div class="stat-card">
        <div class="num" data-count-to="7000" data-suffix="">7.000</div>
        <p>Camiones circulando por los accesos en un solo día peak.</p>
      </div>
      <div class="stat-card">
        <div class="num" data-count-to="9" data-suffix=" hrs">9 hrs</div>
        <p>Tiempo de espera máximo registrado en los nodos viales críticos.</p>
      </div>
      <div class="stat-card">
        <div class="num" data-count-to="800" data-suffix="+">800+</div>
        <p>Transportistas de carga pesada que transitan la zona a diario.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .problem {
    padding: 0 0 110px;
    background: rgba(255, 248, 234, 0.72);
  }

  /* ------- BANDA CINEMATOGRÁFICA DEL PUERTO ------- */
  .port-band {
    position: relative;
    width: 100%;
    height: clamp(280px, 42vw, 520px);
    overflow: hidden;
    background: var(--navy-deep);
    margin-bottom: 80px;
  }
  .port-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    /* Duotone cyan de marca — approximación con filter chain:
       grayscale → sepia (tono cálido base) → hue-rotate hacia cyan →
       saturate para reforzar → brightness para ajustar densidad. */
    filter:
      grayscale(1)
      contrast(1.12)
      sepia(1)
      hue-rotate(155deg)
      saturate(1.9)
      brightness(0.92);
    will-change: filter;
  }
  /* Gradiente cyan/navy encima y fade a cream abajo para blend suave con
     el fondo cream de la sección */
  .port-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(4, 69, 89, 0.15) 0%,
        rgba(4, 69, 89, 0.25) 55%,
        rgba(255, 248, 234, 0.85) 92%,
        var(--cream) 100%
      );
    pointer-events: none;
  }
  /* Caption inferior con dot pulsante — sensación "en vivo" */
  .port-caption {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 9px 18px;
    background: rgba(21, 27, 32, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 100px;
    border: 1px solid rgba(97, 225, 230, 0.3);
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--cream);
    z-index: 2;
    white-space: nowrap;
  }
  .port-loc {
    color: var(--cyan);
  }
  .port-sep {
    width: 4px;
    height: 4px;
    background: var(--cyan);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--cyan);
    animation: port-dot-pulse 1.6s ease-in-out infinite;
  }
  .port-sub {
    color: rgba(255, 248, 234, 0.7);
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: none;
    font-size: 11px;
  }
  @keyframes port-dot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.7); }
  }

  /* ------- HEAD + STATS (contenido original) ------- */
  .problem-head {
    max-width: 640px;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 600;
    color: var(--navy);
    opacity: 0.55;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 38px;
    margin-top: 14px;
    line-height: 1.2;
  }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 56px;
  }
  .stat-card {
    border-top: 2px solid var(--navy);
    padding-top: 20px;
  }
  .stat-card .num {
    font-family: var(--font-serif);
    font-size: 46px;
    color: var(--navy);
    font-weight: 500;
  }
  .stat-card p {
    margin-top: 10px;
    font-size: 15px;
    color: rgba(21, 27, 32, 0.7);
    max-width: 230px;
  }

  @media (max-width: 860px) {
    .port-band {
      height: clamp(220px, 55vw, 340px);
      margin-bottom: 56px;
    }
    .port-caption {
      font-size: 9.5px;
      padding: 7px 14px;
      letter-spacing: 1.5px;
    }
    .stat-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .port-band .port-svg animate { display: none; }
    .port-sep { animation: none; }
  }
</style>

<script>
  // Animación de conteo — respeta prefers-reduced-motion.
  // Si JS falla, el HTML ya muestra el valor final (fallback seguro).
  const nums = document.querySelectorAll<HTMLElement>('.num[data-count-to]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (nums.length && !reducedMotion && 'IntersectionObserver' in window) {
    // Reset a 0 para que el conteo se sienta completo desde el inicio
    nums.forEach((el) => {
      const suffix = el.dataset.suffix ?? '';
      el.textContent = '0' + suffix;
    });

    const easeOutCubic = (t: number): number => 1 - Math.pow(1 - t, 3);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.countTo);
          const suffix = el.dataset.suffix ?? '';
          const duration = 1400;
          const start = performance.now();

          function tick(now: number) {
            const progress = Math.min((now - start) / duration, 1);
            const eased = easeOutCubic(progress);
            const current = Math.floor(target * eased);
            el.textContent = current.toLocaleString('es-CL') + suffix;
            if (progress < 1) requestAnimationFrame(tick);
          }

          requestAnimationFrame(tick);
          observer.unobserve(el);
        });
      },
      { threshold: 0.4 }
    );

    nums.forEach((el) => observer.observe(el));
  }
</script>
