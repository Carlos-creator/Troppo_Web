---
// Sección 4 rúbrica — "¿Por qué Troppo?"
//
// Diagrama recreado a partir de public/images/diagrama_por_que_troppo.png:
//   [Simulación y Análisis] → tarjetas 01 + 02  →  caja central Troppo
//   ("Todo en una sola plataforma")  →  [Optimización y Operación] →
//   tarjetas 03 + 04. Cada etiqueta de grupo se une a sus dos tarjetas con
//   un conector en forma de llave. Todo en HTML + SVG + CSS.

const grupos = [
  {
    etiqueta: 'Simulación y Análisis',
    pasos: [
      { num: '01', titulo: ['Simular', 'para probar'], icon: 'map' },
      { num: '02', titulo: ['Analizar', 'resultados'], icon: 'chart' },
    ],
  },
  {
    etiqueta: 'Optimización y Operación',
    pasos: [
      { num: '03', titulo: ['Optimizar', 'con IA'], icon: 'ai' },
      { num: '04', titulo: ['Monitorear y', 'operar en vivo'], icon: 'monitor' },
    ],
  },
];
---

<section class="porque sec-light" id="porque-troppo">
  <div class="wrap">
    <header class="porque-head">
      <div class="porque-eyebrow sec-title" data-vh>
        ¿Por qué Troppo?
      </div>
      <h2 class="sec-subtitle" data-vh>Todo el proceso, <em>en una sola plataforma.</em></h2>
      <p data-vh>
        Troppo integra en una sola plataforma las distintas etapas de gestión de
        la red vial: simular escenarios para evaluar alternativas,
        <strong>optimizar con IA</strong>, decidir con evidencia y
        <strong>monitorear y operar en tiempo real</strong>.
      </p>
    </header>

    <!-- Diagrama (recreación de diagrama_por_que_troppo.png) -->
    <div class="pq-diagram">
      <div class="pq-group pq-reveal">
        <div class="pq-pill">{grupos[0].etiqueta}</div>
        <svg class="pq-bracket" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true">
          <path d="M100 0 V12 Q100 20 92 20 H58 Q50 20 50 28 V40 M100 12 Q100 20 108 20 H142 Q150 20 150 28 V40" />
        </svg>
        <div class="pq-cards">
          {
            grupos[0].pasos.map((p) => (
              <article class="pq-card">
                <span class="pq-num">{p.num}</span>
                <span class="pq-icon" aria-hidden="true">
                  <svg viewBox="0 0 64 64">
                    {p.icon === 'map' && (
                      <>
                        <path class="pq-fill" d="M6 46 L34 37 L58 43 L30 54 Z" />
                        <path class="pq-thin" d="M13 44 L42 51 M22 41 L50 47 M27 39 L22 52 M40 40 L35 53" />
                        <path class="pq-stroke" d="M4 47 L30 55 L60 44" />
                        <path class="pq-stroke pq-pin" d="M32 6 C24.5 6 19 11.5 19 19 C19 28 32 40 32 40 C32 40 45 28 45 19 C45 11.5 39.5 6 32 6 Z" />
                        <circle class="pq-stroke" cx="32" cy="19" r="5" />
                      </>
                    )}
                    {p.icon === 'chart' && (
                      <>
                        <rect class="pq-stroke" x="8" y="38" width="6" height="14" />
                        <rect class="pq-stroke" x="18" y="29" width="6" height="23" />
                        <rect class="pq-fill pq-stroke" x="28" y="16" width="6" height="36" />
                        <circle class="pq-fill pq-stroke" cx="43" cy="38" r="9" />
                        <path class="pq-stroke pq-thick" d="M49.5 44.5 L57 52" />
                      </>
                    )}
                    {p.icon === 'ai' && (
                      <>
                        <rect class="pq-fill pq-stroke" x="16" y="16" width="32" height="32" rx="6" />
                        <path class="pq-stroke" d="M24 8 V16 M32 8 V16 M40 8 V16 M24 48 V56 M32 48 V56 M40 48 V56 M8 24 H16 M8 32 H16 M8 40 H16 M48 24 H56 M48 32 H56 M48 40 H56" />
                        <text class="pq-ia" x="32" y="38.5" text-anchor="middle">IA</text>
                      </>
                    )}
                    {p.icon === 'monitor' && (
                      <>
                        <rect class="pq-fill pq-stroke" x="6" y="10" width="52" height="34" rx="3" />
                        <path class="pq-stroke" d="M28 44 V52 M36 44 V52 M22 53 H42" />
                        <path class="pq-accent" d="M13 36 L22 28 L29 32 L38 22 L45 18" />
                        <circle class="pq-stroke" cx="49" cy="17" r="4" />
                      </>
                    )}
                  </svg>
                </span>
                <span class="pq-divider" aria-hidden="true"></span>
                <h3>{p.titulo[0]}<br />{p.titulo[1]}</h3>
              </article>
            ))
          }
        </div>
      </div>
      <div class="pq-arrow" aria-hidden="true">
        <svg viewBox="0 0 40 16"><path d="M2 8 H36 M29 2 L36 8 L29 14" /></svg>
      </div>
      <div class="pq-center pq-reveal">
        <img class="pq-brand" src="/images/logo/logo_troppo_azul.png" alt="Troppo" width="3410" height="693" />
        <span class="pq-center-line" aria-hidden="true"></span>
        <p>Todo en una<br />sola plataforma</p>
      </div>
      <!-- Flecha invertida: de "Optimizar con IA" hacia la caja central -->
      <div class="pq-arrow" aria-hidden="true">
        <svg viewBox="0 0 40 16"><path d="M38 8 H4 M11 2 L4 8 L11 14" /></svg>
      </div>
      <div class="pq-group pq-reveal">
        <div class="pq-pill">{grupos[1].etiqueta}</div>
        <svg class="pq-bracket" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true">
          <path d="M100 0 V12 Q100 20 92 20 H58 Q50 20 50 28 V40 M100 12 Q100 20 108 20 H142 Q150 20 150 28 V40" />
        </svg>
        <div class="pq-cards">
          {
            grupos[1].pasos.map((p) => (
              <article class="pq-card">
                <span class="pq-num">{p.num}</span>
                <span class="pq-icon" aria-hidden="true">
                  <svg viewBox="0 0 64 64">
                    {p.icon === 'map' && (
                      <>
                        <path class="pq-fill" d="M6 46 L34 37 L58 43 L30 54 Z" />
                        <path class="pq-thin" d="M13 44 L42 51 M22 41 L50 47 M27 39 L22 52 M40 40 L35 53" />
                        <path class="pq-stroke" d="M4 47 L30 55 L60 44" />
                        <path class="pq-stroke pq-pin" d="M32 6 C24.5 6 19 11.5 19 19 C19 28 32 40 32 40 C32 40 45 28 45 19 C45 11.5 39.5 6 32 6 Z" />
                        <circle class="pq-stroke" cx="32" cy="19" r="5" />
                      </>
                    )}
                    {p.icon === 'chart' && (
                      <>
                        <rect class="pq-stroke" x="8" y="38" width="6" height="14" />
                        <rect class="pq-stroke" x="18" y="29" width="6" height="23" />
                        <rect class="pq-fill pq-stroke" x="28" y="16" width="6" height="36" />
                        <circle class="pq-fill pq-stroke" cx="43" cy="38" r="9" />
                        <path class="pq-stroke pq-thick" d="M49.5 44.5 L57 52" />
                      </>
                    )}
                    {p.icon === 'ai' && (
                      <>
                        <rect class="pq-fill pq-stroke" x="16" y="16" width="32" height="32" rx="6" />
                        <path class="pq-stroke" d="M24 8 V16 M32 8 V16 M40 8 V16 M24 48 V56 M32 48 V56 M40 48 V56 M8 24 H16 M8 32 H16 M8 40 H16 M48 24 H56 M48 32 H56 M48 40 H56" />
                        <text class="pq-ia" x="32" y="38.5" text-anchor="middle">IA</text>
                      </>
                    )}
                    {p.icon === 'monitor' && (
                      <>
                        <rect class="pq-fill pq-stroke" x="6" y="10" width="52" height="34" rx="3" />
                        <path class="pq-stroke" d="M28 44 V52 M36 44 V52 M22 53 H42" />
                        <path class="pq-accent" d="M13 36 L22 28 L29 32 L38 22 L45 18" />
                        <circle class="pq-stroke" cx="49" cy="17" r="4" />
                      </>
                    )}
                  </svg>
                </span>
                <span class="pq-divider" aria-hidden="true"></span>
                <h3>{p.titulo[0]}<br />{p.titulo[1]}</h3>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .porque {
    padding: 110px 0 130px;
    background: rgba(255, 248, 234, 0.72);
    position: relative;
    overflow: hidden;
  }
  .wrap { position: relative; z-index: 1; }

  /* ---- HEAD ---- */
  .porque-head {
    max-width: 720px;
    margin: 0 auto 64px;
    text-align: center;
  }
  .porque-eyebrow {
    display: inline-flex;
    align-items: center;
    margin-bottom: 24px;
  }
  .porque-head h2 {
    margin: 0;
  }
  .porque-head p {
    margin: 22px auto 0;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(21, 27, 32, 0.78);
    max-width: 580px;
    /* Gradient cyan sutil → blanco + barra cyan-ink (oscuro) gruesa
       ARRIBA como acento distintivo del bloque. */
    padding: 22px 26px;
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.05), #fff);
    border: 1px solid rgba(97, 225, 230, 0.28);
    border-top: 4px solid var(--cyan-ink);
    border-radius: 4px 4px 20px 20px;
    box-shadow: 0 10px 28px rgba(4, 69, 89, 0.06);
    text-align: left;
  }
  .porque-head strong {
    color: var(--navy);
    font-weight: 700;
  }
  /* Reveal escalonado del header */
  .porque [data-vh] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .porque [data-vh].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============ DIAGRAMA ============
     Escritorio: [grupo A] → [caja Troppo] → [grupo B] en una fila.
     Cada grupo: etiqueta (píldora) + llave conectora + 2 tarjetas. */
  .pq-diagram {
    --pq-card-h: 250px;
    display: grid;
    grid-template-columns: minmax(0, 2fr) 56px minmax(0, 1.25fr) 56px minmax(0, 2fr);
    align-items: end;
    max-width: 1140px;
    margin: 0 auto;
  }

  /* Grupo: píldora + llave + tarjetas */
  .pq-group {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pq-pill {
    /* Borde degradado navy → cyan sobre fondo blanco */
    border: 2px solid transparent;
    background:
      linear-gradient(180deg, #fff, #f3fbfb) padding-box,
      linear-gradient(160deg, var(--navy) 0%, var(--cyan) 70%) border-box;
    border-radius: 100px;
    padding: 10px 26px;
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 600;
    color: var(--navy);
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(4, 69, 89, 0.08);
  }
  .pq-bracket {
    display: block;
    width: 100%;
    height: 40px;
    overflow: visible;
  }
  .pq-bracket path {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .pq-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7%;
    width: 100%;
  }

  /* Tarjeta: número, icono, divisor, título */
  .pq-card {
    height: var(--pq-card-h);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px 12px 18px;
    text-align: center;
    /* Casi blanca con un tinte cyan arriba, como en la referencia */
    background: linear-gradient(180deg, rgba(232, 249, 249, 0.96), rgba(255, 255, 255, 0.96));
    border: 1px solid rgba(97, 225, 230, 0.35);
    border-radius: 22px;
    box-shadow: 0 10px 28px rgba(4, 69, 89, 0.07);
  }
  .pq-num {
    font-family: var(--font-title);
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
    color: var(--navy);
  }
  .pq-icon {
    position: relative;
    width: 68px;
    height: 68px;
    margin: 10px 0 12px;
  }
  /* Halo cyan suave detrás del icono */
  .pq-icon::before {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(97, 225, 230, 0.28), transparent 68%);
  }
  .pq-icon svg {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .pq-stroke {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pq-thick { stroke-width: 4; }
  .pq-thin {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 1.2;
  }
  .pq-fill { fill: rgba(97, 225, 230, 0.32); }
  .pq-pin { fill: #fff; }
  .pq-accent {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pq-ia {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    fill: var(--navy);
  }
  .pq-divider {
    width: 80%;
    height: 1px;
    background: rgba(97, 225, 230, 0.55);
    margin-bottom: 12px;
  }
  .pq-card h3 {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--navy);
    margin: 0;
  }

  /* Flechas entre bloques */
  .pq-arrow {
    height: var(--pq-card-h);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pq-arrow svg {
    width: 36px;
    height: 16px;
  }
  .pq-arrow path {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Caja central Troppo */
  .pq-center {
    height: calc(var(--pq-card-h) + 24px);
    margin-bottom: -12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px 22px;
    text-align: center;
    border: 2px solid transparent;
    background:
      linear-gradient(160deg, #fff, rgba(240, 251, 251, 0.96)) padding-box,
      linear-gradient(160deg, var(--navy) 0%, var(--cyan) 65%) border-box;
    border-radius: 26px;
    box-shadow: 0 14px 34px rgba(4, 69, 89, 0.10);
  }
  /* Logo Troppo azul (wordmark + brújula, aspect ~4.92) */
  .pq-brand {
    display: block;
    width: min(190px, 100%);
    height: auto;
  }
  .pq-center-line {
    width: 85%;
    height: 3px;
    border-radius: 2px;
    background: var(--cyan);
    margin: 16px 0 14px;
  }
  .pq-center p {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--navy);
    margin: 0;
  }

  /* Reveal on scroll (grupos y caja central) */
  .pq-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pq-reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Pantallas medianas: el diagrama se apila en vertical --- */
  @media (max-width: 1060px) {
    .pq-diagram {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
      justify-items: stretch;
      row-gap: 10px;
    }
    .pq-arrow { height: 44px; }
    .pq-arrow svg { transform: rotate(90deg); }
    .pq-center {
      height: auto;
      margin: 0;
      padding: 26px 22px;
    }
  }
  @media (max-width: 860px) {
    .pq-diagram { --pq-card-h: 220px; }
    .pq-pill { font-size: 16px; padding: 9px 20px; }
    .pq-card h3 { font-size: 15px; }
    .pq-num { font-size: 22px; }
    .pq-icon { width: 56px; height: 56px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pq-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { revealOnScroll } from '../scripts/reveal';
  // Reveal escalonado — se re-anima cada vez que los steps vuelven al
  // viewport. Trackeamos el timeout por elemento para cancelarlo si
  // salen antes de completar el reveal.
  const steps = document.querySelectorAll<HTMLElement>('.porque .pq-reveal');
  if (steps.length) {
    // Histéresis: salida 48px sobre la pantalla (> 24px del translateY
    // oculto) para que la tarjeta no vuelva a entrar al ocultarse.
    revealOnScroll(steps, {
      enterMargin: '0px 0px -15% 0px',
      threshold: 0.2,
      exitMargin: '48px 0px -15% 0px',
      staggerMs: 120,
    });
  }

  // Reveal escalonado del header (eyebrow → h2 → párrafo). Re-animatable.
  const porqueHeadItems = Array.from(
    document.querySelectorAll<HTMLElement>('.porque [data-vh]'),
  );
  if (porqueHeadItems.length) {
    porqueHeadItems.forEach((el, i) => {
      el.style.transitionDelay = `${i * 140}ms`;
    });
    // Histéresis: salida 28px sobre la pantalla (> 14px del translateY
    // oculto) para que el encabezado no vuelva a entrar al ocultarse.
    revealOnScroll(porqueHeadItems, {
      enterMargin: '0px 0px -10% 0px',
      threshold: 0.2,
      exitMargin: '28px 0px -10% 0px',
    });
  }
</script>
