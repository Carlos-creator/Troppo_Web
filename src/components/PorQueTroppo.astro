---
// Sección 4 rúbrica — "Por qué Troppo es mejor que sus competidores"
//
// Concepto visual: el ciclo completo Simular → Analizar → Optimizar con IA
// → Monitorear en tiempo real, con marcador de dónde las herramientas
// tradicionales se detienen (después del paso 2), y arrow de loop-back
// mostrando que Troppo cierra el círculo.

const pasos = [
  {
    num: '01',
    titulo: 'Probar',
    desc: 'Reconstruimos la red vial en el gemelo digital y evaluamos escenarios sin tocar la calle real.',
    troppoOnly: false,
    icon: 'test',
  },
  {
    num: '02',
    titulo: 'Analizar',
    desc: 'Comparamos los resultados de cada ejecución: espera, flujo, emisiones, distribución de vehículos.',
    troppoOnly: false,
    icon: 'chart',
  },
  {
    num: '03',
    titulo: 'Optimizar con IA',
    desc: 'Con el aprendizaje por refuerzo generamos nuevas políticas de semaforización que superan a las reglas fijas.',
    troppoOnly: true,
    icon: 'ai',
  },
  {
    num: '04',
    titulo: 'Monitorear en vivo',
    desc: 'Al desplegar en terreno, seguimos observando la red y retroalimentando el modelo.',
    troppoOnly: true,
    icon: 'radar',
  },
];
---

<section class="porque" id="porque-troppo">
  <div class="wrap">
    <header class="porque-head">
      <div class="porque-eyebrow" data-vh>
        <span class="eyebrow-mark" aria-hidden="true"></span>
        ¿POR QUÉ TROPPO?
      </div>
      <h2 data-vh>Donde los demás terminan, <em>nosotros empezamos.</em></h2>
      <p data-vh>
        Otras herramientas se detienen en simular y analizar. Troppo conecta el
        proceso completo en una sola plataforma: probar, analizar,
        <strong>optimizar con IA</strong> y <strong>monitorear en tiempo real</strong>.
      </p>
    </header>

    <div class="porque-flow" role="list">
      {/* Etiquetas de grupo — sólo visibles en desktop. En mobile se
          usan los badges per-card + el label absoluto sobre la flecha. */}
      <div class="pq-group-label pq-group-regular" aria-hidden="true">
        <span class="pq-group-line"></span>
        <span class="pq-group-chip">Otras herramientas se detienen aquí</span>
        <span class="pq-group-line"></span>
      </div>
      <div class="pq-group-label pq-group-troppo" aria-hidden="true">
        <span class="pq-group-line"></span>
        <span class="pq-group-chip">Sólo Troppo</span>
        <span class="pq-group-line"></span>
      </div>
      {
        pasos.map((p, i) => (
          <>
            <article class={`pq-step pq-step--${p.icon} ${p.troppoOnly ? 'is-troppo' : ''}`} data-reveal data-c={i} role="listitem">
              {/* Overlay animado temático que cubre toda la card a baja opacidad */}
              <svg
                class={`pq-card-fx pq-card-fx--${p.icon}`}
                viewBox="0 0 100 100"
                preserveAspectRatio={p.icon === 'radar' ? 'xMidYMid slice' : 'none'}
                aria-hidden="true"
              >
                {p.icon === 'test' && (
                  <>
                    <circle class="pq-fx-probe" cx="15" cy="18" r="2.6" fill="currentColor" />
                    <circle class="pq-fx-probe" cx="85" cy="14" r="2.6" fill="currentColor" />
                    <circle class="pq-fx-probe" cx="30" cy="78" r="2.6" fill="currentColor" />
                    <circle class="pq-fx-probe" cx="72" cy="62" r="2.6" fill="currentColor" />
                    <circle class="pq-fx-probe" cx="50" cy="35" r="2.6" fill="currentColor" />
                    <circle class="pq-fx-probe" cx="12" cy="55" r="2.6" fill="currentColor" />
                    <circle class="pq-fx-probe" cx="88" cy="86" r="2.6" fill="currentColor" />
                    <circle class="pq-fx-probe" cx="55" cy="92" r="2.6" fill="currentColor" />
                  </>
                )}
                {p.icon === 'chart' && (
                  <>
                    <circle class="pq-fx-dp" cx="20" cy="40" r="1.8" fill="currentColor" />
                    <circle class="pq-fx-dp" cx="45" cy="70" r="1.8" fill="currentColor" />
                    <circle class="pq-fx-dp" cx="70" cy="30" r="1.8" fill="currentColor" />
                    <circle class="pq-fx-dp" cx="88" cy="58" r="1.8" fill="currentColor" />
                    <rect class="pq-fx-scan" x="0" y="0" width="2.4" height="100" fill="currentColor" />
                  </>
                )}
                {p.icon === 'ai' && (
                  <>
                    <line x1="15" y1="20" x2="50" y2="50" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
                    <line x1="82" y1="22" x2="50" y2="50" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
                    <line x1="20" y1="80" x2="50" y2="50" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
                    <line x1="80" y1="80" x2="50" y2="50" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
                    <circle cx="15" cy="20" r="2" fill="currentColor" opacity="0.75" />
                    <circle cx="82" cy="22" r="2" fill="currentColor" opacity="0.75" />
                    <circle cx="20" cy="80" r="2" fill="currentColor" opacity="0.75" />
                    <circle cx="80" cy="80" r="2" fill="currentColor" opacity="0.75" />
                    <circle class="pq-fx-brain" cx="50" cy="50" r="3" fill="currentColor" />
                    <circle class="pq-fx-syn pq-fx-syn-1" cx="15" cy="20" r="1.4" fill="currentColor" />
                    <circle class="pq-fx-syn pq-fx-syn-2" cx="82" cy="22" r="1.4" fill="currentColor" />
                    <circle class="pq-fx-syn pq-fx-syn-3" cx="20" cy="80" r="1.4" fill="currentColor" />
                    <circle class="pq-fx-syn pq-fx-syn-4" cx="80" cy="80" r="1.4" fill="currentColor" />
                  </>
                )}
                {p.icon === 'radar' && (
                  <>
                    <circle class="pq-fx-sonar pq-fx-sonar-1" cx="50" cy="50" r="8" fill="none" stroke="currentColor" stroke-width="0.55" />
                    <circle class="pq-fx-sonar pq-fx-sonar-2" cx="50" cy="50" r="8" fill="none" stroke="currentColor" stroke-width="0.55" />
                    <circle class="pq-fx-sonar pq-fx-sonar-3" cx="50" cy="50" r="8" fill="none" stroke="currentColor" stroke-width="0.55" />
                    <g class="pq-fx-arm">
                      <line x1="50" y1="50" x2="88" y2="50" stroke="currentColor" stroke-width="1" />
                      <circle cx="88" cy="50" r="1.6" fill="currentColor" />
                    </g>
                  </>
                )}
              </svg>
              <div class="pq-step-head">
                <span class="pq-num">{p.num}</span>
                {p.troppoOnly && <span class="pq-badge">Sólo Troppo</span>}
              </div>
              <div class="pq-icon-wrap">
                <svg class="pq-icon" viewBox="0 0 32 32" aria-hidden="true">
                  {p.icon === 'test' && (
                    <>
                      <rect x="6" y="6" width="20" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
                      <path d="M6 12 L26 12 M6 20 L26 20 M12 6 L12 26 M20 6 L20 26" stroke="currentColor" stroke-width="1" opacity="0.35" />
                      {/* Dots ancla + probe pulses en distintas intersecciones */}
                      <circle cx="12" cy="12" r="1.4" fill="currentColor" opacity="0.5" />
                      <circle cx="20" cy="20" r="1.4" fill="currentColor" opacity="0.5" />
                      <circle class="pq-probe pq-probe-1" cx="20" cy="12" r="2.2" fill="currentColor" />
                      <circle class="pq-probe pq-probe-2" cx="12" cy="20" r="2.2" fill="currentColor" />
                      <circle class="pq-probe pq-probe-3" cx="16" cy="16" r="2.2" fill="currentColor" />
                    </>
                  )}
                  {p.icon === 'chart' && (
                    <>
                      <path d="M5 27 L5 6 M5 27 L27 27" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                      <path d="M8 22 L14 17 L19 20 L24 11" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                      {/* Scan vertical + data points pulsantes en secuencia */}
                      <rect class="pq-scan" x="5" y="6" width="0.9" height="21" fill="currentColor" opacity="0.75" rx="0.4" />
                      <circle class="pq-dp pq-dp-1" cx="14" cy="17" r="1.6" fill="currentColor" />
                      <circle class="pq-dp pq-dp-2" cx="19" cy="20" r="1.6" fill="currentColor" />
                      <circle class="pq-dp pq-dp-3" cx="24" cy="11" r="1.6" fill="currentColor" />
                    </>
                  )}
                  {p.icon === 'ai' && (
                    <>
                      <circle cx="6" cy="10" r="2.2" fill="currentColor" />
                      <circle cx="26" cy="10" r="2.2" fill="currentColor" />
                      <circle cx="7" cy="23" r="2.2" fill="currentColor" />
                      <circle cx="25" cy="23" r="2.2" fill="currentColor" />
                      <line x1="6" y1="10" x2="16" y2="16" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                      <line x1="26" y1="10" x2="16" y2="16" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                      <line x1="7" y1="23" x2="16" y2="16" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                      <line x1="25" y1="23" x2="16" y2="16" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                      {/* Núcleo pulsante + sinapsis viajando desde cada nodo hacia el centro */}
                      <circle class="pq-brain" cx="16" cy="16" r="3.2" fill="currentColor" />
                      <circle class="pq-syn pq-syn-1" cx="6" cy="10" r="1.2" fill="currentColor" />
                      <circle class="pq-syn pq-syn-2" cx="26" cy="10" r="1.2" fill="currentColor" />
                      <circle class="pq-syn pq-syn-3" cx="7" cy="23" r="1.2" fill="currentColor" />
                      <circle class="pq-syn pq-syn-4" cx="25" cy="23" r="1.2" fill="currentColor" />
                    </>
                  )}
                  {p.icon === 'radar' && (
                    <>
                      <circle cx="16" cy="16" r="10" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
                      <circle cx="16" cy="16" r="6" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5" />
                      <circle cx="16" cy="16" r="2.4" fill="currentColor" />
                      {/* Sonar rings expandiéndose desde el centro */}
                      <circle class="pq-sonar pq-sonar-1" cx="16" cy="16" r="4" fill="none" stroke="currentColor" stroke-width="0.9" vector-effect="non-scaling-stroke" />
                      <circle class="pq-sonar pq-sonar-2" cx="16" cy="16" r="4" fill="none" stroke="currentColor" stroke-width="0.9" vector-effect="non-scaling-stroke" />
                      {/* Brazo del radar rotando alrededor del centro */}
                      <g class="pq-arm">
                        <line x1="16" y1="16" x2="24" y2="10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <circle cx="24" cy="10" r="1.6" fill="currentColor" />
                      </g>
                    </>
                  )}
                </svg>
              </div>
              <h3>{p.titulo}</h3>
              <p>{p.desc}</p>
            </article>

            {i < pasos.length - 1 && (
              <div class={`pq-arrow ${i === 1 ? 'is-limit' : ''}`} data-a={i} aria-hidden="true">
                <svg viewBox="0 0 32 12" width="28" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 6 L26 6" />
                  <path d="M20 2 L26 6 L20 10" />
                </svg>
                {i === 1 && (
                  <span class="pq-arrow-label">Otras herramientas se detienen aquí</span>
                )}
              </div>
            )}
          </>
        ))
      }
    </div>

    <!-- Arrow de loop-back: cierra el círculo Monitorear → Probar -->
    <div class="pq-loop" aria-hidden="true">
      <svg viewBox="0 0 800 60" preserveAspectRatio="none">
        <path
          d="M 780 8 C 780 45, 620 55, 400 55 C 180 55, 20 45, 20 8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="6 5"
        />
        <path d="M 24 14 L 20 8 L 26 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="pq-loop-label">Cerramos el circuito — cada ejecución retroalimenta al modelo</span>
    </div>

    <!-- Highlight final — parafraseo del rúbrica -->
    <div class="pq-highlight">
      <p>
        <strong>Troppo</strong> no sólo permite entender qué está ocurriendo:
        también permite probar qué <em>podría ocurrir</em> y tomar mejores
        decisiones antes de implementarlas en la realidad.
      </p>
    </div>
  </div>
</section>

<style>
  .porque {
    padding: 110px 0 130px;
    background: rgba(255, 248, 234, 0.72);
    position: relative;
    overflow: hidden;
  }
  .wrap { position: relative; z-index: 1; }

  /* ---- HEAD ---- */
  .porque-head {
    max-width: 720px;
    margin: 0 auto 64px;
    text-align: center;
  }
  .porque-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--cyan-ink);
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .porque-eyebrow .eyebrow-mark {
    display: inline-block;
    width: 0;
    height: 2px;
    background: var(--cyan-ink);
    box-shadow: 0 0 8px rgba(10, 107, 118, 0.45);
    border-radius: 2px;
    transition: width 900ms cubic-bezier(0.16, 1, 0.3, 1) 100ms;
  }
  .porque-eyebrow.revealed .eyebrow-mark { width: 42px; }
  .porque-head h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 44px;
    line-height: 1.15;
    color: var(--navy);
    margin: 0;
    letter-spacing: -0.4px;
  }
  .porque-head h2 em {
    font-style: italic;
    color: var(--cyan-ink);
  }
  .porque-head p {
    margin: 22px auto 0;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(21, 27, 32, 0.78);
    max-width: 580px;
    /* Mismo tratamiento que las cards de Misión / Visión:
       gradient cyan sutil → blanco, border cyan, rounded, box-shadow. */
    padding: 22px 26px;
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.05), #fff);
    border: 1px solid rgba(97, 225, 230, 0.28);
    border-radius: 20px;
    box-shadow: 0 10px 28px rgba(4, 69, 89, 0.06);
    text-align: left;
  }
  .porque-head strong {
    color: var(--navy);
    font-weight: 700;
  }
  /* Reveal escalonado del header */
  .porque [data-vh] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .porque [data-vh].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---- FLOW (4 pasos + 3 arrows entre ellos) ---- */
  .porque-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: 0;
    align-items: stretch;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* --- Etiquetas de grupo (DESKTOP) ---
     'Otras herramientas se detienen aquí' arriba de pasos 01–02.
     'Sólo Troppo' arriba de pasos 03–04.
     En mobile quedan ocultas — se usan los badges per-card + label
     de la flecha límite (comportamiento previo). */
  .pq-group-label { display: none; }
  @media (min-width: 961px) {
    .porque-flow {
      grid-template-rows: auto 1fr;
      row-gap: 26px;
    }
    .pq-group-label {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 0 8px;
      grid-row: 1;
    }
    .pq-group-regular {
      grid-column: 1 / 4;
      color: rgba(220, 90, 80, 0.85);
    }
    .pq-group-troppo {
      grid-column: 5 / 8;
      color: var(--cyan-ink);
    }
    .pq-group-line {
      flex: 1;
      height: 1px;
      background: currentColor;
      opacity: 0.4;
    }
    .pq-group-chip {
      padding: 6px 14px;
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      border: 1px solid currentColor;
      border-radius: 100px;
      background: rgba(255, 255, 255, 0.92);
      white-space: nowrap;
    }
    /* Colocación explícita de cards y arrows en row 2 */
    .porque-flow [data-c="0"] { grid-column: 1; grid-row: 2; }
    .porque-flow [data-a="0"] { grid-column: 2; grid-row: 2; }
    .porque-flow [data-c="1"] { grid-column: 3; grid-row: 2; }
    .porque-flow [data-a="1"] { grid-column: 4; grid-row: 2; }
    .porque-flow [data-c="2"] { grid-column: 5; grid-row: 2; }
    .porque-flow [data-a="2"] { grid-column: 6; grid-row: 2; }
    .porque-flow [data-c="3"] { grid-column: 7; grid-row: 2; }
    /* En desktop escondemos los indicadores per-card — la información
       vive en las etiquetas de grupo arriba. */
    .porque-flow .pq-badge { display: none; }
    .porque-flow .pq-arrow-label { display: none; }
    .pq-step-head { min-height: 0; }
  }

  /* Card de paso — regular (Probar / Analizar).
     Gradient cyan sutil → blanco (mismo lenguaje que las cards de
     Misión / Visión) para que se sientan sólidas y legibles. */
  .pq-step {
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.06), #fff);
    border: 1px solid rgba(4, 69, 89, 0.14);
    border-radius: 16px;
    padding: 26px 24px 28px;
    display: flex;
    flex-direction: column;
    text-align: center;
    color: var(--navy);
    transition:
      transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 350ms ease,
      border-color 350ms ease,
      background 350ms ease;
    position: relative;
    overflow: hidden;
  }
  /* Contenido por encima del overlay animado */
  .pq-step-head,
  .pq-step .pq-icon-wrap,
  .pq-step h3,
  .pq-step p {
    position: relative;
    z-index: 1;
  }
  .pq-step:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(4, 69, 89, 0.14);
    border-color: rgba(4, 69, 89, 0.28);
  }

  /* Estilos especiales para pasos "Sólo Troppo" — fondo navy oscuro
     (mismo tono que el panel 'Flujo Principal' de FlujoParalelo)
     con border y glow lime que los hace destacar. */
  .pq-step.is-troppo {
    /* Gradient navy oscuro: más denso arriba, respira hacia abajo. */
    background: linear-gradient(180deg, rgba(4, 69, 89, 0.92), rgba(4, 69, 89, 0.66));
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-color: rgba(209, 235, 120, 0.55);
    box-shadow:
      0 0 0 1px rgba(209, 235, 120, 0.32),
      0 6px 22px rgba(209, 235, 120, 0.18);
    color: var(--cream);
  }
  .pq-step.is-troppo:hover {
    background: linear-gradient(180deg, rgba(4, 69, 89, 0.96), rgba(4, 69, 89, 0.78));
    border-color: var(--lime);
    box-shadow:
      0 0 0 2px rgba(209, 235, 120, 0.45),
      0 14px 34px rgba(209, 235, 120, 0.32);
  }
  /* Adaptar los textos internos al fondo navy oscuro */
  .pq-step.is-troppo .pq-num { color: var(--cyan); }
  .pq-step.is-troppo h3 { color: var(--cream); }
  .pq-step.is-troppo p { color: rgba(255, 248, 234, 0.82); }

  .pq-step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
    min-height: 24px;
  }
  .pq-num {
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--cyan-ink);
    font-weight: 600;
    line-height: 1;
  }
  .pq-badge {
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 4px 8px;
    background: var(--cyan);
    color: var(--navy-deep);
    border-radius: 100px;
    text-transform: uppercase;
  }

  /* Icono central en su chip */
  .pq-icon-wrap {
    width: 60px;
    height: 60px;
    margin: 4px auto 18px;
    border-radius: 14px;
    background: rgba(97, 225, 230, 0.12);
    border: 1px solid rgba(97, 225, 230, 0.28);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
  }
  .pq-step.is-troppo .pq-icon-wrap {
    background: rgba(97, 225, 230, 0.16);
    border-color: rgba(97, 225, 230, 0.45);
    color: var(--cyan);
  }
  .pq-icon { width: 32px; height: 32px; }

  .pq-step h3 {
    font-family: var(--font-title);
    font-size: 17px;
    font-weight: 700;
    color: var(--navy);
    margin: 0 0 8px;
  }
  .pq-step p {
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(21, 27, 32, 0.72);
    margin: 0;
  }

  /* Arrows entre pasos */
  .pq-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
    color: rgba(4, 69, 89, 0.35);
    position: relative;
  }
  .pq-arrow.is-limit {
    color: rgba(220, 90, 80, 0.7);
  }
  .pq-arrow-label {
    position: absolute;
    top: -32px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: rgba(220, 90, 80, 0.85);
    text-transform: uppercase;
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(220, 90, 80, 0.35);
    border-radius: 100px;
  }
  .pq-arrow-label::before {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 8px;
    height: 8px;
    background: rgba(255, 255, 255, 0.9);
    border-right: 1px solid rgba(220, 90, 80, 0.35);
    border-bottom: 1px solid rgba(220, 90, 80, 0.35);
  }

  /* Loop-back arrow debajo del flow */
  .pq-loop {
    max-width: 1100px;
    margin: 20px auto 0;
    height: 60px;
    /* Cyan oscuro (--cyan-ink) para que se lea sobre el fondo cream
       — el cyan brillante quedaba muy tenue. */
    color: rgba(10, 107, 118, 0.6);
    position: relative;
    text-align: center;
  }
  .pq-loop svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .pq-loop-label {
    position: absolute;
    top: 60%;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.6px;
    color: rgba(4, 69, 89, 0.6);
    text-transform: uppercase;
    background: rgba(255, 248, 234, 0.72);
    padding: 3px 12px;
    border-radius: 100px;
  }

  /* Highlight final */
  .pq-highlight {
    max-width: 780px;
    margin: 68px auto 0;
    padding: 30px 40px;
    /* Mismo tratamiento que las cards de Misión / Visión y el resto de
       bloques descriptivos: gradient cyan sutil → blanco, border cyan
       alrededor, esquinas redondeadas, sombra suave. */
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.05), #fff);
    border: 1px solid rgba(97, 225, 230, 0.28);
    border-radius: 20px;
    box-shadow: 0 10px 28px rgba(4, 69, 89, 0.06);
    text-align: left;
  }
  .pq-highlight p {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.55;
    color: var(--navy);
    margin: 0;
    font-weight: 500;
  }
  .pq-highlight strong {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--navy);
  }
  .pq-highlight em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--cyan-ink);
    font-weight: 500;
  }

  /* Reveal on scroll */
  .pq-step {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 350ms ease,
      border-color 350ms ease,
      background 350ms ease;
  }
  .pq-step.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============ ANIMACIONES POR ICONO ============
     Cada card tiene una animación temática que refuerza su título.
     Uso CSS animations (respetan prefers-reduced-motion) sobre elementos
     SVG con transform-box para centrar el origen correctamente. */

  /* --- 1. PROBAR — dots que aparecen y desaparecen como toques de prueba --- */
  @keyframes pq-probe-pulse {
    0%, 100% { transform: scale(0); opacity: 0; }
    35%      { transform: scale(1); opacity: 1; }
    75%      { transform: scale(1.4); opacity: 0.25; }
  }
  .pq-probe {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-probe-pulse 2.1s ease-out infinite;
  }
  .pq-probe-2 { animation-delay: 0.7s; }
  .pq-probe-3 { animation-delay: 1.4s; }

  /* --- 2. ANALIZAR — scan vertical + data points pulsantes en secuencia --- */
  @keyframes pq-scan-move {
    0%   { transform: translateX(0); opacity: 0.75; }
    88%  { transform: translateX(19px); opacity: 0.75; }
    100% { transform: translateX(19px); opacity: 0; }
  }
  .pq-scan {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-scan-move 2.4s ease-in-out infinite;
  }
  @keyframes pq-datapoint {
    0%, 55%, 100% { transform: scale(1); }
    65%, 80%      { transform: scale(1.55); }
  }
  .pq-dp {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-datapoint 2.4s ease-in-out infinite;
  }
  .pq-dp-2 { animation-delay: 0.5s; }
  .pq-dp-3 { animation-delay: 1.0s; }

  /* --- 3. OPTIMIZAR CON IA — núcleo pulsante + sinapsis fluyendo al centro --- */
  @keyframes pq-brain-pulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.22); }
  }
  .pq-brain {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-brain-pulse 1.6s ease-in-out infinite;
  }
  .pq-syn {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Deltas de cada nodo esquina hacia (16,16):
     (6,10)  → +10,+6    (26,10) → -10,+6
     (7,23)  → +9,-7     (25,23) → -9,-7 */
  @keyframes pq-syn-1 {
    0%   { transform: translate(0,0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(10px, 6px); opacity: 0; }
  }
  @keyframes pq-syn-2 {
    0%   { transform: translate(0,0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(-10px, 6px); opacity: 0; }
  }
  @keyframes pq-syn-3 {
    0%   { transform: translate(0,0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(9px, -7px); opacity: 0; }
  }
  @keyframes pq-syn-4 {
    0%   { transform: translate(0,0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(-9px, -7px); opacity: 0; }
  }
  .pq-syn-1 { animation: pq-syn-1 1.8s linear infinite 0s; }
  .pq-syn-2 { animation: pq-syn-2 1.8s linear infinite 0.45s; }
  .pq-syn-3 { animation: pq-syn-3 1.8s linear infinite 0.9s; }
  .pq-syn-4 { animation: pq-syn-4 1.8s linear infinite 1.35s; }

  /* --- 4. MONITOREAR EN VIVO — radar arm rotando + sonar pulses --- */
  @keyframes pq-arm-rot {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  .pq-arm {
    transform-box: view-box;
    transform-origin: 16px 16px;
    animation: pq-arm-rot 3.2s linear infinite;
  }
  @keyframes pq-sonar-pulse {
    0%   { transform: scale(0.35); opacity: 0.9; }
    100% { transform: scale(2.1); opacity: 0; }
  }
  .pq-sonar {
    transform-box: view-box;
    transform-origin: 16px 16px;
    animation: pq-sonar-pulse 2s ease-out infinite;
  }
  .pq-sonar-2 { animation-delay: 1s; }

  /* ============ EFECTO A NIVEL DE CARD COMPLETA ============
     El mismo tema del icono pero cubriendo toda la card a baja opacidad.
     El SVG cubre el 100% del card con viewBox 0 0 100 100 (radar mantiene
     aspect ratio para que los círculos sonar sigan siendo redondos, el
     resto usa preserveAspectRatio="none"). */
  .pq-card-fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--navy);
    opacity: 0.10;
    z-index: 0;
  }
  .pq-step.is-troppo .pq-card-fx {
    color: var(--navy-deep);
    opacity: 0.14;
  }

  /* --- Card-level PROBAR — 8 probes dispersos --- */
  @keyframes pq-fx-probe {
    0%, 100% { transform: scale(0); opacity: 0; }
    40%      { transform: scale(1); opacity: 1; }
    75%      { transform: scale(1.7); opacity: 0.2; }
  }
  .pq-fx-probe {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-fx-probe 2.8s ease-out infinite;
  }
  .pq-fx-probe:nth-of-type(2) { animation-delay: 0.35s; }
  .pq-fx-probe:nth-of-type(3) { animation-delay: 0.7s; }
  .pq-fx-probe:nth-of-type(4) { animation-delay: 1.05s; }
  .pq-fx-probe:nth-of-type(5) { animation-delay: 1.4s; }
  .pq-fx-probe:nth-of-type(6) { animation-delay: 1.75s; }
  .pq-fx-probe:nth-of-type(7) { animation-delay: 2.1s; }
  .pq-fx-probe:nth-of-type(8) { animation-delay: 2.45s; }

  /* --- Card-level ANALIZAR — scan bar full-height + 4 data points --- */
  @keyframes pq-fx-scan {
    0%   { transform: translateX(0); opacity: 0; }
    10%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translateX(97px); opacity: 0; }
  }
  .pq-fx-scan {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-fx-scan 4s ease-in-out infinite;
  }
  @keyframes pq-fx-dp {
    0%, 55%, 100% { transform: scale(1); }
    65%, 80%      { transform: scale(1.7); }
  }
  .pq-fx-dp {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-fx-dp 4s ease-in-out infinite;
  }
  .pq-fx-dp:nth-of-type(2) { animation-delay: 0.6s; }
  .pq-fx-dp:nth-of-type(3) { animation-delay: 1.2s; }
  .pq-fx-dp:nth-of-type(4) { animation-delay: 1.8s; }

  /* --- Card-level OPTIMIZAR CON IA — brain pulsante + 4 sinapsis fluyendo --- */
  @keyframes pq-fx-brain {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.35); }
  }
  .pq-fx-brain {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-fx-brain 2.2s ease-in-out infinite;
  }
  .pq-fx-syn {
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes pq-fx-syn-1 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(35px, 30px); opacity: 0; }
  }
  @keyframes pq-fx-syn-2 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(-32px, 28px); opacity: 0; }
  }
  @keyframes pq-fx-syn-3 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(30px, -30px); opacity: 0; }
  }
  @keyframes pq-fx-syn-4 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(-30px, -30px); opacity: 0; }
  }
  .pq-fx-syn-1 { animation: pq-fx-syn-1 2.2s linear infinite 0s; }
  .pq-fx-syn-2 { animation: pq-fx-syn-2 2.2s linear infinite 0.55s; }
  .pq-fx-syn-3 { animation: pq-fx-syn-3 2.2s linear infinite 1.1s; }
  .pq-fx-syn-4 { animation: pq-fx-syn-4 2.2s linear infinite 1.65s; }

  /* --- Card-level MONITOREAR — sonar rings + arm rotating full card --- */
  @keyframes pq-fx-arm-rot {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  .pq-fx-arm {
    transform-box: view-box;
    transform-origin: 50px 50px;
    animation: pq-fx-arm-rot 4s linear infinite;
  }
  @keyframes pq-fx-sonar {
    0%   { transform: scale(0.4); opacity: 0.9; }
    100% { transform: scale(2.6); opacity: 0; }
  }
  .pq-fx-sonar {
    transform-box: view-box;
    transform-origin: 50px 50px;
    animation: pq-fx-sonar 3s ease-out infinite;
  }
  .pq-fx-sonar-2 { animation-delay: 1s; }
  .pq-fx-sonar-3 { animation-delay: 2s; }

  /* --- MOBILE --- */
  @media (max-width: 960px) {
    .porque-flow {
      grid-template-columns: 1fr;
      gap: 16px;
      max-width: 480px;
    }
    /* Ya no rotamos el contenedor de la flecha entero: sólo el SVG.
       Así la etiqueta puede quedar centrada arriba sin salirse ni
       montarse sobre la card siguiente. */
    .pq-arrow {
      transform: none;
      flex-direction: column;
      gap: 6px;
      padding: 4px 0;
    }
    .pq-arrow svg {
      transform: rotate(90deg);
    }
    .pq-arrow-label {
      position: static;
      transform: none;
      top: auto;
      left: auto;
      white-space: normal;
      max-width: 260px;
      font-size: 9.5px;
      letter-spacing: 1px;
      text-align: center;
    }
    .pq-arrow-label::before { display: none; }
    .pq-loop { display: none; }
    .porque-head h2 { font-size: 30px; }
    .pq-highlight {
      padding: 24px 26px;
      margin-top: 48px;
    }
    .pq-highlight p { font-size: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pq-step {
      opacity: 1;
      transform: none;
      transition: none;
    }
    /* Detenemos todas las animaciones temáticas por icono */
    .pq-probe, .pq-scan, .pq-dp, .pq-brain, .pq-syn, .pq-arm, .pq-sonar {
      animation: none;
    }
    /* Ocultamos elementos que sólo tienen sentido animándose */
    .pq-probe, .pq-scan, .pq-syn, .pq-sonar { display: none; }
    /* El overlay a nivel de card completa se oculta por completo */
    .pq-card-fx { display: none; }
  }
</style>

<script>
  // Reveal escalonado — se re-anima cada vez que los steps vuelven al
  // viewport. Trackeamos el timeout por elemento para cancelarlo si
  // salen antes de completar el reveal.
  const steps = document.querySelectorAll<HTMLElement>('.porque .pq-step');
  if (steps.length) {
    const timers = new WeakMap<Element, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e, i) => {
          const prev = timers.get(e.target);
          if (prev) window.clearTimeout(prev);
          if (e.isIntersecting) {
            const t = window.setTimeout(() => {
              e.target.classList.add('revealed');
              timers.delete(e.target);
            }, i * 120);
            timers.set(e.target, t);
          } else {
            e.target.classList.remove('revealed');
          }
        });
      },
      { rootMargin: '0px 0px -15% 0px', threshold: 0.2 },
    );
    steps.forEach((s) => observer.observe(s));
  }

  // Reveal escalonado del header (eyebrow → h2 → párrafo). Re-animatable.
  const porqueHeadItems = Array.from(
    document.querySelectorAll<HTMLElement>('.porque [data-vh]'),
  );
  if (porqueHeadItems.length) {
    porqueHeadItems.forEach((el, i) => {
      el.style.transitionDelay = `${i * 140}ms`;
    });
    const porqueHeadObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('revealed');
          else e.target.classList.remove('revealed');
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.2 },
    );
    porqueHeadItems.forEach((el) => porqueHeadObs.observe(el));
  }
</script>
