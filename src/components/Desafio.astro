---
// Sección "Desafío" — único llamado a la acción de cierre, después de
// Contacto y antes de la sección de la Feria de Software.
// Fragmento editorial sobre el fondo navy: título + 4 tarjetas (número +
// título) con las capacidades de Troppo + invitación a conversar.

const capacidades = [
  {
    num: '01',
    titulo: 'Definir escenarios',
  },
  {
    num: '02',
    titulo: 'Simular alternativas',
  },
  {
    num: '03',
    titulo: 'Optimizar con IA',
  },
  {
    num: '04',
    titulo: 'Monitorear y operar',
  },
];
---

<section class="desafio sec-dark" id="desafio">
  <div class="wrap">
    <div class="desafio-inner">
      <span class="desafio-eyebrow sec-title">¿Tienes algún desafío de movilidad?</span>
      <h2 class="sec-subtitle">
        Hoy Troppo comienza en el puerto.
        <em>Mañana, en tu infraestructura.</em>
      </h2>
      <ul class="desafio-cards">
        {
          capacidades.map((c) => (
            <li class="desafio-card">
              <span class="desafio-card-num" aria-hidden="true">{c.num}</span>
              <h3>{c.titulo}</h3>
            </li>
          ))
        }
      </ul>
      <p class="desafio-invite">
        Cuéntanos tu desafío de movilidad y conversemos sobre cómo aplicar Troppo.
      </p>
    </div>
  </div>
</section>

<style>
  .desafio {
    /* Continúa el gradient del Hero: arriba matchea exacto la opacidad
       del final del Hero (0.55) para que la transición sea invisible,
       y hacia el bottom sube un poco (0.68) para preparar el navy-deep
       del port-band de Problem que viene después. */
    background: linear-gradient(
      180deg,
      rgba(4, 69, 89, 0.55) 0%,
      rgba(4, 69, 89, 0.55) 55%,
      rgba(4, 69, 89, 0.68) 100%
    );
    color: var(--cream);
    padding: 100px 0 110px;
    position: relative;
    overflow: hidden;
  }
  .wrap { position: relative; z-index: 1; }

  .desafio-inner {
    /* 1080px para que las 4 tarjetas quepan en una fila; el h2 y la
       invitación mantienen su propio max-width centrado. */
    max-width: 1080px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    /* Línea vertical cyan sutil arriba y abajo — estructura sin caja */
  }
  .desafio-inner::before,
  .desafio-inner::after {
    content: '';
    display: block;
    width: 1px;
    height: 44px;
    margin: 0 auto;
    background: linear-gradient(180deg, transparent, rgba(97, 225, 230, 0.55));
  }
  .desafio-inner::after {
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.55), transparent);
    margin-top: 32px;
  }
  .desafio-inner::before {
    margin-bottom: 32px;
  }

  .desafio-eyebrow {
    display: inline-block;
    margin-bottom: 22px;
  }

  h2 {
    margin: 0 auto;
    max-width: 680px;
  }

  p {
    margin: 26px auto 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: rgba(255, 248, 234, 0.72);
    max-width: 520px;
  }

  /* Reveal */
  .desafio-inner {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 900ms ease,
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .desafio-inner.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---- Tarjetas de capacidades ---- */
  .desafio-cards {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 40px 0 0;
    padding: 0;
    text-align: left;
  }
  .desafio-card {
    background: rgba(255, 248, 234, 0.04);
    border: 1px solid rgba(255, 248, 234, 0.14);
    border-radius: 16px;
    padding: 22px 20px 24px;
  }
  .desafio-card-num {
    display: block;
    font-family: var(--font-title);
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    color: var(--cyan);
    margin-bottom: 14px;
  }
  .desafio-card h3 {
    font-family: var(--font-title);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--cream);
    margin: 0;
  }
  .desafio-invite {
    margin-top: 34px;
    color: rgba(255, 248, 234, 0.9);
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .desafio-cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .desafio-cards { grid-template-columns: 1fr; gap: 12px; margin-top: 30px; }
  }

  @media (max-width: 860px) {
    .desafio { padding: 72px 0 80px; }
    .desafio-inner::before,
    .desafio-inner::after {
      height: 32px;
    }
    .desafio-inner::before { margin-bottom: 22px; }
    .desafio-inner::after  { margin-top: 22px; }
    p { font-size: 14.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .desafio-inner {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { revealOnScroll } from '../scripts/reveal';
  // Reveal on scroll — se re-anima cada vez que el bloque vuelve al viewport
  const inner = document.querySelector<HTMLElement>('.desafio-inner');
  if (inner) {
    // Histéresis: salida 40px sobre la pantalla (> 20px del translateY
    // oculto) para que el bloque no vuelva a entrar al ocultarse.
    revealOnScroll([inner], {
      enterMargin: '0px 0px -15% 0px',
      threshold: 0.2,
      exitMargin: '40px 0px -15% 0px',
    });
  }
</script>
