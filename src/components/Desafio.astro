---
// Sección "Desafío" — hook B2B entre Hero y Problem.
// Fragmento editorial (sin card, sin CTA) que respira sobre el fondo
// navy, funcionando como transición entre la intro y el problema.
---

<section class="desafio" id="desafio">
  <div class="wrap">
    <div class="desafio-inner">
      <span class="desafio-eyebrow">¿Tienes algún desafío de movilidad?</span>
      <h2>
        Hoy comenzamos en el puerto.
        <em>Mañana, en tu infraestructura.</em>
      </h2>
      <p>
        Tomas la decisión, nos llamas, elegimos el lugar y simulamos.
        Mañana lo llevamos a la realidad.
      </p>
    </div>
  </div>
</section>

<style>
  .desafio {
    /* Extiende la atmósfera del Hero — sin card, el texto flota sobre
       el navy como un fragmento tipográfico. */
    background: rgba(4, 69, 89, 0.55);
    color: var(--cream);
    padding: 100px 0 110px;
    position: relative;
    overflow: hidden;
  }
  .wrap { position: relative; z-index: 1; }

  .desafio-inner {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    /* Línea vertical cyan sutil arriba y abajo — estructura sin caja */
  }
  .desafio-inner::before,
  .desafio-inner::after {
    content: '';
    display: block;
    width: 1px;
    height: 44px;
    margin: 0 auto;
    background: linear-gradient(180deg, transparent, rgba(97, 225, 230, 0.55));
  }
  .desafio-inner::after {
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.55), transparent);
    margin-top: 32px;
  }
  .desafio-inner::before {
    margin-bottom: 32px;
  }

  .desafio-eyebrow {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--cyan);
    opacity: 0.9;
    margin-bottom: 22px;
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.18;
    color: var(--cream);
    margin: 0 auto;
    max-width: 680px;
    letter-spacing: -0.3px;
  }
  h2 em {
    font-style: italic;
    color: var(--cyan);
  }

  p {
    margin: 26px auto 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: rgba(255, 248, 234, 0.72);
    max-width: 520px;
  }

  /* Reveal */
  .desafio-inner {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 900ms ease,
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .desafio-inner.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .desafio { padding: 72px 0 80px; }
    .desafio-inner::before,
    .desafio-inner::after {
      height: 32px;
    }
    .desafio-inner::before { margin-bottom: 22px; }
    .desafio-inner::after  { margin-top: 22px; }
    .desafio-eyebrow {
      font-size: 10.5px;
      letter-spacing: 2.4px;
    }
    p { font-size: 14.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .desafio-inner {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Reveal on scroll — se re-anima cada vez que el bloque vuelve al viewport
  const inner = document.querySelector<HTMLElement>('.desafio-inner');
  if (inner) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('revealed');
          else e.target.classList.remove('revealed');
        });
      },
      { rootMargin: '0px 0px -15% 0px', threshold: 0.2 },
    );
    observer.observe(inner);
  }
</script>
