---
// Footer minimalista con marca, tagline y enlaces
---

<footer>
  <div class="wrap foot-inner">
    <div class="foot-top">
      <div class="foot-brand">
        <img
          src="/images/logo/logo_troppo_beige_grande.png"
          alt="Troppo — Inteligencia que mueve el tráfico"
          class="foot-brand-logo"
        />
      </div>
      <div class="foot-links">
        <a
          href="https://www.instagram.com/troppo.cl/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de Troppo"
        >
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="14" height="14" rx="4" />
            <circle cx="10" cy="10" r="3.4" />
            <circle cx="14.4" cy="5.6" r="0.6" fill="currentColor" />
          </svg>
          <span>Instagram</span>
        </a>
        <a
          href="https://www.linkedin.com/company/troppo-traffic/home/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn de Troppo"
        >
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="14" height="14" rx="2" />
            <path d="M6.5 8.5 L6.5 14" />
            <circle cx="6.5" cy="6" r="0.9" fill="currentColor" stroke="none" />
            <path d="M9.5 14 L9.5 8.5 M9.5 11 C 9.5 9.5 10.6 8.5 12 8.5 C 13.4 8.5 14 9.5 14 11 L14 14" />
          </svg>
          <span>LinkedIn</span>
        </a>
        <a
          href="mailto:troppo2026@gmail.com"
          aria-label="Enviar email a Troppo"
        >
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2.5" y="4.5" width="15" height="11" rx="2" />
            <path d="M2.5 6 L10 11 L17.5 6" />
          </svg>
          <span>troppo2026@gmail.com</span>
        </a>
      </div>
    </div>
    <div class="foot-copy">
      © 2026 Feria USM · Proyecto Troppo
      <span class="foot-credit">
        · Fuente <a href="https://www.zetafonts.com/arsenica" target="_blank" rel="noopener">Arsenica</a> por Zetafonts (CC-BY-NC)
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: rgba(21, 27, 32, 0.9);
    color: rgba(255, 248, 234, 0.6);
    padding: 56px 0 32px;
  }
  /* Layout en 2 filas: top (logo + links) y bottom (copyright con
     divisor sutil). Distribuye mejor el peso visual del footer. */
  .foot-inner {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .foot-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;
  }
  .foot-brand {
    display: flex;
    align-items: center;
  }
  /* PNG combinado: brújula + wordmark 'TROPPO' + tagline 'Inteligencia
     que mueve el tráfico'. Aspect ~2.08 (recortado a bbox). */
  .foot-brand-logo {
    display: block;
    height: 68px;
    width: auto;
    object-fit: contain;
  }
  .foot-links {
    display: flex;
    gap: 22px;
    font-size: 13.5px;
    align-items: center;
  }
  .foot-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 248, 234, 0.7);
    transition: color 260ms ease, transform 260ms ease;
  }
  .foot-links a:hover {
    color: var(--cyan);
    transform: translateY(-1px);
  }
  .foot-links svg { flex-shrink: 0; }
  .foot-copy {
    font-size: 12.5px;
    text-align: center;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 248, 234, 0.08);
    color: rgba(255, 248, 234, 0.5);
  }
  .foot-credit {
    opacity: 0.75;
  }
  .foot-credit a {
    text-decoration: underline;
    text-decoration-color: rgba(255, 248, 234, 0.3);
  }
  .foot-credit a:hover {
    text-decoration-color: var(--cyan);
  }

  @media (max-width: 860px) {
    footer { padding: 40px 0 24px; }
    .foot-brand-logo { height: 54px; }
    .foot-top {
      justify-content: center;
      text-align: center;
      gap: 22px;
    }
    .foot-links { justify-content: center; flex-wrap: wrap; }
    .foot-inner { gap: 20px; }
  }
</style>
