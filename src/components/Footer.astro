---
// Footer minimalista con marca, tagline y enlaces
---

<footer>
  <div class="wrap foot-inner">
    <div class="foot-brand">
      <img
        src="/images/logo/logo_light_sinfondo.png"
        alt=""
        class="foot-logo"
        width="44"
        height="44"
      />
      <span class="foot-wordmark">TROPPO</span>
      <div class="foot-tagline">Inteligencia que mueve el tráfico</div>
    </div>
    <div class="foot-links">
      <a href="#">Instagram</a>
      <a href="#">LinkedIn</a>
      <a href="#">Contacto</a>
    </div>
    <div class="foot-copy">
      © 2026 Feria USM · Proyecto Troppo
      <span class="foot-credit">
        · Fuente <a href="https://www.zetafonts.com/arsenica" target="_blank" rel="noopener">Arsenica</a> por Zetafonts (CC-BY-NC)
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: rgba(255, 248, 234, 0.6);
    padding: 48px 0;
  }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .foot-logo {
    height: 44px;
    width: 44px;
    display: block;
  }
  .foot-wordmark {
    font-family: var(--font-brand);
    color: var(--cream);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 1;
  }
  .foot-tagline {
    font-size: 13px;
    color: rgba(255, 248, 234, 0.5);
  }
  .foot-links {
    display: flex;
    gap: 24px;
    font-size: 13.5px;
  }
  .foot-copy {
    font-size: 12.5px;
  }
  .foot-credit {
    opacity: 0.6;
  }
  .foot-credit a {
    text-decoration: underline;
    text-decoration-color: rgba(255, 248, 234, 0.3);
  }
  .foot-credit a:hover {
    text-decoration-color: var(--cyan);
  }
</style>
