---
// Sección 5 rúbrica — "Para quién es Troppo"
//
// Rúbrica: "Troppo está pensado para cualquier entidad que tenga problemas
// de congestión en una zona crítica en la que tenga capacidades de realizar
// cambios: entidades grandes, puertos nacionales o incluso municipalidades."
//
// 3 audiencias con perfil de dolor + cómo Troppo lo resuelve.

const audiencias = [
  {
    icono: 'port',
    tag: 'Autoridades portuarias',
    titulo: 'Puertos nacionales',
    dolor: 'Accesos viales saturados, ventanas de operación que colapsan y presión por reducir tiempos de espera de la carga.',
    solucion: 'Simulan políticas de semaforización y turnos de ingreso antes de aplicar, con evidencia cuantificable para justificar cada cambio.',
    ejemplos: 'San Antonio · Valparaíso · Coronel · Iquique',
  },
  {
    icono: 'city',
    tag: 'Municipalidades',
    titulo: 'Gobiernos locales',
    dolor: 'Puntos negros de congestión urbana, capacidad para modificar semaforización pero sin herramientas para probar el impacto real.',
    solucion: 'Evalúan intervenciones en cruces críticos sin exponer al ciudadano a experimentos en terreno.',
    ejemplos: 'Nudos viales · Corredores · Zonas escolares',
  },
  {
    icono: 'logistics',
    tag: 'Operadores logísticos',
    titulo: 'Entidades grandes con corredores propios',
    dolor: 'Flotas de carga con rutas fijas, complicaciones que se traducen directamente en costos operacionales y OPEX inflado.',
    solucion: 'Optimizan corredores propios coordinando su flota con la red pública, midiendo el impacto por escenario.',
    ejemplos: 'Mineras · Retail · Zonas francas · Parques industriales',
  },
];
---

<section class="paraq" id="para-quien">
  <div class="wrap">
    <header class="paraq-head">
      <div class="paraq-eyebrow" data-vh>
        <span class="eyebrow-mark" aria-hidden="true"></span>
        PARA QUIÉN ES TROPPO
      </div>
      <h2 data-vh>Cualquier entidad con congestión en una zona crítica y <em>capacidad de decidir sobre ella.</em></h2>
      <p data-vh>
        No importa el tamaño ni el rubro: si tienes potestad para modificar
        semaforización, ordenar accesos o coordinar flotas en una zona
        congestionada, Troppo te sirve para
        <strong>probar antes de aplicar</strong>.
      </p>
    </header>

    <div class="paraq-grid">
      {
        audiencias.map((a) => (
          <article class="pq-audience" data-reveal>
            <div class="pqa-icon-wrap">
              <svg class="pqa-icon" viewBox="0 0 40 40" aria-hidden="true">
                {a.icono === 'port' && (
                  <>
                    {/* Grúa de puerto + contenedor + agua */}
                    <path d="M4 34 L36 34" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-dasharray="2 3" />
                    <rect x="8" y="26" width="10" height="7" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="20" y="26" width="10" height="7" fill="none" stroke="currentColor" stroke-width="2" />
                    <line x1="13" y1="26" x2="13" y2="33" stroke="currentColor" stroke-width="1" opacity="0.5" />
                    <line x1="25" y1="26" x2="25" y2="33" stroke="currentColor" stroke-width="1" opacity="0.5" />
                    <path d="M8 26 L8 10 L28 10" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
                    <line x1="20" y1="10" x2="20" y2="24" stroke="currentColor" stroke-width="1.5" opacity="0.7" />
                    <circle cx="20" cy="24" r="1.5" fill="currentColor" />
                  </>
                )}
                {a.icono === 'city' && (
                  <>
                    {/* Skyline urbana + semáforos */}
                    <path d="M4 34 L36 34" stroke="currentColor" stroke-width="1.5" opacity="0.4" />
                    <rect x="6" y="18" width="7" height="16" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="16" y="12" width="8" height="22" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="27" y="20" width="6" height="14" fill="none" stroke="currentColor" stroke-width="2" />
                    <line x1="8" y1="22" x2="11" y2="22" stroke="currentColor" stroke-width="0.8" opacity="0.6" />
                    <line x1="8" y1="26" x2="11" y2="26" stroke="currentColor" stroke-width="0.8" opacity="0.6" />
                    <line x1="18" y1="16" x2="22" y2="16" stroke="currentColor" stroke-width="0.8" opacity="0.6" />
                    <line x1="18" y1="20" x2="22" y2="20" stroke="currentColor" stroke-width="0.8" opacity="0.6" />
                    <line x1="18" y1="24" x2="22" y2="24" stroke="currentColor" stroke-width="0.8" opacity="0.6" />
                    <circle cx="20" cy="8" r="1.8" fill="currentColor" />
                  </>
                )}
                {a.icono === 'logistics' && (
                  <>
                    {/* Camión + ruta */}
                    <path d="M4 32 L36 32" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-dasharray="2 3" />
                    <rect x="6" y="16" width="16" height="12" fill="none" stroke="currentColor" stroke-width="2" />
                    <path d="M22 20 L28 20 L32 24 L32 28 L22 28 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="11" cy="30" r="2" fill="currentColor" />
                    <circle cx="26" cy="30" r="2" fill="currentColor" />
                    <line x1="8" y1="20" x2="20" y2="20" stroke="currentColor" stroke-width="0.8" opacity="0.5" />
                    <line x1="8" y1="24" x2="20" y2="24" stroke="currentColor" stroke-width="0.8" opacity="0.5" />
                  </>
                )}
              </svg>
            </div>
            <div class="pqa-tag">{a.tag}</div>
            <h3>{a.titulo}</h3>
            <div class="pqa-block">
              <span class="pqa-block-label">Dolor</span>
              <p>{a.dolor}</p>
            </div>
            <div class="pqa-block pqa-block-solution">
              <span class="pqa-block-label">Con Troppo</span>
              <p>{a.solucion}</p>
            </div>
            <div class="pqa-examples">{a.ejemplos}</div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .paraq {
    padding: 110px 0 130px;
    background: rgba(3, 53, 68, 0.84);
    color: var(--cream);
    position: relative;
    overflow: hidden;
  }
  .wrap { position: relative; z-index: 1; }

  /* halo cyan ambiental sutil */
  .paraq::before {
    content: '';
    position: absolute;
    top: -10%;
    left: 40%;
    transform: translateX(-50%);
    width: 720px;
    height: 720px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(97, 225, 230, 0.09), transparent 65%);
    filter: blur(80px);
    pointer-events: none;
  }

  /* ---- HEAD ---- */
  .paraq-head {
    max-width: 780px;
    margin: 0 auto 68px;
    text-align: center;
  }
  .paraq-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--cyan);
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .paraq-eyebrow .eyebrow-mark {
    display: inline-block;
    width: 0;
    height: 2px;
    background: var(--cyan);
    box-shadow: 0 0 8px rgba(97, 225, 230, 0.6);
    border-radius: 2px;
    transition: width 900ms cubic-bezier(0.16, 1, 0.3, 1) 100ms;
  }
  .paraq-eyebrow.revealed .eyebrow-mark { width: 42px; }
  .paraq-head h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 40px;
    line-height: 1.2;
    color: var(--cream);
    margin: 0;
    letter-spacing: -0.4px;
  }
  .paraq-head h2 em {
    font-style: italic;
    color: var(--cyan);
  }
  .paraq-head p {
    margin: 22px auto 0;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(255, 248, 234, 0.85);
    max-width: 580px;
    padding-left: 18px;
    border-left: 2px solid rgba(97, 225, 230, 0.4);
    text-align: left;
  }
  .paraq-head strong {
    color: var(--cream);
    font-weight: 700;
  }
  /* Reveal escalonado del header */
  .paraq [data-vh] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .paraq [data-vh].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---- GRID ---- */
  .paraq-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    max-width: 1180px;
    margin: 0 auto;
  }
  .pq-audience {
    background: rgba(255, 248, 234, 0.045);
    border: 1px solid rgba(255, 248, 234, 0.14);
    border-radius: 18px;
    padding: 34px 30px 30px;
    display: flex;
    flex-direction: column;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      background 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease;
    position: relative;
    overflow: hidden;
  }
  .pq-audience::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      130% 90% at 100% 0%,
      rgba(97, 225, 230, 0.14) 0%,
      transparent 55%
    );
    opacity: 0;
    transition: opacity 500ms ease;
    pointer-events: none;
  }
  .pq-audience:hover::before { opacity: 1; }
  .pq-audience:hover {
    transform: translateY(-5px);
    background: rgba(97, 225, 230, 0.055);
    border-color: rgba(97, 225, 230, 0.42);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
  }

  .pqa-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: 15px;
    background: rgba(97, 225, 230, 0.14);
    border: 1px solid rgba(97, 225, 230, 0.32);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cyan);
    margin-bottom: 22px;
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    z-index: 1;
  }
  .pq-audience:hover .pqa-icon-wrap {
    transform: scale(1.06) rotate(-3deg);
  }
  .pqa-icon { width: 40px; height: 40px; }

  .pqa-tag {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1.8px;
    color: var(--cyan);
    text-transform: uppercase;
    opacity: 0.85;
    margin-bottom: 6px;
    position: relative;
    z-index: 1;
  }
  .pq-audience h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--cream);
    margin: 0 0 20px;
    line-height: 1.25;
    position: relative;
    z-index: 1;
  }
  .pqa-block {
    margin-top: 12px;
    position: relative;
    z-index: 1;
  }
  .pqa-block-label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
    color: rgba(255, 248, 234, 0.55);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .pqa-block-solution .pqa-block-label {
    color: var(--cyan);
  }
  .pqa-block p {
    font-size: 13.8px;
    line-height: 1.55;
    color: rgba(255, 248, 234, 0.82);
    margin: 0;
  }
  .pqa-examples {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px dashed rgba(255, 248, 234, 0.16);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 248, 234, 0.6);
    letter-spacing: 0.3px;
    position: relative;
    z-index: 1;
  }

  /* Reveal on scroll */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease, transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- MOBILE --- */
  @media (max-width: 960px) {
    .paraq-grid { grid-template-columns: 1fr; gap: 16px; max-width: 480px; }
    .paraq-head h2 { font-size: 26px; }
    .pq-audience { padding: 28px 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .pq-audience, .pqa-icon-wrap { transition: none; }
  }
</style>

<script>
  // Se re-anima cada vez que los items vuelven al viewport
  const items = document.querySelectorAll<HTMLElement>('.paraq [data-reveal]');
  if (items.length) {
    const timers = new WeakMap<Element, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e, i) => {
          const prev = timers.get(e.target);
          if (prev) window.clearTimeout(prev);
          if (e.isIntersecting) {
            const t = window.setTimeout(() => {
              e.target.classList.add('revealed');
              timers.delete(e.target);
            }, i * 130);
            timers.set(e.target, t);
          } else {
            e.target.classList.remove('revealed');
          }
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );
    items.forEach((el) => observer.observe(el));
  }

  // Reveal escalonado del header (eyebrow → h2 → párrafo). Re-animatable.
  const paraqHeadItems = Array.from(
    document.querySelectorAll<HTMLElement>('.paraq [data-vh]'),
  );
  if (paraqHeadItems.length) {
    paraqHeadItems.forEach((el, i) => {
      el.style.transitionDelay = `${i * 140}ms`;
    });
    const paraqHeadObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('revealed');
          else e.target.classList.remove('revealed');
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.2 },
    );
    paraqHeadItems.forEach((el) => paraqHeadObs.observe(el));
  }
</script>
