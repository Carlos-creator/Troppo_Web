---
// "Cómo funciona" — El flujo del panel al resultado ilustrado como un
// viaje por Chile de norte a sur.
//
// Layout: grid 2-cols. Cards a la izquierda scrolleables. Mapa de
// Chile sticky a la derecha con un camión que recorre la costa a medida
// que el usuario avanza en el scroll. 5 hitos con un pin cada uno a lo
// largo de la ruta (de norte a sur):
//   1. Define el escenario
//   2. Ejecuta la simulación
//   3. Analiza los resultados
//   4. Optimiza con IA
//   5. Monitorea y opera en tiempo real
---

<section class="how sec-dark" id="como-funciona">
  <div class="wrap">
    <header class="how-header">
      <div class="how-eyebrow sec-title" data-vh>
        ¿Cómo funciona Troppo?
      </div>
      <h2 class="sec-subtitle" data-vh>Del escenario a los resultados,<br /> <em>paso a paso.</em></h2>
    </header>

    <div class="how-container" data-road>
      <!-- Columna izquierda: 5 hito cards apilados -->
      <div class="how-cards">
        <article class="hito hito-1" data-hito="1">
          <div class="hito-header-row">
            <span class="hito-num">01</span>
            <span class="hito-dot"></span>
          </div>
          <h3>Define el escenario</h3>
          <p>
            Desde la aplicación configuras el escenario que quieres evaluar:
            defines la zona de estudio, los buffers y las rutas que formarán
            parte de la simulación, junto con las ubicaciones de los semáforos
            que se evaluarán.
          </p>
        </article>

        <article class="hito hito-2" data-hito="2">
          <div class="hito-header-row">
            <span class="hito-num">02</span>
            <span class="hito-dot"></span>
          </div>
          <h3>Ejecuta la simulación</h3>
          <p>
            Con el escenario configurado, ejecutas la simulación para analizar
            el comportamiento del tránsito bajo las condiciones definidas. El motor de simulación procesa estos parámetros y genera
            los resultados para su posterior análisis.
          </p>
        </article>

        <article class="hito hito-3" data-hito="3">
          <div class="hito-header-row">
            <span class="hito-num">03</span>
            <span class="hito-dot"></span>
          </div>
          <h3>Analiza los resultados</h3>
          <p>
            La aplicación presenta las métricas obtenidas en cada ejecución,
            como los tiempos de espera y los niveles de congestión. Estos
            resultados permiten comparar escenarios, evaluar alternativas y
            seleccionar las configuraciones que conviene implementar.
          </p>
        </article>

        <article class="hito hito-4" data-hito="4">
          <div class="hito-header-row">
            <span class="hito-num">04</span>
            <span class="hito-dot"></span>
          </div>
          <h3>Optimiza con IA</h3>
          <p>
            A partir del escenario configurado y de las ejecuciones de
            simulación, puedes iniciar el entrenamiento de la IA. El modelo
            evalúa alternativas y recomienda ubicaciones de semáforos orientadas
            a reducir la congestión.
          </p>
        </article>

        <article class="hito hito-5" data-hito="5">
          <div class="hito-header-row">
            <span class="hito-num">05</span>
            <span class="hito-dot"></span>
          </div>
          <h3>Monitorea y opera en tiempo real</h3>
          <p>
            Una vez implementadas las mejoras en terreno, el gemelo digital
            permite monitorear el estado de la red vial en tiempo real. El
            operador puede supervisar el tránsito e intervenir en la operación
            semafórica cuando las condiciones lo requieran.
          </p>
        </article>
      </div>

      <!-- Columna derecha: Chile map FULL HEIGHT (no sticky) — se
           extiende a lo largo de toda la sección para acompañar los 5
           hitos. El camión baja proporcional al scroll. -->
      <div class="how-map-column">
        <!-- Silueta de Chile como mask-image (fondo cyan) -->
        <div class="chile-silhouette" aria-hidden="true"></div>

        <!-- SVG con la ruta que el camión recorre + marcadores de ciudad -->
        <svg
          class="chile-route"
          viewBox="0 0 400 2000"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            class="route-base"
            d="M 195 90 C 175 220 158 400 148 620 C 138 780 130 900 140 1050 C 155 1200 175 1400 200 1780"
          />
          <path
            class="route-progress"
            d="M 195 90 C 175 220 158 400 148 620 C 138 780 130 900 140 1050 C 155 1200 175 1400 200 1780"
          />
          <g class="city-pin pin-1" data-pin="1">
            <circle cx="195" cy="90" r="14" class="pin-halo" />
            <circle cx="195" cy="90" r="7" class="pin-dot" />
            <circle cx="195" cy="90" r="3.5" class="pin-core" />
          </g>
          <g class="city-pin pin-2" data-pin="2">
            <circle cx="148" cy="620" r="14" class="pin-halo" />
            <circle cx="148" cy="620" r="7" class="pin-dot" />
            <circle cx="148" cy="620" r="3.5" class="pin-core" />
          </g>
          <g class="city-pin pin-3" data-pin="3">
            <circle cx="135" cy="960" r="14" class="pin-halo" />
            <circle cx="135" cy="960" r="7" class="pin-dot" />
            <circle cx="135" cy="960" r="3.5" class="pin-core" />
          </g>
          <!-- Pin 4 añadido para el 5.º hito: punto de la ruta en y=1400 -->
          <g class="city-pin pin-4" data-pin="4">
            <circle cx="172" cy="1400" r="14" class="pin-halo" />
            <circle cx="172" cy="1400" r="7" class="pin-dot" />
            <circle cx="172" cy="1400" r="3.5" class="pin-core" />
          </g>
          <g class="city-pin pin-5" data-pin="5">
            <circle cx="200" cy="1780" r="14" class="pin-halo" />
            <circle cx="200" cy="1780" r="7" class="pin-dot" />
            <circle cx="200" cy="1780" r="3.5" class="pin-core" />
          </g>
        </svg>

        <!-- Camión que viaja por la ruta -->
        <div class="chile-truck" data-truck aria-hidden="true">
          <svg viewBox="0 0 32 16" width="34" height="17">
            <rect x="0" y="2" width="22" height="12" fill="#61E1E6" stroke="#044559" stroke-width="0.6" />
            <path d="M22 5 h6 l4 5 v4 h-10 z" fill="#61E1E6" stroke="#044559" stroke-width="0.6" />
            <circle cx="7" cy="15" r="2" fill="#151B20" />
            <circle cx="17" cy="15" r="2" fill="#151B20" />
            <circle cx="27" cy="15" r="2" fill="#151B20" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fondo navy (mismo que Values / Zona Empresa). Encabezado y tarjetas
     usan el lenguaje de las secciones azules; el mapa de Chile (silueta,
     ruta, pins y camión) se mantiene sin cambios. */
  .how {
    padding: 110px 0 130px;
    background: rgba(3, 53, 68, 0.84);
    color: var(--cream);
    position: relative;
    overflow: hidden;
  }
  .wrap { position: relative; z-index: 1; }

  /* ============ HEADER ============ */
  .how-header {
    max-width: 640px;
    margin: 0 auto 80px;
    text-align: center;
  }
  .how-eyebrow {
    display: inline-flex;
    align-items: center;
    margin-bottom: 24px;
  }
  .how h2 {
    margin: 0;
  }
  /* Reveal escalonado del header */
  .how [data-vh] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .how [data-vh].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============ CONTAINER 2-COL ============ */
  .how-container {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 60px;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    align-items: stretch;
  }

  /* ============ CARDS COLUMN ============ */
  .how-cards {
    display: flex;
    flex-direction: column;
    /* space-between distribuye las 5 cards uniformemente en la altura
       del container. La 1era arriba (norte), la 5ta abajo (sur). */
    justify-content: space-between;
    gap: 80px;
    padding: 20px 0 40px;
    min-height: 1400px;
  }
  .hito {
    /* Tarjeta de vidrio sobre navy (mismo lenguaje que las tarjetas de
       "¿Qué ofrece Troppo?" y de la Zona Empresa). */
    background: rgba(255, 248, 234, 0.045);
    border: 1px solid rgba(255, 248, 234, 0.14);
    border-radius: 16px;
    padding: 26px 28px 28px;
    box-shadow:
      0 10px 28px rgba(0, 0, 0, 0.12),
      0 0 0 0 rgba(97, 225, 230, 0);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    max-width: 520px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    opacity: 0;
    transition:
      opacity 850ms ease,
      transform 950ms cubic-bezier(0.16, 1, 0.3, 1),
      background 400ms ease,
      box-shadow 400ms ease,
      border-color 400ms ease;
  }
  /* Los hitos 1, 3 y 5 "vuelan" desde la izquierda con rotación negativa;
     los 2 y 4 desde la derecha con rotación positiva. Al revelarse
     aterrizan en su posición final. Estado estático después del reveal. */
  .hito-1, .hito-3, .hito-5 {
    transform: translateX(-160px) rotate(-4deg);
  }
  .hito-2, .hito-4 {
    transform: translateX(160px) rotate(4deg);
  }
  .hito.revealed {
    opacity: 1;
    transform: translateX(0) rotate(0deg);
  }

  /* ---- BRILLO: halo cyan pulsante en la esquina superior ----
     Un punto de luz cyan suave que pulsa cerca del número del hito. */
  .hito::after {
    content: '';
    position: absolute;
    top: -30px;
    left: -30px;
    width: 140px;
    height: 140px;
    background: radial-gradient(
      circle at center,
      rgba(97, 225, 230, 0.32) 0%,
      rgba(97, 225, 230, 0.12) 35%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
    animation: hito-glow 4s ease-in-out infinite;
  }
  @keyframes hito-glow {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.1); }
  }
  .hito-2::after { animation-delay: 1s; }
  .hito-3::after { animation-delay: 2s; }
  .hito-4::after { animation-delay: 3s; }
  .hito-5::after { animation-delay: 4s; }

  /* Contenido por encima de los efectos */
  .hito-header-row,
  .hito h3,
  .hito > p {
    position: relative;
    z-index: 2;
  }

  /* ---- HOVER: refuerzo del brillo ---- */
  .hito:hover {
    background: rgba(97, 225, 230, 0.055);
    box-shadow:
      0 14px 32px rgba(0, 0, 0, 0.25),
      0 0 0 3px rgba(97, 225, 230, 0.28);
    border-color: rgba(97, 225, 230, 0.55);
  }
  .hito:hover::after {
    animation-duration: 1.4s;
    opacity: 1;
  }
  .hito-header-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }
  .hito-num {
    font-family: var(--font-title);
    font-size: 32px;
    color: var(--cream);
    font-weight: 700;
    line-height: 1;
    text-shadow: 0 0 8px rgba(97, 225, 230, 0.3);
    animation: hito-num-glow 3s ease-in-out infinite;
  }
  @keyframes hito-num-glow {
    0%, 100% { text-shadow: 0 0 8px rgba(97, 225, 230, 0.3); }
    50%      { text-shadow: 0 0 16px rgba(97, 225, 230, 0.75), 0 0 4px rgba(97, 225, 230, 0.5); }
  }
  .hito-2 .hito-num { animation-delay: 0.75s; }
  .hito-3 .hito-num { animation-delay: 1.5s; }
  .hito-4 .hito-num { animation-delay: 2.25s; }
  .hito-5 .hito-num { animation-delay: 3s; }
  .hito-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 248, 234, 0.3);
  }
  .hito h3 {
    font-family: var(--font-title);
    font-size: 18px;
    font-weight: 700;
    color: var(--cream);
    margin: 0 0 10px;
    letter-spacing: 0.2px;
  }
  .hito p {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 248, 234, 0.78);
    margin: 0;
  }

  /* ============ CHILE MAP COLUMN ============
     La columna del mapa se ESTIRA para ocupar toda la altura del
     container (align-items: stretch en el grid). Así el mapa acompaña
     a los 5 hitos: el 1.º arriba (norte), el 5.º abajo (sur). */
  .how-map-column {
    position: relative;
    min-height: 100%;
  }
  /* Silueta de Chile — cubre TODA la columna vertical con preserveAspectRatio:none
     para que se estire uniformemente y coincida con la ruta */
  .chile-silhouette {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 220px;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(97, 225, 230, 0.32) 0%,
      rgba(97, 225, 230, 0.22) 45%,
      rgba(4, 69, 89, 0.38) 100%
    );
    -webkit-mask-image: url("/images/chile_blank_map.svg");
    mask-image: url("/images/chile_blank_map.svg");
    /* mask-size 100% 100% para que se estire con la columna
       (aspect ratio no se mantiene pixel-perfect pero visualmente ok) */
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /* SVG con ruta + pins — coincide con silueta */
  .chile-route {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 220px;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .route-base {
    fill: none;
    stroke: rgba(4, 69, 89, 0.35);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 6 8;
    vector-effect: non-scaling-stroke;
  }
  .route-progress {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 6px rgba(97, 225, 230, 0.75));
    /* strokeDasharray + offset set via JS */
  }

  /* Pins de ciudades */
  .city-pin {
    transition: opacity 400ms ease;
  }
  .pin-halo {
    fill: rgba(97, 225, 230, 0.2);
    transition: fill 400ms ease, r 400ms ease;
  }
  .pin-dot {
    fill: rgba(4, 69, 89, 0.5);
    stroke: rgba(255, 248, 234, 0.6);
    stroke-width: 1;
    transition: fill 400ms ease;
  }
  .pin-core {
    fill: rgba(255, 248, 234, 0.4);
    transition: fill 400ms ease;
  }
  /* Pin activo — cuando el camión ya pasó */
  .city-pin.active .pin-halo {
    fill: rgba(97, 225, 230, 0.45);
    r: 18;
    animation: pin-pulse 2s ease-in-out infinite;
  }
  .city-pin.active .pin-dot {
    fill: var(--cyan);
  }
  .city-pin.active .pin-core {
    fill: var(--cream);
  }
  @keyframes pin-pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  /* Camión */
  .chile-truck {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%) rotate(var(--truck-rot, 90deg));
    transform-origin: center;
    will-change: left, top, transform;
    filter: drop-shadow(0 3px 5px rgba(4, 69, 89, 0.45));
    opacity: 0;
    transition: opacity 300ms ease;
    z-index: 3;
  }
  .chile-truck.active { opacity: 1; }

  /* ============ MOBILE ============ */
  @media (max-width: 960px) {
    .how-container {
      grid-template-columns: 1fr;
      gap: 40px;
      max-width: 480px;
      position: relative;
    }
    .how-cards {
      gap: 40px;
      padding: 0;
      min-height: 0;
      justify-content: flex-start;
      position: relative;
      z-index: 1;
    }
    /* En mobile la fly-in desde los costados se ve pobre — hitos usan
       slide vertical sutil. Overrides sobrescriben los transform de
       .hito-1/2/3/4/5 con selectors más específicos. */
    .hito.hito-1,
    .hito.hito-2,
    .hito.hito-3,
    .hito.hito-4,
    .hito.hito-5 {
      max-width: 100%;
      transform: translateY(24px) rotate(0deg);
    }
    .hito.hito-1.revealed,
    .hito.hito-2.revealed,
    .hito.hito-3.revealed,
    .hito.hito-4.revealed,
    .hito.hito-5.revealed {
      transform: translateY(0) rotate(0deg);
    }
    /* En mobile el mapa se convierte en telón de fondo transparente
       detrás de las cards: la silueta de Chile se estira a lo alto del
       container. El camión sí sigue recorriendo la ruta (queda por
       encima de las cards, moviéndose entre los hitos). Ruta y pins
       se ocultan visualmente pero el SVG se mantiene con dimensiones
       para que el JS pueda posicionar al camión sobre el path. */
    .how-map-column {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .chile-silhouette {
      width: 320px;
      height: 100%;
      opacity: 0.92;
      /* Gradiente más saturado en mobile para que Chile sea el protagonista */
      background: linear-gradient(
        180deg,
        rgba(97, 225, 230, 0.72) 0%,
        rgba(97, 225, 230, 0.55) 45%,
        rgba(4, 69, 89, 0.78) 100%
      );
    }
    .chile-route { display: block; }
    .chile-route .route-base,
    .chile-route .route-progress,
    .chile-route .city-pin { opacity: 0; }
    /* Camión visible por encima de las cards mientras baja Chile */
    .chile-truck { z-index: 3; }
    .chile-truck.active { opacity: 0.95; }
    /* En mobile la silueta de Chile queda detrás de las cards: vidrio
       navy más denso + blur para que el texto cream se siga leyendo y
       Chile se adivine detrás. */
    .hito {
      background: rgba(3, 53, 68, 0.6);
      border-color: rgba(97, 225, 230, 0.32);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hito, .chile-truck, .city-pin, .pin-halo, .pin-dot, .pin-core {
      transition: none;
    }
    .hito { opacity: 1; transform: none; }
    .city-pin.active .pin-halo { animation: none; }
    /* Desactivar todos los brillos temáticos */
    .hito::after { animation: none; display: none; }
    .hito-num { animation: none; }
  }
</style>

<script>
  import { revealOnScroll } from '../scripts/reveal';
  // Controlador del flujo Chile:
  // - Reveal escalonado de las 5 cards con IntersectionObserver
  // - Ruta se dibuja proporcional al scroll dentro de la sección
  // - Camión viaja por la ruta usando getPointAtLength
  // - Pins de ciudad se activan cuando el camión llega

  const section = document.querySelector<HTMLElement>('.how');
  const container = section?.querySelector<HTMLElement>('.how-container');
  const routeProgress = section?.querySelector<SVGPathElement>('.route-progress');
  const truck = section?.querySelector<HTMLElement>('[data-truck]');
  const hitos = Array.from(section?.querySelectorAll<HTMLElement>('.hito') ?? []);
  const pins = Array.from(section?.querySelectorAll<SVGGElement>('.city-pin') ?? []);

  if (section && container && routeProgress && truck && hitos.length) {
    const routeLen = routeProgress.getTotalLength();
    routeProgress.style.strokeDasharray = String(routeLen);
    routeProgress.style.strokeDashoffset = String(routeLen);

    // ViewBox del SVG donde vive la ruta y los pins
    const VBOX = { w: 400, h: 2000 };

    // Umbrales de "camión pasó por esta ciudad" (0..1 sobre la ruta)
    // Estimados en base a la posición Y de cada pin sobre la longitud total.
    // El pin 4 (y=1400) está al 77,5% de la ruta → umbral 0.80 (mismo
    // margen ~+0.03–0.05 que los demás).
    const PIN_THRESHOLDS = [0.05, 0.35, 0.55, 0.8, 0.94];

    let ticking = false;
    let inView = false;

    const update = () => {
      const rect = container.getBoundingClientRect();
      const vh = window.innerHeight;
      // Progreso relativo al container: 0 cuando el top entra al viewport
      // por abajo, 1 cuando el bottom sale por arriba.
      const start = rect.top - vh * 0.75;
      const end = rect.bottom - vh * 0.25;
      const range = end - start;
      const raw = -start / range;
      const progress = Math.max(0, Math.min(1, raw));

      // Dibujo progresivo de la ruta
      routeProgress.style.strokeDashoffset = String(routeLen * (1 - progress));

      // Camión en la ruta
      if (progress > 0.005) {
        truck.classList.add('active');
        const drawnLen = routeLen * progress;
        const pt = routeProgress.getPointAtLength(drawnLen);
        const ahead = routeProgress.getPointAtLength(Math.min(drawnLen + 1, routeLen));
        const angle = (Math.atan2(ahead.y - pt.y, ahead.x - pt.x) * 180) / Math.PI;

        // Convertir user-space (viewBox) a CSS coords relativas al
        // contenedor del mapa (parent del camión)
        const svgEl = routeProgress.ownerSVGElement;
        if (svgEl) {
          const svgRect = svgEl.getBoundingClientRect();
          const mapColRect = truck.parentElement!.getBoundingClientRect();
          const offsetX = svgRect.left - mapColRect.left;
          const offsetY = svgRect.top - mapColRect.top;
          const cssX = (pt.x / VBOX.w) * svgRect.width + offsetX;
          const cssY = (pt.y / VBOX.h) * svgRect.height + offsetY;
          truck.style.left = `${cssX}px`;
          truck.style.top = `${cssY}px`;
          truck.style.setProperty('--truck-rot', `${angle}deg`);
        }
      } else {
        truck.classList.remove('active');
      }

      // Activar pins cuando el camión pasa por ellos
      pins.forEach((pin, i) => {
        if (progress >= PIN_THRESHOLDS[i]) pin.classList.add('active');
        else pin.classList.remove('active');
      });

      ticking = false;
    };

    const onScroll = () => {
      if (!inView) return;
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    // IntersectionObserver de la sección — sólo actualiza si está en view
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          inView = e.isIntersecting;
          if (inView) requestAnimationFrame(update);
        });
      },
      { rootMargin: '200px 0px 200px 0px' },
    );
    io.observe(container);

    // Reveal por card: se re-anima cada vez que el hito vuelve al
    // viewport. Al salir se quita .revealed para que el fly-in dispare
    // de nuevo al re-entrar.
    // Histéresis específica de los hitos:
    // - Escritorio: translateX(±160px) + rotate(±4deg). La rotación agranda
    //   la caja medida ~18px por arriba Y por abajo (tarjeta de hasta 520px),
    //   así que la zona de salida se amplía en ambos bordes.
    // - Móvil (≤960px): translateY(24px).
    // Salida: 48px sobre la pantalla (> 24px y > 18px) y borde inferior en
    // -12% en vez de -20% (≥ 40px extra en pantallas de 500px o más).
    revealOnScroll(hitos, {
      enterMargin: '0px 0px -20% 0px',
      threshold: 0.15,
      exitMargin: '48px 0px -12% 0px',
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  // Reveal escalonado del header (eyebrow → h2 → párrafo) — con
  // transition-delay por orden DOM. Re-animatable al salir/entrar.
  const howHeadItems = Array.from(
    document.querySelectorAll<HTMLElement>('.how [data-vh]'),
  );
  if (howHeadItems.length) {
    howHeadItems.forEach((el, i) => {
      el.style.transitionDelay = `${i * 140}ms`;
    });
    // Histéresis: salida 28px sobre la pantalla (> 14px del translateY
    // oculto) para que el encabezado no vuelva a entrar al ocultarse.
    revealOnScroll(howHeadItems, {
      enterMargin: '0px 0px -10% 0px',
      threshold: 0.2,
      exitMargin: '28px 0px -10% 0px',
    });
  }
</script>
