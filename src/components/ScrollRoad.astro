---
// Barra de progreso de scroll con camión — variante C de docs/IDEAS.md §2.2
//
// Posición: fixed en el bottom del viewport. Evita conflictos con el header
// sticky y el camión queda siempre visible sin obstruir contenido.
//
// Comportamiento:
//   - Al hacer scroll, la carretera se rellena de izquierda a derecha (lime)
//   - El camión avanza en sincronía con el progreso total del scroll
//   - Al llegar al final del documento, camión y fill llegan al 100%
//
// Accesibilidad:
//   - aria-hidden="true" (decorativo)
//   - Respeta prefers-reduced-motion (sin transiciones ni animaciones suaves)
---

<div class="scroll-road" aria-hidden="true">
  <div class="road-bar"></div>
  <div class="road-fill"></div>
  <svg class="truck" viewBox="0 0 32 16" width="32" height="16">
    <rect x="0" y="2" width="22" height="12" fill="currentColor" />
    <path d="M22 5 h6 l4 5 v4 h-10 z" fill="currentColor" />
    <circle cx="7" cy="15" r="2" fill="#151B20" />
    <circle cx="17" cy="15" r="2" fill="#151B20" />
    <circle cx="27" cy="15" r="2" fill="#151B20" />
  </svg>
</div>

<div class="semaphore state-red" role="status" aria-label="Indicador de estado de scroll">
  <span class="light red"></span>
  <span class="light yellow"></span>
  <span class="light green"></span>
</div>

<style>
  .scroll-road {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 20px;
    z-index: 100;
    pointer-events: none;
    overflow: visible;
  }
  .road-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: rgba(4, 69, 89, 0.2);
  }
  .road-fill {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 4px;
    width: 0;
    background: var(--lime);
    transition: width 80ms linear;
  }
  .truck {
    position: absolute;
    bottom: 4px;
    left: 0;
    color: var(--navy);
    transition: transform 80ms linear;
    filter: drop-shadow(0 1px 3px rgba(4, 69, 89, 0.35));
  }

  /* ---------- SEMÁFORO ---------- */
  .semaphore {
    position: fixed;
    bottom: 32px;
    right: 20px;
    z-index: 100;
    padding: 8px 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: rgba(21, 27, 32, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 100px;
    border: 1px solid rgba(255, 248, 234, 0.14);
    box-shadow: 0 4px 14px rgba(4, 69, 89, 0.25);
    pointer-events: none;
  }
  .light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 248, 234, 0.08);
    transition: background 220ms ease, box-shadow 220ms ease;
  }
  .semaphore.state-red .light.red {
    background: #ff5b5b;
    box-shadow: 0 0 12px #ff5b5b, 0 0 4px #ff5b5b inset;
  }
  .semaphore.state-yellow .light.yellow {
    background: #ffc93c;
    box-shadow: 0 0 12px #ffc93c, 0 0 4px #ffc93c inset;
  }
  .semaphore.state-green .light.green {
    background: var(--lime);
    box-shadow: 0 0 12px var(--lime), 0 0 4px var(--lime) inset;
  }

  @media (prefers-reduced-motion: reduce) {
    .road-fill,
    .truck,
    .light {
      transition: none;
    }
  }
</style>

<script>
  const scrollRoad = document.querySelector<HTMLElement>('.scroll-road');
  const fill = scrollRoad?.querySelector<HTMLElement>('.road-fill');
  const truck = scrollRoad?.querySelector<SVGElement>('.truck');
  const semaphore = document.querySelector<HTMLElement>('.semaphore');

  if (fill && truck) {
    const TRUCK_WIDTH = 32;
    let ticking = false;

    const update = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
      const maxLeft = window.innerWidth - TRUCK_WIDTH;
      fill.style.width = progress * 100 + '%';
      truck.style.transform = `translateX(${progress * maxLeft}px)`;
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }

  // Semáforo: verde al scrollear, amarillo al desacelerar, rojo cuando queda quieto.
  // Además: aplica body.is-scrolling para que otros componentes reaccionen
  // (ej. LiDAR sweep del Hero acelera cuando el usuario esta scrolleando).
  if (semaphore) {
    let yellowTimer: number | undefined;
    let redTimer: number | undefined;
    let scrollingTimer: number | undefined;

    const setState = (state: 'red' | 'yellow' | 'green') => {
      semaphore.classList.remove('state-red', 'state-yellow', 'state-green');
      semaphore.classList.add(`state-${state}`);
    };

    window.addEventListener(
      'scroll',
      () => {
        setState('green');
        document.body.classList.add('is-scrolling');
        window.clearTimeout(yellowTimer);
        window.clearTimeout(redTimer);
        window.clearTimeout(scrollingTimer);
        yellowTimer = window.setTimeout(() => setState('yellow'), 450);
        redTimer = window.setTimeout(() => setState('red'), 1200);
        scrollingTimer = window.setTimeout(
          () => document.body.classList.remove('is-scrolling'),
          400
        );
      },
      { passive: true }
    );
  }
</script>
