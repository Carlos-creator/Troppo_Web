---
// Escalabilidad — 3 zonas reales ciclando cada ~12 segundos.
// El polígono se ajusta a la forma real (3, 4 o 5 puntos según la zona).
//
// Zonas:
//   1. USM Campus San Joaquín (Santiago) — 3 puntos (triángulo, zona compacta)
//   2. Puerto San Antonio · Corredor logístico — 4 puntos (cuadrilátero alargado)
//   3. Centro Histórico de Valparaíso — 5 puntos (pentágono irregular)
---

<section class="scalability" id="escalable">
  <div class="wrap">
    <div class="scal-grid">
      <div class="scal-copy">
        <div class="eyebrow">ESCALABLE</div>
        <h2>Funciona en cualquier zona del país.</h2>
        <p class="scal-lead">
          El modelo no está atado a San Antonio. Hacemos un estudio previo del
          terreno, extraemos la red vial desde OpenStreetMap y calibramos con
          datos locales. <strong>El polígono se ajusta a la forma real</strong> —
          triángulo, cuadrilátero, o irregular con más puntos.
        </p>
        <ul class="scal-steps">
          <li>
            <span class="step-n">01</span>
            <div>
              <strong>Estudio previo</strong>
              <p>Análisis del terreno, red vial y patrones de demanda.</p>
            </div>
          </li>
          <li>
            <span class="step-n">02</span>
            <div>
              <strong>Delimitación libre</strong>
              <p>Sobre el mapa se marca la zona con los puntos necesarios.</p>
            </div>
          </li>
          <li>
            <span class="step-n">03</span>
            <div>
              <strong>Calibración local</strong>
              <p>Datos históricos, flota real y semaforización existente.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="scal-viewport">
        <svg
          class="scal-map"
          viewBox="0 0 800 500"
          preserveAspectRatio="xMidYMid meet"
          aria-label="Demostración de delimitación en distintas zonas del país"
        >
          <defs>
            <pattern id="scalBlocks" width="120" height="90" patternUnits="userSpaceOnUse">
              <rect x="10" y="10" width="40" height="30" fill="rgba(4, 69, 89, 0.08)" rx="2" />
              <rect x="60" y="10" width="50" height="30" fill="rgba(4, 69, 89, 0.06)" rx="2" />
              <rect x="10" y="50" width="55" height="35" fill="rgba(4, 69, 89, 0.05)" rx="2" />
              <rect x="75" y="50" width="35" height="35" fill="rgba(4, 69, 89, 0.07)" rx="2" />
            </pattern>
            <linearGradient id="scalOcean" x1="0" x2="1" y1="0" y2="0.5">
              <stop offset="0" stop-color="#022a37" />
              <stop offset="1" stop-color="#044559" />
            </linearGradient>
            <!-- Clip que restringe el escaneo + vehículos a la forma del polígono -->
            <clipPath id="zoneAnalysisClip">
              <polygon class="analysis-clip-poly" points="" />
            </clipPath>
            <!-- Haz del scanner LiDAR (banda cyan) -->
            <linearGradient id="scanBeam" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="rgba(97,225,230,0)" />
              <stop offset="0.45" stop-color="rgba(97,225,230,0.35)" />
              <stop offset="0.5" stop-color="rgba(97,225,230,0.85)" />
              <stop offset="0.55" stop-color="rgba(97,225,230,0.35)" />
              <stop offset="1" stop-color="rgba(97,225,230,0)" />
            </linearGradient>
          </defs>

          <!-- ================= ZONA 1: USM SAN JOAQUÍN ================= -->
          <g class="zone-map" data-zone="usm">
            <rect x="0" y="0" width="800" height="500" fill="#f0eadc" />
            <rect x="0" y="0" width="800" height="500" fill="url(#scalBlocks)" />

            <!-- Línea 5 Metro -->
            <line x1="90" y1="0" x2="90" y2="500" stroke="#88b04b" stroke-width="2.5" stroke-dasharray="8 6" opacity="0.7" />
            <text x="95" y="24" fill="#88b04b" font-family="Montserrat" font-size="8" font-weight="700" letter-spacing="0.5">METRO L5</text>

            <!-- Vicuña Mackenna (vertical principal) -->
            <line x1="145" y1="0" x2="145" y2="500" stroke="#151B20" stroke-width="12" />
            <line x1="145" y1="0" x2="145" y2="500" stroke="#FFF8EA" stroke-width="1.5" stroke-dasharray="10 8" opacity="0.55" />
            <text x="160" y="24" fill="#044559" font-family="Montserrat" font-size="8" font-weight="700" letter-spacing="0.5">AV. VICUÑA MACKENNA</text>

            <!-- Cruces horizontales -->
            <line x1="145" y1="180" x2="800" y2="180" stroke="#151B20" stroke-width="7" />
            <line x1="145" y1="180" x2="800" y2="180" stroke="#FFF8EA" stroke-width="1" stroke-dasharray="8 6" opacity="0.55" />
            <line x1="145" y1="380" x2="800" y2="380" stroke="#151B20" stroke-width="7" />
            <line x1="145" y1="380" x2="800" y2="380" stroke="#FFF8EA" stroke-width="1" stroke-dasharray="8 6" opacity="0.55" />

            <!-- Cruce vertical -->
            <line x1="500" y1="180" x2="500" y2="500" stroke="#151B20" stroke-width="6" />
            <line x1="700" y1="0" x2="700" y2="500" stroke="#151B20" stroke-width="6" />

            <!-- Campus USM (rounded rect) -->
            <rect x="240" y="205" width="360" height="150" fill="rgba(97, 225, 230, 0.12)" stroke="#61E1E6" stroke-width="1.5" stroke-dasharray="5 4" rx="6" />
            <text x="420" y="278" fill="#044559" font-family="Montserrat" font-size="12" font-weight="700" text-anchor="middle" letter-spacing="1">USM CAMPUS</text>
            <text x="420" y="295" fill="#044559" font-family="Montserrat" font-size="9" font-weight="600" text-anchor="middle" opacity="0.65">SAN JOAQUÍN</text>

            <text x="795" y="176" fill="#044559" font-size="8" text-anchor="end" opacity="0.55" font-family="Montserrat" font-weight="600">Blanco Encalada</text>
            <text x="795" y="376" fill="#044559" font-size="8" text-anchor="end" opacity="0.55" font-family="Montserrat" font-weight="600">Salvador Sanfuentes</text>
          </g>

          <!-- ================= ZONA 2: PUERTO SAN ANTONIO ================= -->
          <g class="zone-map" data-zone="sanantonio">
            <rect x="0" y="0" width="800" height="500" fill="url(#scalOcean)" />
            <path d="M 220 0 Q 195 90, 230 180 Q 195 260, 240 340 Q 210 420, 250 500 L 800 500 L 800 0 Z" fill="#f0eadc" />
            <rect x="220" y="0" width="580" height="500" fill="url(#scalBlocks)" opacity="0.6" />

            <!-- Terminales del puerto -->
            <g opacity="0.7">
              <rect x="240" y="45" width="30" height="16" fill="#044559" opacity="0.5" rx="1" />
              <rect x="240" y="65" width="30" height="16" fill="#044559" opacity="0.5" rx="1" />
              <rect x="240" y="85" width="30" height="16" fill="#044559" opacity="0.5" rx="1" />
              <rect x="273" y="55" width="30" height="16" fill="#044559" opacity="0.5" rx="1" />
              <rect x="273" y="75" width="30" height="16" fill="#044559" opacity="0.5" rx="1" />
            </g>

            <!-- Corredor logístico -->
            <line x1="230" y1="260" x2="800" y2="260" stroke="#151B20" stroke-width="15" />
            <line x1="230" y1="260" x2="800" y2="260" stroke="#FFF8EA" stroke-width="1.5" stroke-dasharray="12 8" opacity="0.55" />

            <!-- Ruta 78 (vertical) -->
            <line x1="620" y1="0" x2="620" y2="500" stroke="#151B20" stroke-width="9" />
            <line x1="620" y1="0" x2="620" y2="500" stroke="#FFF8EA" stroke-width="1" stroke-dasharray="10 8" opacity="0.55" />

            <!-- Rutas secundarias -->
            <line x1="230" y1="130" x2="800" y2="130" stroke="#151B20" stroke-width="6" opacity="0.85" />
            <line x1="240" y1="400" x2="800" y2="400" stroke="#151B20" stroke-width="6" opacity="0.85" />

            <text x="30" y="45" fill="#61E1E6" opacity="0.55" font-size="10" letter-spacing="1" font-family="Montserrat" font-weight="700">OCÉANO PACÍFICO</text>
            <text x="245" y="35" fill="#044559" font-size="8" font-weight="700" font-family="Montserrat" letter-spacing="0.5">PUERTO SAN ANTONIO</text>
            <text x="795" y="252" fill="#044559" font-size="8" text-anchor="end" font-weight="700" font-family="Montserrat" letter-spacing="0.5">CORREDOR LOGÍSTICO</text>
            <text x="628" y="20" fill="#044559" font-size="8" font-weight="700" font-family="Montserrat" opacity="0.7">RUTA 78</text>
          </g>

          <!-- ================= ZONA 3: CENTRO VALPARAÍSO ================= -->
          <g class="zone-map" data-zone="valparaiso">
            <rect x="0" y="0" width="800" height="500" fill="url(#scalOcean)" />
            <!-- Bahía irregular (Valparaíso frente al mar) -->
            <path d="M 0 0 L 800 0 L 800 90 Q 640 150, 500 100 Q 340 60, 180 130 Q 90 170, 0 140 Z" fill="url(#scalOcean)" />
            <path d="M 0 140 Q 90 170, 180 130 Q 340 60, 500 100 Q 640 150, 800 90 L 800 500 L 0 500 Z" fill="#f0eadc" />
            <rect x="0" y="140" width="800" height="360" fill="url(#scalBlocks)" opacity="0.5" />

            <!-- Calles irregulares del casco histórico -->
            <path d="M 60 200 Q 180 190, 300 220 T 550 240 L 750 270" stroke="#151B20" stroke-width="7" fill="none" />
            <path d="M 60 200 Q 180 190, 300 220 T 550 240 L 750 270" stroke="#FFF8EA" stroke-width="1" stroke-dasharray="8 6" fill="none" opacity="0.55" />

            <path d="M 40 320 L 250 310 Q 400 305, 500 340 L 780 370" stroke="#151B20" stroke-width="6" fill="none" />
            <path d="M 40 320 L 250 310 Q 400 305, 500 340 L 780 370" stroke="#FFF8EA" stroke-width="1" stroke-dasharray="8 6" fill="none" opacity="0.55" />

            <path d="M 90 440 L 780 440" stroke="#151B20" stroke-width="6" />

            <!-- Verticales cerros -->
            <line x1="220" y1="140" x2="220" y2="500" stroke="#151B20" stroke-width="5" opacity="0.8" />
            <line x1="450" y1="140" x2="450" y2="500" stroke="#151B20" stroke-width="5" opacity="0.8" />
            <line x1="620" y1="140" x2="620" y2="500" stroke="#151B20" stroke-width="5" opacity="0.8" />

            <!-- Plaza Sotomayor -->
            <circle cx="380" cy="285" r="26" fill="rgba(209, 235, 120, 0.35)" stroke="#88b04b" stroke-width="1.5" opacity="0.7" />
            <text x="380" y="288" fill="#044559" font-family="Montserrat" font-size="7" font-weight="700" text-anchor="middle" opacity="0.75">PLAZA</text>

            <text x="30" y="50" fill="#61E1E6" opacity="0.55" font-size="10" letter-spacing="1" font-family="Montserrat" font-weight="700">BAHÍA DE VALPARAÍSO</text>
            <text x="795" y="200" fill="#044559" font-size="8" text-anchor="end" font-weight="700" font-family="Montserrat" opacity="0.7">Cochrane</text>
            <text x="795" y="300" fill="#044559" font-size="8" text-anchor="end" font-weight="700" font-family="Montserrat" opacity="0.7">Prat</text>
            <text x="795" y="435" fill="#044559" font-size="8" text-anchor="end" font-weight="700" font-family="Montserrat" opacity="0.7">Blanco</text>
          </g>

          <!-- Polígono compartido (dinámico) -->
          <polygon class="scal-polygon" points="" fill="rgba(209, 235, 120, 0.20)" stroke="#D1EB78" stroke-width="2.5" stroke-dasharray="8 5" />

          <!-- Capa de análisis (scanner + vehículos) — clipped al polígono -->
          <g class="analysis-layer" clip-path="url(#zoneAnalysisClip)">
            <!-- Haz del scanner (translateY animado) -->
            <rect class="scan-beam" x="0" y="0" width="800" height="60" fill="url(#scanBeam)" />
            <!-- Grid overlay (patrón sutil que aparece durante análisis) -->
            <g class="scan-grid">
              <!-- Líneas horizontales y verticales cyan tenues -->
            </g>
            <!-- Vehículos animados dentro de la zona -->
            <g class="analysis-vehicles"></g>
          </g>

          <!-- Corner brackets en cada vértice del polígono (fuera del clip) -->
          <g class="scal-brackets"></g>

          <!-- Puntos colocados (dinámico) -->
          <g class="scal-points"></g>

          <!-- Ripples (dinámico) -->
          <g class="scal-ripples"></g>

          <!-- Cursor -->
          <g class="scal-cursor" transform="translate(40, 40)">
            <path
              d="M 0 0 L 14 12 L 8 13 L 12 21 L 9 22 L 5 14 L 0 18 Z"
              fill="#151B20"
              stroke="#FFF8EA"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
          </g>
        </svg>

        <!-- HUD principal + nombre de zona -->
        <div class="scal-hud">
          <span class="scal-hud-dot"></span>
          <span data-hud="text">ESPERANDO</span>
        </div>
        <div class="scal-zone-name">
          <span data-zone-name="name">—</span>
          <small data-zone-name="sub">—</small>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scalability {
    padding: 110px 0;
    background: rgba(3, 53, 68, 0.84);
    color: var(--cream);
  }
  .scal-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 600;
    color: var(--cyan);
    opacity: 0.9;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 34px;
    margin-top: 14px;
    line-height: 1.2;
    color: var(--cream);
  }
  .scal-lead {
    margin-top: 18px;
    font-size: 15px;
    color: rgba(255, 248, 234, 0.75);
    line-height: 1.55;
    max-width: 480px;
  }
  .scal-lead strong {
    color: var(--cream);
    font-weight: 700;
  }
  .scal-steps {
    list-style: none;
    padding: 0;
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .scal-steps li {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 14px;
    align-items: start;
  }
  .step-n {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--cyan);
    line-height: 1;
    padding-top: 2px;
    opacity: 0.9;
  }
  .scal-steps strong {
    font-family: var(--font-title);
    font-size: 15px;
    font-weight: 700;
    color: var(--cream);
    display: block;
  }
  .scal-steps p {
    margin-top: 3px;
    font-size: 13px;
    color: rgba(255, 248, 234, 0.7);
    line-height: 1.45;
  }

  /* Viewport */
  .scal-viewport {
    position: relative;
    background: var(--navy);
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 8 / 5;
  }
  .scal-map {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Zone maps: solo el activo visible */
  .zone-map {
    opacity: 0;
    transition: opacity 500ms ease;
    pointer-events: none;
  }
  .zone-map.active {
    opacity: 1;
  }

  .scal-cursor {
    pointer-events: none;
    will-change: transform;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
    transition: opacity 400ms ease;
  }
  .scal-cursor.hidden {
    opacity: 0;
  }

  .scal-polygon {
    opacity: 0;
    transition: opacity 500ms ease;
    filter: drop-shadow(0 0 6px rgba(209, 235, 120, 0.5));
  }
  .scal-polygon.visible {
    opacity: 1;
    animation: polygon-pulse 2.4s ease-in-out infinite;
  }
  @keyframes polygon-pulse {
    0%, 100% { filter: drop-shadow(0 0 4px rgba(209, 235, 120, 0.4)); }
    50% { filter: drop-shadow(0 0 14px rgba(209, 235, 120, 0.85)); }
  }

  /* ---- Capa de análisis (scanner + grid + vehículos) ---- */
  .analysis-layer {
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .analysis-layer.active {
    opacity: 1;
  }
  .scan-beam {
    transform: translateY(-60px);
    opacity: 0;
  }
  .analysis-layer.active .scan-beam {
    animation: scan-sweep 2.4s ease-in-out infinite;
    opacity: 1;
  }
  @keyframes scan-sweep {
    0%   { transform: translateY(-60px); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translateY(500px); opacity: 0; }
  }
  .analysis-vehicles :global(rect.car) {
    fill: var(--cyan);
    stroke: rgba(0, 0, 0, 0.35);
    stroke-width: 0.5;
  }
  .analysis-vehicles :global(rect.truck) {
    fill: var(--lime);
    stroke: rgba(0, 0, 0, 0.35);
    stroke-width: 0.5;
  }

  /* Corner brackets — marcadores en vértices del polígono */
  .scal-brackets :global(path) {
    stroke: var(--cyan);
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    filter: drop-shadow(0 0 4px rgba(97, 225, 230, 0.6));
    transition: opacity 300ms ease;
  }
  .scal-brackets.visible :global(path) {
    opacity: 1;
  }

  /* HUD */
  .scal-hud {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(21, 27, 32, 0.78);
    backdrop-filter: blur(8px);
    border-radius: 100px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--cyan);
    border: 1px solid rgba(97, 225, 230, 0.3);
    pointer-events: none;
  }
  .scal-hud-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
    animation: scal-hud-pulse 1.2s ease-in-out infinite;
  }
  @keyframes scal-hud-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }

  /* Nombre de zona (top-right, cambia al rotar) */
  .scal-zone-name {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 8px 14px;
    background: rgba(21, 27, 32, 0.78);
    backdrop-filter: blur(8px);
    border-radius: 8px;
    border: 1px solid rgba(97, 225, 230, 0.25);
    line-height: 1.2;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .scal-zone-name span {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--cream);
    letter-spacing: 0.3px;
  }
  .scal-zone-name small {
    font-family: var(--font-sans);
    font-size: 9.5px;
    color: rgba(255, 248, 234, 0.55);
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-top: 2px;
  }
  .scal-zone-name.fading {
    opacity: 0;
  }

  @media (max-width: 860px) {
    .scal-grid { grid-template-columns: 1fr; gap: 32px; }
    .scal-viewport { aspect-ratio: 4 / 3; }
    h2 { font-size: 26px; }

    /* HUD y zone-name apilados verticalmente para no chocar en pantalla
       angosta. Antes ambos estaban en top:16 y colisionaban. */
    .scal-hud {
      top: 10px;
      left: 10px;
      padding: 5px 10px;
      font-size: 9px;
      letter-spacing: 1.2px;
    }
    .scal-zone-name {
      top: 48px;
      right: 10px;
      padding: 6px 10px;
      max-width: 62%;
    }
    .scal-zone-name span { font-size: 11px; }
    .scal-zone-name small { font-size: 8.5px; letter-spacing: 0.3px; }
  }
</style>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';

  const svg = document.querySelector<SVGSVGElement>('.scal-map');
  const cursor = svg?.querySelector<SVGGElement>('.scal-cursor');
  const pointsGroup = svg?.querySelector<SVGGElement>('.scal-points');
  const ripplesGroup = svg?.querySelector<SVGGElement>('.scal-ripples');
  const polygon = svg?.querySelector<SVGPolygonElement>('.scal-polygon');
  const analysisClipPoly = svg?.querySelector<SVGPolygonElement>('.analysis-clip-poly');
  const analysisLayer = svg?.querySelector<SVGGElement>('.analysis-layer');
  const vehiclesGroup = svg?.querySelector<SVGGElement>('.analysis-vehicles');
  const bracketsGroup = svg?.querySelector<SVGGElement>('.scal-brackets');
  const zoneMaps = svg?.querySelectorAll<SVGGElement>('.zone-map');
  const hudText = document.querySelector<HTMLElement>('.scal-hud [data-hud="text"]');
  const zoneName = document.querySelector<HTMLElement>('.scal-zone-name');
  const zoneNameText = document.querySelector<HTMLElement>('[data-zone-name="name"]');
  const zoneNameSub = document.querySelector<HTMLElement>('[data-zone-name="sub"]');

  interface Zone {
    id: string;
    name: string;
    sub: string;
    startCursor: { x: number; y: number };
    points: Array<{ x: number; y: number }>;
    vehicles: Array<{
      kind: 'car' | 'truck';
      path: Array<{ x: number; y: number }>;
      offset: number;
      speed: number;
    }>;
  }

  // 3 zonas reales — cada una con diferente número de puntos + vehículos
  const ZONES: Zone[] = [
    {
      id: 'usm',
      name: 'USM Campus San Joaquín',
      sub: 'Santiago · Zona triangular',
      startCursor: { x: 55, y: 65 },
      // Triángulo AMPLIADO — abarca el campus + calles circundantes
      // (antes era muy chico y parecía solo el campus)
      points: [
        { x: 140, y: 155 }, // NW
        { x: 690, y: 165 }, // NE
        { x: 420, y: 445 }, // S (vertex inferior)
      ],
      // Todos los paths van SOBRE calles visibles del mapa
      vehicles: [
        // Blanco Encalada (y=180) — dos autos yendo al este
        { kind: 'car', path: [{ x: 160, y: 180 }, { x: 680, y: 180 }], offset: 0.12, speed: 0.028 },
        { kind: 'car', path: [{ x: 160, y: 180 }, { x: 680, y: 180 }], offset: 0.62, speed: 0.028 },
        // Blanco Encalada — un auto yendo al oeste
        { kind: 'car', path: [{ x: 680, y: 180 }, { x: 160, y: 180 }], offset: 0.35, speed: 0.028 },
        // Cross vertical x=500 (visible en el mapa) — sur
        { kind: 'car', path: [{ x: 500, y: 175 }, { x: 500, y: 380 }], offset: 0.20, speed: 0.024 },
        { kind: 'car', path: [{ x: 500, y: 175 }, { x: 500, y: 380 }], offset: 0.70, speed: 0.024 },
        // Salvador Sanfuentes (y=380) — segmento corto visible en la parte baja del triángulo
        { kind: 'car', path: [{ x: 370, y: 380 }, { x: 480, y: 380 }], offset: 0.30, speed: 0.024 },
      ],
    },
    {
      id: 'sanantonio',
      name: 'Corredor Logístico',
      sub: 'Puerto San Antonio · 4 vértices',
      startCursor: { x: 300, y: 30 },
      points: [
        { x: 240, y: 195 },
        { x: 720, y: 190 },
        { x: 720, y: 350 },
        { x: 260, y: 335 },
      ],
      // Solo sobre las calles visibles dentro del polígono
      vehicles: [
        // Corredor logístico (y=260) — 3 camiones + 1 auto al este
        { kind: 'truck', path: [{ x: 230, y: 260 }, { x: 780, y: 260 }], offset: 0.08, speed: 0.022 },
        { kind: 'truck', path: [{ x: 230, y: 260 }, { x: 780, y: 260 }], offset: 0.40, speed: 0.022 },
        { kind: 'truck', path: [{ x: 230, y: 260 }, { x: 780, y: 260 }], offset: 0.72, speed: 0.022 },
        // Corredor en sentido opuesto — 1 camión + 1 auto al oeste
        { kind: 'car',   path: [{ x: 780, y: 260 }, { x: 230, y: 260 }], offset: 0.22, speed: 0.028 },
        { kind: 'truck', path: [{ x: 780, y: 260 }, { x: 230, y: 260 }], offset: 0.58, speed: 0.022 },
        // Ruta 78 vertical (x=620) — cruzan el corredor
        { kind: 'truck', path: [{ x: 620, y: 195 }, { x: 620, y: 350 }], offset: 0.35, speed: 0.022 },
      ],
    },
    {
      id: 'valparaiso',
      name: 'Centro Histórico',
      sub: 'Valparaíso · Pentágono irregular',
      startCursor: { x: 65, y: 155 },
      // Pentágono AMPLIADO — abarca los 3 corredores: Cochrane (y≈220),
      // Prat (y≈310-340), y las verticales de los cerros (x=220, 450).
      // Antes era muy chico y dejaba Cochrane afuera por arriba.
      points: [
        { x: 130, y: 195 }, // NW (bajo la costa)
        { x: 620, y: 195 }, // NE
        { x: 720, y: 320 }, // E
        { x: 540, y: 430 }, // SE (sobre Blanco)
        { x: 150, y: 405 }, // SW
      ],
      // Vehículos alineados con las calles visibles Y dentro del polígono.
      // Cochrane y Prat son curvas Bézier en el mapa — muestreadas en
      // múltiples waypoints para que los vehículos las sigan visualmente.
      vehicles: [
        // Cochrane (curva) al este — sigue la Bézier Q/T de la calle
        {
          kind: 'car',
          path: [
            { x: 200, y: 202 }, { x: 250, y: 209 }, { x: 300, y: 220 },
            { x: 350, y: 231 }, { x: 400, y: 238 }, { x: 450, y: 241 },
            { x: 500, y: 242 }, { x: 550, y: 240 }, { x: 600, y: 248 },
          ],
          offset: 0.15,
          speed: 0.028,
        },
        // Cochrane al oeste — misma curva invertida
        {
          kind: 'car',
          path: [
            { x: 600, y: 248 }, { x: 550, y: 240 }, { x: 500, y: 242 },
            { x: 450, y: 241 }, { x: 400, y: 238 }, { x: 350, y: 231 },
            { x: 300, y: 220 }, { x: 250, y: 209 }, { x: 200, y: 202 },
          ],
          offset: 0.55,
          speed: 0.028,
        },
        // Prat al este — auto (curva L→Q→L de la calle)
        {
          kind: 'car',
          path: [
            { x: 200, y: 312 }, { x: 250, y: 310 }, { x: 300, y: 310 },
            { x: 350, y: 311 }, { x: 400, y: 316 }, { x: 450, y: 326 },
            { x: 500, y: 340 }, { x: 560, y: 346 }, { x: 620, y: 353 },
          ],
          offset: 0.20,
          speed: 0.026,
        },
        // Prat al este — camión (carga del puerto pasando por el centro)
        {
          kind: 'truck',
          path: [
            { x: 200, y: 312 }, { x: 250, y: 310 }, { x: 300, y: 310 },
            { x: 350, y: 311 }, { x: 400, y: 316 }, { x: 450, y: 326 },
            { x: 500, y: 340 }, { x: 560, y: 346 }, { x: 620, y: 353 },
          ],
          offset: 0.70,
          speed: 0.022,
        },
        // Vertical x=220 (cerro) al sur — recta
        { kind: 'car', path: [{ x: 220, y: 210 }, { x: 220, y: 395 }], offset: 0.30, speed: 0.024 },
        // Vertical x=450 (cerro central) al sur — recta
        { kind: 'car', path: [{ x: 450, y: 210 }, { x: 450, y: 415 }], offset: 0.60, speed: 0.024 },
      ],
    },
  ];

  const MOVE_DURATION = 720;
  const WAIT_AT_POINT = 350;
  const WAIT_RECOGNITION = 1600;    // tiempo del "análisis" antes de spawnear vehículos
  const WAIT_TRAFFIC = 4200;        // vehículos circulando en la zona
  const WAIT_BETWEEN_ZONES = 900;

  let zoneIdx = 0;
  let stepIdx = 0;
  let phase: 'moving' | 'waiting' = 'waiting';
  let phaseStart = 0;
  let placedPoints: Array<{ x: number; y: number }> = [];
  let rafId = 0;
  let lastTs = 0;

  interface RuntimeVehicle {
    el: SVGRectElement;
    path: Array<{ x: number; y: number }>;
    offset: number;
    speed: number;
    progress: number;
    kind: 'car' | 'truck';
  }
  let runtimeVehicles: RuntimeVehicle[] = [];

  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  const setCursorPos = (x: number, y: number) => {
    if (cursor) cursor.setAttribute('transform', `translate(${x}, ${y})`);
  };
  const setHud = (text: string) => {
    if (hudText) hudText.textContent = text;
  };

  const showZoneMap = (id: string) => {
    zoneMaps?.forEach((g) => {
      if (g.dataset.zone === id) g.classList.add('active');
      else g.classList.remove('active');
    });
  };
  const setZoneNameText = (zone: Zone) => {
    if (zoneNameText) zoneNameText.textContent = zone.name;
    if (zoneNameSub) zoneNameSub.textContent = zone.sub;
  };

  const spawnRipple = (x: number, y: number) => {
    if (!ripplesGroup) return;
    const ring = document.createElementNS(SVG_NS, 'circle');
    ring.setAttribute('cx', String(x));
    ring.setAttribute('cy', String(y));
    ring.setAttribute('r', '3');
    ring.setAttribute('fill', 'none');
    ring.setAttribute('stroke', '#61E1E6');
    ring.setAttribute('stroke-width', '2');
    ring.style.opacity = '0.9';
    ring.style.transition = 'r 700ms ease-out, opacity 700ms ease-out, stroke-width 700ms ease-out';
    ripplesGroup.appendChild(ring);
    requestAnimationFrame(() => {
      ring.setAttribute('r', '38');
      ring.style.opacity = '0';
      ring.style.strokeWidth = '0.5';
    });
    window.setTimeout(() => ring.remove(), 800);
  };

  const placePoint = (x: number, y: number, num: number) => {
    if (!pointsGroup) return;
    const g = document.createElementNS(SVG_NS, 'g');
    g.style.opacity = '0';
    g.style.transition = 'opacity 220ms ease';

    const circle = document.createElementNS(SVG_NS, 'circle');
    circle.setAttribute('cx', String(x));
    circle.setAttribute('cy', String(y));
    circle.setAttribute('r', '10');
    circle.setAttribute('fill', '#61E1E6');
    circle.setAttribute('stroke', '#033544');
    circle.setAttribute('stroke-width', '2');
    circle.style.filter = 'drop-shadow(0 0 6px rgba(97, 225, 230, 0.7))';

    const text = document.createElementNS(SVG_NS, 'text');
    text.setAttribute('x', String(x));
    text.setAttribute('y', String(y));
    text.setAttribute('fill', '#033544');
    text.setAttribute('font-family', 'Montserrat, sans-serif');
    text.setAttribute('font-size', '10');
    text.setAttribute('font-weight', '700');
    text.setAttribute('text-anchor', 'middle');
    text.setAttribute('dominant-baseline', 'central');
    text.textContent = String(num);

    g.appendChild(circle);
    g.appendChild(text);
    pointsGroup.appendChild(g);
    requestAnimationFrame(() => { g.style.opacity = '1'; });
  };

  const clearPointsAndPolygon = () => {
    if (pointsGroup) pointsGroup.innerHTML = '';
    placedPoints = [];
    if (polygon) {
      polygon.setAttribute('points', '');
      polygon.classList.remove('visible');
    }
    if (analysisClipPoly) analysisClipPoly.setAttribute('points', '');
    analysisLayer?.classList.remove('active');
    bracketsGroup?.classList.remove('visible');
    if (bracketsGroup) bracketsGroup.innerHTML = '';
    if (vehiclesGroup) vehiclesGroup.innerHTML = '';
    runtimeVehicles = [];
  };

  // Longitud total de una polilínea
  const pathLength = (path: Array<{ x: number; y: number }>) => {
    let t = 0;
    for (let i = 1; i < path.length; i++) t += Math.hypot(path[i].x - path[i - 1].x, path[i].y - path[i - 1].y);
    return t;
  };
  // Punto e ángulo sobre una polilínea según progress 0..1
  const pathPoint = (path: Array<{ x: number; y: number }>, progress: number) => {
    const total = pathLength(path);
    const target = progress * total;
    let acc = 0;
    for (let i = 1; i < path.length; i++) {
      const dx = path[i].x - path[i - 1].x;
      const dy = path[i].y - path[i - 1].y;
      const seg = Math.hypot(dx, dy);
      if (acc + seg >= target) {
        const t = (target - acc) / seg;
        return {
          p: { x: path[i - 1].x + dx * t, y: path[i - 1].y + dy * t },
          angle: (Math.atan2(dy, dx) * 180) / Math.PI,
        };
      }
      acc += seg;
    }
    return { p: path[path.length - 1], angle: 0 };
  };

  // Genera los brackets (L-shapes) en cada vértice del polígono actual
  const spawnBrackets = () => {
    if (!bracketsGroup) return;
    bracketsGroup.innerHTML = '';
    placedPoints.forEach((p) => {
      const path = document.createElementNS(SVG_NS, 'path');
      // L-shape brackets rotadas para dar sensación de "target lock"
      path.setAttribute('d', `M ${p.x - 8} ${p.y - 2} L ${p.x - 8} ${p.y - 8} L ${p.x - 2} ${p.y - 8} M ${p.x + 2} ${p.y - 8} L ${p.x + 8} ${p.y - 8} L ${p.x + 8} ${p.y - 2} M ${p.x + 8} ${p.y + 2} L ${p.x + 8} ${p.y + 8} L ${p.x + 2} ${p.y + 8} M ${p.x - 2} ${p.y + 8} L ${p.x - 8} ${p.y + 8} L ${p.x - 8} ${p.y + 2}`);
      bracketsGroup.appendChild(path);
    });
  };

  const spawnVehicles = (zone: Zone) => {
    if (!vehiclesGroup) return;
    vehiclesGroup.innerHTML = '';
    runtimeVehicles = zone.vehicles.map((v) => {
      const el = document.createElementNS(SVG_NS, 'rect');
      el.setAttribute('class', v.kind);
      el.setAttribute('width', v.kind === 'truck' ? '18' : '9');
      el.setAttribute('height', v.kind === 'truck' ? '7' : '5');
      el.setAttribute('rx', '1');
      vehiclesGroup.appendChild(el);
      return { el, path: v.path, offset: v.offset, speed: v.speed, progress: v.offset, kind: v.kind };
    });
  };

  const tickVehicles = (dt: number) => {
    runtimeVehicles.forEach((v) => {
      v.progress += v.speed * (dt / 100);
      if (v.progress > 1) v.progress -= 1;
      const { p, angle } = pathPoint(v.path, v.progress);
      const w = v.kind === 'truck' ? 18 : 9;
      const h = v.kind === 'truck' ? 7 : 5;
      v.el.setAttribute('x', String(p.x - w / 2));
      v.el.setAttribute('y', String(p.y - h / 2));
      v.el.setAttribute('transform', `rotate(${angle} ${p.x} ${p.y})`);
    });
  };

  const startZone = (idx: number) => {
    const zone = ZONES[idx];
    zoneIdx = idx;
    stepIdx = 0;
    clearPointsAndPolygon();
    setCursorPos(zone.startCursor.x, zone.startCursor.y);
    cursor?.classList.remove('hidden');
    zoneName?.classList.remove('fading');
    showZoneMap(zone.id);
    setZoneNameText(zone);
    setHud(`ANALIZANDO · ${zone.sub.split(' · ')[0].toUpperCase()}`);
    // IMPORTANTE: iniciar en 'moving' — así el tick empieza moviendo el cursor
    // desde startCursor hacia points[0]. Con 'waiting' se saltaba el primer
    // click porque el waiting-phase avanza stepIdx sin hacer click.
    phase = 'moving';
    phaseStart = performance.now();
  };

  const doClickAt = (x: number, y: number) => {
    spawnRipple(x, y);
    placedPoints.push({ x, y });
    placePoint(x, y, placedPoints.length);
    if (polygon) polygon.setAttribute('points', placedPoints.map((p) => `${p.x},${p.y}`).join(' '));
  };

  const revealPolygon = () => {
    polygon?.classList.add('visible');
    // Copiar el polígono al clipPath para restringir scanner + vehículos
    if (analysisClipPoly && polygon) {
      analysisClipPoly.setAttribute('points', polygon.getAttribute('points') ?? '');
    }
    // Activar capa de análisis (scanner empieza a barrer)
    analysisLayer?.classList.add('active');
    // Spawn brackets sobre vértices con fade
    spawnBrackets();
    // Pequeño delay para que el CSS transition detecte el cambio
    requestAnimationFrame(() => bracketsGroup?.classList.add('visible'));
  };

  const startTraffic = () => {
    const zone = ZONES[zoneIdx];
    spawnVehicles(zone);
  };

  const fadeOutZone = () => {
    cursor?.classList.add('hidden');
    zoneName?.classList.add('fading');
  };

  const tick = (ts: number) => {
    const zone = ZONES[zoneIdx];
    const elapsed = ts - phaseStart;
    const dt = lastTs ? Math.min(ts - lastTs, 50) : 16;
    lastTs = ts;

    // Vehículos siempre se animan si hay (durante fase de tráfico)
    if (runtimeVehicles.length > 0) tickVehicles(dt);

    // Steps:
    //   0..N-1  = mover al punto N y hacer click
    //   N       = reveal polygon (aparece scanner + brackets)
    //   N+1     = fase RECOGNITION (análisis visual sin vehículos aún)
    //   N+2     = fase TRAFFIC (spawn vehículos, siguen corriendo)
    //   N+3     = fade out, esperar, avanzar zona
    const revealStep = zone.points.length;
    const recognitionStep = zone.points.length + 1;
    const trafficStep = zone.points.length + 2;
    const fadeStep = zone.points.length + 3;

    if (stepIdx < zone.points.length) {
      const targetPoint = zone.points[stepIdx];
      const prevPoint = stepIdx === 0 ? zone.startCursor : zone.points[stepIdx - 1];

      if (phase === 'moving') {
        if (elapsed >= MOVE_DURATION) {
          setCursorPos(targetPoint.x, targetPoint.y);
          doClickAt(targetPoint.x, targetPoint.y);
          setHud(`PUNTO ${stepIdx + 1} / ${zone.points.length}`);
          phase = 'waiting';
          phaseStart = ts;
        } else {
          const t = easeOutCubic(elapsed / MOVE_DURATION);
          setCursorPos(lerp(prevPoint.x, targetPoint.x, t), lerp(prevPoint.y, targetPoint.y, t));
        }
      } else if (elapsed >= WAIT_AT_POINT) {
        stepIdx++;
        phase = 'moving';
        phaseStart = ts;
      }
    } else if (stepIdx === revealStep) {
      // Reveal polygon + activar análisis
      revealPolygon();
      cursor?.classList.add('hidden'); // ocultar cursor durante análisis
      setHud(`ANALIZANDO ZONA · ${zone.points.length} VÉRTICES`);
      stepIdx++;
      phase = 'waiting';
      phaseStart = ts;
    } else if (stepIdx === recognitionStep) {
      // Fase de reconocimiento visual (solo scanner + brackets, sin vehículos)
      if (elapsed >= WAIT_RECOGNITION) {
        startTraffic();
        setHud('TRÁFICO DETECTADO');
        stepIdx++;
        phase = 'waiting';
        phaseStart = ts;
      }
    } else if (stepIdx === trafficStep) {
      // Fase de tráfico — vehículos circulando en la zona
      if (elapsed >= WAIT_TRAFFIC) {
        fadeOutZone();
        setHud('SIGUIENTE ZONA…');
        stepIdx++;
        phase = 'waiting';
        phaseStart = ts;
      }
    } else if (stepIdx === fadeStep) {
      if (elapsed >= WAIT_BETWEEN_ZONES) {
        const nextZone = (zoneIdx + 1) % ZONES.length;
        startZone(nextZone);
      }
    }

    rafId = requestAnimationFrame(tick);
  };

  if (svg && cursor && pointsGroup && polygon && zoneMaps) {
    startZone(0);
    rafId = requestAnimationFrame(tick);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else {
        phaseStart = performance.now();
        rafId = requestAnimationFrame(tick);
      }
    });
  }
</script>
