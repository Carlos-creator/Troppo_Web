---
// Sección "¿Cómo se ve?" — laptop que "se enciende" al entrar al viewport
// y muestra en su pantalla un video real de la interfaz de Troppo
// (public/videos/interfaz_troppo.mp4, 1920×1080, zona útil 1920×946) en bucle, silenciado y
// sin controles: es sólo demostrativo.
//   - Animaciones: tapa se abre, splash con el logo, aparece el video.
// Sección de fondo claro (beige).
---

<section class="dashboard-section sec-light">
  <div class="wrap">
    <div class="dash-head">
      <div class="eyebrow sec-title">¿Cómo se ve?</div>
      <h2 class="sec-subtitle">Herramientas integradas para gestionar la red vial.</h2>
      <p>
        La aplicación de Troppo reúne las herramientas necesarias para
        configurar y ejecutar simulaciones, analizar resultados, iniciar
        procesos de optimización con IA y monitorear la red vial mediante el
        gemelo digital. Está diseñada para <strong>instalarse y ejecutarse en
        los computadores del cliente</strong>.
      </p>
    </div>

    <div class="rd-stage">
      <!-- ================= LAPTOP ================= -->
      <div class="rd-laptop" aria-hidden="true">
        <div class="rd-lid">
          <span class="rd-cam"></span>
          <div class="rd-display">
            <!-- Boot splash: logo Troppo beige sobre cyan oscuro que
                 aparece al "encender" el laptop y se desvanece para
                 revelar el video. -->
            <div class="rd-boot" aria-hidden="true">
              <img src="/images/logo/logo_troppo_beige_grande.png" alt="" />
            </div>
            <!-- Video de la interfaz de Troppo: demostración en bucle,
                 silenciado, sin controles ni interacción. Se carga y
                 reproduce sólo cuando la sección se acerca al viewport. -->
            <video
              class="rd-video"
              src="/videos/interfaz_troppo.mp4"
              muted
              loop
              playsinline
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              controlslist="nodownload nofullscreen noremoteplayback noplaybackrate"
              tabindex="-1"
              aria-hidden="true"
            ></video>
          </div>
        </div>
        <div class="rd-hinge"></div>
        <div class="rd-base"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .dashboard-section {
    padding: 110px 0;
    background: rgba(255, 248, 234, 0.72);
    color: var(--ink);
  }
  .dash-head {
    max-width: 640px;
    margin-bottom: 60px;
  }
  h2 {
    margin-top: 14px;
  }
  .dash-head p {
    margin-top: 16px;
    font-size: 15px;
    color: rgba(21, 27, 32, 0.75);
    max-width: 520px;
  }

  /* ========================================================
     STAGE — contenedor con perspectiva para la animación
     ======================================================== */
  .rd-stage {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    /* Sin celular: el laptop queda centrado y sin reserva lateral */
    padding: 40px 0;
    perspective: 1100px;
    perspective-origin: 50% 35%;
  }
  .rd-stage::after {
    /* sombra de contacto bajo laptop */
    content: '';
    position: absolute;
    bottom: 20px;
    left: 15%;
    right: 15%;
    height: 22px;
    background: radial-gradient(ellipse at center, rgba(4, 69, 89, 0.28), transparent 70%);
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
  }

  /* ========================================================
     LAPTOP
     ======================================================== */
  .rd-laptop {
    position: relative;
    z-index: 1;
    /* Grande para que la interfaz del video se lea bien; nunca más ancho
       que el contenedor (en pantallas chicas ocupa el 100%). */
    width: min(1060px, 100%);
    margin: 0 auto;
    filter: drop-shadow(0 30px 40px rgba(4, 69, 89, 0.18));
  }
  .rd-lid {
    position: relative;
    background: #1a1c20;
    border: 3px solid #0b0d10;
    border-radius: 12px 12px 3px 3px;
    padding: 14px 14px 10px;
    transform-origin: 50% 100%;
  }
  .rd-cam {
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2a2c30;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    z-index: 7;
  }
  .rd-display {
    position: relative;
    overflow: hidden;
    background: #0b0d10;
    border-radius: 2px;
    /* La grabación (1920×1080) trae franjas negras propias: 82px arriba y
       52px abajo. La pantalla toma la proporción de la zona útil
       (1920×946) para que el video la llene sin franjas ni recortes
       laterales. */
    aspect-ratio: 1920 / 946;
  }
  /* Video demostrativo de la interfaz: ancho completo y desplazado hacia
     arriba lo justo para que las franjas queden fuera (overflow hidden del
     display). Sin controles ni interacción (pointer-events: none). */
  .rd-video {
    position: absolute;
    left: 0;
    top: calc(-82 / 946 * 100%);
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    display: block;
    pointer-events: none;
    user-select: none;
  }
  .rd-display::after {
    /* Overlay sutil de reflejo en pantalla */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.05) 0%, transparent 40%);
    pointer-events: none;
    z-index: 6;
  }

  /* ============ BOOT SPLASH (laptop) ============
     Logo Troppo beige sobre cyan bien oscuro. Aparece cuando "se
     enciende" el dispositivo y se desvanece para revelar el video. */
  .rd-boot {
    position: absolute;
    inset: 0;
    background: #022a37;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    opacity: 0;
    pointer-events: none;
  }
  .rd-boot img {
    max-width: 62%;
    max-height: 62%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 0 20px rgba(97, 225, 230, 0.15));
  }
  /* Splash del LAPTOP: fade-in + hold + fade-out. Como el lid está
     cerrado hasta t≈1700ms no hay problema de flash del contenido. */
  .rd-stage:not(.pre):not(.exiting) .rd-boot {
    animation: rd-boot-splash 2400ms ease-in-out 500ms forwards;
  }
  @keyframes rd-boot-splash {
    0%   { opacity: 0; }
    12%  { opacity: 1; }
    72%  { opacity: 1; }
    100% { opacity: 0; }
  }
  .rd-hinge {
    height: 8px;
    background: linear-gradient(#a3a8ad, #c6cacd 45%, #9ba1a6);
    border-radius: 0 0 4px 4px;
  }
  .rd-base {
    position: relative;
    height: 12px;
    background: linear-gradient(#e5e7ea, #b8bdc1 40%, #909499);
    border-radius: 0 0 24px 24px;
    margin: 0 -12px;
  }
  .rd-base::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 90px;
    height: 4px;
    background: rgba(4, 69, 89, 0.25);
    border-radius: 0 0 6px 6px;
  }

  /* ========================================================
     ANIMACIONES — usa transitions con delays (más robusto que
     @keyframes + fill:both para persistir el estado final).
     La clase .pre aplica el estado inicial oculto.
     Al remover .pre, las transitions llevan al estado visible.
     ======================================================== */

  /* Transición de la tapa en el estado normal */
  .rd-lid {
    transition: transform 1400ms cubic-bezier(0.4, 0.05, 0.25, 1);
    transform: rotateX(0deg);
  }

  /* Estado oculto — compartido por .pre (mount inicial) y .exiting
     (cuando la sección sale del viewport tras scroll). La diferencia:
     .pre añade transition-duration:0s para SNAP inmediato al montar;
     .exiting deja las transitions naturales para animar el cierre. */
  .rd-stage.pre .rd-lid,
  .rd-stage.exiting .rd-lid {
    transform: rotateX(-92deg);
  }

  /* Snap instantáneo sólo en el mount inicial (.pre) */
  .rd-stage.pre .rd-lid {
    transition-duration: 0s;
  }

  /* Delays de ENTRADA (revelado) — sin .pre ni .exiting */
  .rd-stage:not(.pre):not(.exiting) .rd-lid {
    transition-delay: 300ms;
  }

  /* Cierre (.exiting): la tapa se cierra */
  .rd-stage.exiting .rd-lid {
    transition-delay: 550ms;
    transition-duration: 900ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .rd-stage.pre .rd-lid,
    .rd-stage.exiting .rd-lid {
      transform: none;
      opacity: 1;
    }
    /* Sin splash animado — se oculta directo */
    .rd-boot { display: none; }
  }

  @media (max-width: 860px) {
    .rd-stage {
      padding: 20px 0 0;
    }
    .rd-stage::after { display: none; }
  }
</style>

<script>
  import { observeReveal } from '../scripts/reveal';
  // Modelo: .rd-stage arranca con clase .pre (oculto instantáneamente).
  // Cuando entra al viewport, se remueve .pre → CSS transitions se disparan
  // con sus delays escalonados hacia el estado natural (visible).
  //
  // Este enfoque es más robusto que @keyframes con fill:both porque las
  // transitions naturalmente persisten al estado final (no dependen de que
  // el navegador respete correctamente el fill mode contra la cascada).
  //
  // Video: queda detenido en su primer fotograma mientras el laptop se
  // abre y arranca recién cuando termina la apertura: la transición de la
  // tapa (transitionend) Y el splash del logo (animationend). Sin tiempos
  // fijos. Al cerrarse el laptop se pausa; si el visitante vuelve, sigue
  // desde donde quedó (no se reinicia).
  const stage = document.querySelector<HTMLElement>('.rd-stage');
  const lid = stage?.querySelector<HTMLElement>('.rd-lid');
  const boot = stage?.querySelector<HTMLElement>('.rd-boot');
  const video = stage?.querySelector<HTMLVideoElement>('.rd-video');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Control del video ----
  let opened = false; // true cuando la apertura del laptop terminó
  let cycle = 0; // identifica cada apertura (descarta eventos viejos)
  let cleanupOpen: (() => void) | null = null;
  let fallbackArmed = false;

  const play = () => {
    video?.play().catch(armFallback);
  };
  const sync = () => {
    if (!video) return;
    if (opened && !document.hidden) {
      if (video.paused) play();
    } else if (!video.paused) {
      video.pause();
    }
  };
  // Si el navegador bloquea el autoplay (p. ej. modo ahorro de energía),
  // la demostración arranca con la primera interacción del visitante en
  // cualquier parte de la página, sin mostrar controles.
  function armFallback() {
    if (fallbackArmed || !video) return;
    fallbackArmed = true;
    const events = ['pointerdown', 'touchstart', 'keydown', 'scroll'] as const;
    const resume = () => {
      if (!opened) return;
      video.play().then(() => {
        events.forEach((ev) => window.removeEventListener(ev, resume));
        fallbackArmed = false;
      }).catch(() => {});
    };
    events.forEach((ev) => window.addEventListener(ev, resume, { passive: true }));
  }

  // Apertura: espera a que terminen la tapa y el splash del logo.
  const onOpenStart = () => {
    cleanupOpen?.();
    opened = false;
    sync();
    if (!lid || !boot || reducedMotion) {
      // Sin animación (movimiento reducido): no hay eventos que esperar.
      opened = true;
      sync();
      return;
    }
    const myCycle = ++cycle;
    let lidDone = false;
    let bootDone = false;
    const check = () => {
      if (myCycle !== cycle || !lidDone || !bootDone) return;
      cleanupOpen?.();
      opened = true;
      sync();
    };
    const onLid = (e: TransitionEvent) => {
      if (e.target === lid && e.propertyName === 'transform') { lidDone = true; check(); }
    };
    const onBoot = (e: AnimationEvent) => {
      if (e.target === boot) { bootDone = true; check(); }
    };
    lid.addEventListener('transitionend', onLid);
    boot.addEventListener('animationend', onBoot);
    cleanupOpen = () => {
      lid.removeEventListener('transitionend', onLid);
      boot.removeEventListener('animationend', onBoot);
      cleanupOpen = null;
    };
  };
  // Cierre: pausa el video (conserva la posición) e invalida la apertura.
  const onClose = () => {
    cycle++;
    cleanupOpen?.();
    opened = false;
    sync();
  };

  if (video) {
    video.muted = true;
    // Si algo lo pausa (teclas multimedia, sistema) mientras está abierto,
    // se reanuda: el visitante no puede detener la demostración.
    video.addEventListener('pause', () => {
      if (opened && !document.hidden) play();
    });
    document.addEventListener('visibilitychange', sync);
    // Precarga cuando la sección se acerca (el archivo pesa ~37 MB): así el
    // primer fotograma ya está listo mientras el laptop se abre. Se observa
    // el escenario (sin transform) y no el video: con la tapa cerrada
    // (rotateX) el video no ocupa área y el observer no lo detectaría.
    if ('IntersectionObserver' in window) {
      const preloadIO = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          video.preload = 'auto';
          video.load();
          preloadIO.disconnect();
        },
        { rootMargin: '800px 0px' },
      );
      preloadIO.observe(stage ?? video);
    } else {
      video.preload = 'auto';
    }
  }

  if (stage) {
    // Mount: aplicar .pre para snap-hidden inmediato antes del primer paint
    stage.classList.add('pre');

    if ('IntersectionObserver' in window) {
      // Observer bidireccional: al entrar quita .pre/.exiting → coreografía
      // de apertura. Al salir agrega .exiting → coreografía de cierre inversa.
      // No hacemos unobserve — queremos que reaccione en cada scroll pasada.
      // Histéresis: abre al superar el 20% visible (como antes) y cierra
      // cuando baja del 20% dentro de una zona 60px más amplia por arriba
      // y por abajo. El cierre sigue viéndose (con el escenario aún
      // parcialmente visible), pero quedarse cerca del límite ya no
      // reinicia la coreografía: hay que mover el scroll ≥60px.
      // .rd-stage no tiene transform propio (sólo sus hijos).
      observeReveal([stage], {
        enterMargin: '0px',
        threshold: 0.2,
        exitMargin: '60px 0px 60px 0px',
        onEnter: () => {
          stage.classList.remove('pre', 'exiting');
          onOpenStart();
        },
        onExit: () => {
          // Sólo animamos el cierre si ya se había abierto (skip primer render)
          if (!stage.classList.contains('pre')) stage.classList.add('exiting');
          onClose();
        },
      });
    } else {
      // Fallback: mostrar inmediatamente sin observer
      stage.classList.remove('pre');
      onOpenStart();
    }
  }
</script>
