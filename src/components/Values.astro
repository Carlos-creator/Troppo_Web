---
// Sección de propuesta de valor — 3 columnas con iconos SVG
---

<section class="values" id="nosotros">
  <div class="wrap">
    <div class="values-head">
      <h2>Menos obra civil. Más algoritmo.</h2>
      <p>
        Troppo traslada la complejidad del problema al software, no al hormigón ni a
        las cámaras.
      </p>
    </div>
    <div class="value-grid">
      <article class="value-card" data-reveal>
        <div class="icon-wrap">
          <svg class="icon" viewBox="0 0 34 34" aria-hidden="true">
            <rect x="4" y="4" width="26" height="26" rx="4" fill="none" stroke="#61E1E6" stroke-width="2" />
            <path d="M10 22 L16 12 L22 22" stroke="#D1EB78" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h3>Simulación sin riesgo</h3>
        <p>
          Prueba cada política de semaforización en el gemelo digital antes de tocar
          un semáforo real.
        </p>
      </article>
      <article class="value-card" data-reveal>
        <div class="icon-wrap">
          <svg class="icon" viewBox="0 0 34 34" aria-hidden="true">
            <circle cx="17" cy="17" r="6" fill="#61E1E6" />
            <circle cx="17" cy="17" r="13" fill="none" stroke="#D1EB78" stroke-width="2" />
          </svg>
        </div>
        <h3>Sensórica sin cámaras</h3>
        <p>
          LiDAR bajo un enfoque privacy-preserving: sin video invasivo, sin datos
          personales expuestos.
        </p>
      </article>
      <article class="value-card" data-reveal>
        <div class="icon-wrap">
          <svg class="icon" viewBox="0 0 34 34" aria-hidden="true">
            <path d="M6 26 L14 14 L20 20 L28 6" stroke="#61E1E6" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h3>Bimodal por diseño</h3>
        <p>Optimiza el flujo de carga pesada sin asfixiar la movilidad civil de la ciudad.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .values {
    background: rgba(3, 53, 68, 0.84);
    color: var(--cream);
    padding: 110px 0;
    position: relative;
    overflow: hidden;
  }
  /* Halos cyan ambientales en los extremos para dar profundidad */
  .values::before,
  .values::after {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
    opacity: 0.35;
  }
  .values::before {
    top: 10%;
    left: -180px;
    background: radial-gradient(circle, rgba(97, 225, 230, 0.14), transparent 70%);
  }
  .values::after {
    bottom: 5%;
    right: -180px;
    background: radial-gradient(circle, rgba(209, 235, 120, 0.10), transparent 70%);
  }

  .wrap { position: relative; z-index: 1; }

  .values-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }
  .values-head h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 38px;
    max-width: 520px;
    line-height: 1.2;
  }
  .values-head p {
    max-width: 380px;
    color: rgba(255, 248, 234, 0.85);   /* antes 0.7 — mejor contraste */
    font-size: 15.5px;
    line-height: 1.55;
  }

  /* --------- GRID DE CARDS --------- */
  .value-grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .value-card {
    background: rgba(255, 248, 234, 0.028);
    border: 1px solid rgba(255, 248, 234, 0.12);
    border-radius: 16px;
    padding: 34px 30px 32px;
    position: relative;
    overflow: hidden;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      background 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease;
  }

  /* Halo interior que se enciende con hover — sensación "activado" */
  .value-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 90% at 100% 0%,
      rgba(97, 225, 230, 0.14) 0%,
      transparent 55%
    );
    opacity: 0;
    transition: opacity 500ms ease;
    pointer-events: none;
  }
  .value-card:hover::before { opacity: 1; }

  .value-card:hover {
    transform: translateY(-5px);
    background: rgba(97, 225, 230, 0.045);
    border-color: rgba(97, 225, 230, 0.42);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
  }

  /* Contenedor del icono: chip cyan suave que se ilumina */
  .icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: rgba(97, 225, 230, 0.10);
    border: 1px solid rgba(97, 225, 230, 0.22);
    margin-bottom: 22px;
    transition:
      background 400ms ease,
      border-color 400ms ease,
      transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    z-index: 1;
  }
  .value-card:hover .icon-wrap {
    background: rgba(97, 225, 230, 0.18);
    border-color: var(--cyan);
    transform: scale(1.06) rotate(-2deg);
  }
  .value-card .icon {
    width: 34px;
    height: 34px;
    transition: filter 400ms ease;
  }
  .value-card:hover .icon {
    filter: drop-shadow(0 0 6px rgba(97, 225, 230, 0.7));
  }

  .value-card h3 {
    font-family: var(--font-title);
    font-size: 19px;
    font-weight: 700;
    color: var(--cream);
    letter-spacing: 0.2px;
    position: relative;
    z-index: 1;
  }
  .value-card p {
    margin-top: 12px;
    font-size: 14.8px;
    color: rgba(255, 248, 234, 0.82);   /* antes 0.68 — mucho más legible */
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  /* --------- REVEAL ON SCROLL --------- */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease, transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }
  [data-reveal]:nth-child(1) { transition-delay: 0ms; }
  [data-reveal]:nth-child(2) { transition-delay: 120ms; }
  [data-reveal]:nth-child(3) { transition-delay: 240ms; }

  @media (max-width: 860px) {
    .value-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .values-head h2 { font-size: 30px; }
    .value-card { padding: 28px 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .value-card,
    .icon-wrap,
    .value-card .icon {
      transition: none;
    }
  }
</style>

<script>
  // Reveal escalonado de los 3 cards al entrar al viewport
  const cards = document.querySelectorAll<HTMLElement>('.values [data-reveal]');
  if (cards.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            observer.unobserve(e.target);
          }
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );
    cards.forEach((c) => observer.observe(c));
  }
</script>
