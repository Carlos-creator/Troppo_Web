---
// Sección "Qué ofrece Troppo" (rúbrica sección 3) — 3 pilares:
// simulación de red vial + IA con aprendizaje por refuerzo + evidencia digital.
---

<section class="values" id="ofrece">
  <div class="wrap">
    <div class="values-head">
      <div class="values-head-left">
        <div class="values-eyebrow" data-vh>
          <span class="eyebrow-mark" aria-hidden="true"></span>
          ¿QUÉ OFRECE TROPPO?
        </div>
        <p data-vh>
          Troppo integra simulación de la red vial, aprendizaje por refuerzo y análisis
          de resultados en un mismo lugar. El cliente deja de decidir por estimación y
          pasa a decidir con evidencia del gemelo digital.
        </p>
      </div>
      <h2 class="values-h2">
        <span class="v-phrase" data-vh>
          <span class="v-num" aria-hidden="true">01</span>
          <span class="v-text"><em>Probar</em> antes.</span>
        </span>
        <span class="v-phrase" data-vh>
          <span class="v-num" aria-hidden="true">02</span>
          <span class="v-text">Optimizar con <em>IA</em>.</span>
        </span>
        <span class="v-phrase" data-vh>
          <span class="v-num" aria-hidden="true">03</span>
          <span class="v-text">Decidir con <em>evidencia</em>.</span>
        </span>
      </h2>
    </div>
    <div class="value-grid">
      <article class="value-card value-card--grid" data-reveal>
        <!-- Overlay a nivel de card: grid pattern con probes pulsantes -->
        <svg class="val-fx" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 25 L100 25 M0 50 L100 50 M0 75 L100 75 M25 0 L25 100 M50 0 L50 100 M75 0 L75 100" stroke="#61E1E6" stroke-width="0.35" opacity="0.35" />
          <circle class="val-fx-probe" cx="25" cy="25" r="2.2" fill="#61E1E6" />
          <circle class="val-fx-probe" cx="75" cy="25" r="2.2" fill="#61E1E6" />
          <circle class="val-fx-probe" cx="50" cy="50" r="2.2" fill="#61E1E6" />
          <circle class="val-fx-probe" cx="25" cy="75" r="2.2" fill="#61E1E6" />
          <circle class="val-fx-probe" cx="75" cy="75" r="2.2" fill="#61E1E6" />
          <circle class="val-fx-probe" cx="50" cy="25" r="2.2" fill="#D1EB78" />
          <circle class="val-fx-probe" cx="50" cy="75" r="2.2" fill="#D1EB78" />
        </svg>
        <div class="icon-wrap">
          <!-- Simulación: grid/red vial + trazado -->
          <svg class="icon" viewBox="0 0 34 34" aria-hidden="true">
            <rect x="4" y="4" width="26" height="26" rx="4" fill="none" stroke="#61E1E6" stroke-width="2" />
            <path d="M4 12 L30 12 M4 22 L30 22 M12 4 L12 30 M22 4 L22 30" stroke="#61E1E6" stroke-width="1" opacity="0.4" />
            <circle cx="12" cy="12" r="2" fill="#D1EB78" />
            <circle cx="22" cy="22" r="2" fill="#D1EB78" />
            <path d="M12 12 L22 22" stroke="#D1EB78" stroke-width="1.5" stroke-linecap="round" />
            <!-- Vehículo cyan viajando por la diagonal — flujo de tráfico -->
            <circle class="val-icon-traveler" cx="12" cy="12" r="1.4" fill="#61E1E6" />
            <!-- Probes cyan en otras intersecciones -->
            <circle class="val-icon-probe val-icon-probe-1" cx="22" cy="12" r="1.8" fill="#61E1E6" />
            <circle class="val-icon-probe val-icon-probe-2" cx="12" cy="22" r="1.8" fill="#61E1E6" />
            <circle class="val-icon-probe val-icon-probe-3" cx="17" cy="17" r="1.8" fill="#61E1E6" />
          </svg>
        </div>
        <h3>Simulaciones de la red vial</h3>
        <p>
          Reconstruimos el corredor completo en un gemelo digital. Probamos
          distintos escenarios de tráfico y comparamos sus resultados — sin
          arriesgar una sola maniobra en terreno.
        </p>
      </article>

      <article class="value-card value-card--ai" data-reveal>
        <!-- Overlay a nivel de card: red neuronal pulsando -->
        <svg class="val-fx" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <line x1="18" y1="22" x2="50" y2="50" stroke="#61E1E6" stroke-width="0.5" opacity="0.5" />
          <line x1="82" y1="25" x2="50" y2="50" stroke="#61E1E6" stroke-width="0.5" opacity="0.5" />
          <line x1="20" y1="78" x2="50" y2="50" stroke="#61E1E6" stroke-width="0.5" opacity="0.5" />
          <line x1="80" y1="80" x2="50" y2="50" stroke="#61E1E6" stroke-width="0.5" opacity="0.5" />
          <circle cx="18" cy="22" r="2" fill="#61E1E6" opacity="0.75" />
          <circle cx="82" cy="25" r="2" fill="#61E1E6" opacity="0.75" />
          <circle cx="20" cy="78" r="2" fill="#61E1E6" opacity="0.75" />
          <circle cx="80" cy="80" r="2" fill="#61E1E6" opacity="0.75" />
          <circle class="val-fx-brain" cx="50" cy="50" r="3" fill="#D1EB78" />
          <circle class="val-fx-syn val-fx-syn-1" cx="18" cy="22" r="1.4" fill="#61E1E6" />
          <circle class="val-fx-syn val-fx-syn-2" cx="82" cy="25" r="1.4" fill="#61E1E6" />
          <circle class="val-fx-syn val-fx-syn-3" cx="20" cy="78" r="1.4" fill="#61E1E6" />
          <circle class="val-fx-syn val-fx-syn-4" cx="80" cy="80" r="1.4" fill="#61E1E6" />
        </svg>
        <div class="icon-wrap">
          <!-- IA / red neuronal -->
          <svg class="icon" viewBox="0 0 34 34" aria-hidden="true">
            <circle cx="7" cy="9" r="2.4" fill="#61E1E6" />
            <circle cx="27" cy="10" r="2.4" fill="#61E1E6" />
            <circle cx="8" cy="25" r="2.4" fill="#61E1E6" />
            <circle cx="26" cy="25" r="2.4" fill="#61E1E6" />
            <line x1="7" y1="9" x2="17" y2="17" stroke="#61E1E6" stroke-width="1.2" opacity="0.7" />
            <line x1="27" y1="10" x2="17" y2="17" stroke="#61E1E6" stroke-width="1.2" opacity="0.7" />
            <line x1="8" y1="25" x2="17" y2="17" stroke="#61E1E6" stroke-width="1.2" opacity="0.7" />
            <line x1="26" y1="25" x2="17" y2="17" stroke="#61E1E6" stroke-width="1.2" opacity="0.7" />
            <!-- Núcleo pulsante -->
            <circle class="val-icon-brain" cx="17" cy="17" r="3.2" fill="#D1EB78" />
            <!-- Sinapsis viajando desde nodos-esquina hacia el centro -->
            <circle class="val-icon-syn val-icon-syn-1" cx="7" cy="9" r="1.2" fill="#61E1E6" />
            <circle class="val-icon-syn val-icon-syn-2" cx="27" cy="10" r="1.2" fill="#61E1E6" />
            <circle class="val-icon-syn val-icon-syn-3" cx="8" cy="25" r="1.2" fill="#61E1E6" />
            <circle class="val-icon-syn val-icon-syn-4" cx="26" cy="25" r="1.2" fill="#61E1E6" />
          </svg>
        </div>
        <h3>IA con aprendizaje por refuerzo</h3>
        <p>
          Las políticas de semaforización no vienen de reglas fijas: la IA
          aprende de cada ejecución y ajusta el flujo para reducir congestión y
          tiempos de espera.
        </p>
      </article>

      <article class="value-card value-card--chart" data-reveal>
        <!-- Overlay a nivel de card: scan + data points -->
        <svg class="val-fx" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <circle class="val-fx-dp" cx="20" cy="40" r="1.8" fill="#D1EB78" />
          <circle class="val-fx-dp" cx="45" cy="70" r="1.8" fill="#D1EB78" />
          <circle class="val-fx-dp" cx="70" cy="30" r="1.8" fill="#D1EB78" />
          <circle class="val-fx-dp" cx="88" cy="58" r="1.8" fill="#D1EB78" />
          <rect class="val-fx-scan" x="0" y="0" width="2.4" height="100" fill="#61E1E6" opacity="0.9" rx="1" />
        </svg>
        <div class="icon-wrap">
          <!-- Evidencia / gráfico ascendente -->
          <svg class="icon" viewBox="0 0 34 34" aria-hidden="true">
            <path d="M4 28 L4 6 M4 28 L30 28" stroke="#61E1E6" stroke-width="2" stroke-linecap="round" />
            <path class="val-icon-chart-line" d="M6 24 L12 18 L18 22 L24 12 L28 8" stroke="#D1EB78" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <!-- Data points pulsantes en secuencia -->
            <circle class="val-icon-dp val-icon-dp-1" cx="12" cy="18" r="1.8" fill="#D1EB78" />
            <circle class="val-icon-dp val-icon-dp-2" cx="18" cy="22" r="1.8" fill="#D1EB78" />
            <circle class="val-icon-dp val-icon-dp-3" cx="24" cy="12" r="1.8" fill="#D1EB78" />
            <!-- Barra vertical de scan cyan -->
            <rect class="val-icon-scan" x="4" y="6" width="0.8" height="22" fill="#61E1E6" opacity="0.85" rx="0.3" />
          </svg>
        </div>
        <h3>Evidencia para decidir</h3>
        <p>
          De estimaciones a evidencia cuantificable. Cada simulación deja
          métricas y configuración registradas para justificar el próximo
          paso con números, no con supuestos.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .values {
    background: rgba(3, 53, 68, 0.84);
    color: var(--cream);
    padding: 110px 0;
    position: relative;
    overflow: hidden;
  }
  /* Halos cyan ambientales en los extremos para dar profundidad */
  .values::before,
  .values::after {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
    opacity: 0.35;
  }
  .values::before {
    top: 10%;
    left: -180px;
    background: radial-gradient(circle, rgba(97, 225, 230, 0.14), transparent 70%);
  }
  .values::after {
    bottom: 5%;
    right: -180px;
    background: radial-gradient(circle, rgba(209, 235, 120, 0.10), transparent 70%);
  }

  .wrap { position: relative; z-index: 1; }

  .values-head {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: start;
  }
  .values-head-left {
    padding-top: 22px;
  }

  /* Eyebrow más prominente — 15px con marca cyan que se dibuja */
  .values-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--cyan);
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .eyebrow-mark {
    display: inline-block;
    width: 0;
    height: 2px;
    background: var(--cyan);
    box-shadow: 0 0 8px rgba(97, 225, 230, 0.6);
    border-radius: 2px;
    transition: width 900ms cubic-bezier(0.16, 1, 0.3, 1) 100ms;
  }
  .values-eyebrow[data-vh].revealed .eyebrow-mark {
    width: 42px;
  }

  /* H2 en 3 frases apiladas, cada una con badge de número */
  .values-h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 46px;
    line-height: 1.15;
    color: var(--cream);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    letter-spacing: -0.5px;
  }
  .v-phrase {
    display: inline-flex;
    align-items: baseline;
    gap: 18px;
    position: relative;
  }
  .v-num {
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 1.6px;
    color: var(--cyan);
    padding-top: 12px;
    min-width: 32px;
    opacity: 0.85;
    /* Pequeña "línea de goteo" cyan al lado de cada número */
    position: relative;
  }
  .v-num::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 30px;
    bottom: -6px;
    width: 1px;
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.55), transparent);
    opacity: 0;
    transition: opacity 500ms ease 300ms;
  }
  .v-phrase.revealed .v-num::after { opacity: 1; }
  .v-phrase:last-child .v-num::after { display: none; }
  .v-text em {
    font-style: italic;
    color: var(--cyan);
    font-weight: 500;
  }

  .values-head p {
    color: rgba(255, 248, 234, 0.85);
    font-size: 16px;
    line-height: 1.65;
    max-width: 440px;
    padding-left: 18px;
    border-left: 2px solid rgba(97, 225, 230, 0.35);
  }

  /* Reveal escalonado del header — cada elemento con data-vh entra
     con fade + up-translate. La sincronía se hace por transition-delay
     asignado en JS según orden de aparición. */
  [data-vh] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-vh].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .values-head {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .values-head-left { padding-top: 0; }
    .values-h2 { font-size: 30px; }
    .v-num { font-size: 11px; min-width: 26px; padding-top: 8px; }
    .v-phrase { gap: 12px; }
    .values-eyebrow { font-size: 13px; letter-spacing: 2.4px; }
    .eyebrow-mark { height: 1.5px; }
    .values-eyebrow[data-vh].revealed .eyebrow-mark { width: 32px; }
    .values-head p { font-size: 14.5px; padding-left: 14px; }
  }

  /* --------- GRID DE CARDS --------- */
  .value-grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .value-card {
    background: rgba(255, 248, 234, 0.028);
    border: 1px solid rgba(255, 248, 234, 0.12);
    border-radius: 16px;
    padding: 34px 30px 32px;
    position: relative;
    overflow: hidden;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      background 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease;
  }

  /* Halo interior que se enciende con hover — sensación "activado" */
  .value-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 90% at 100% 0%,
      rgba(97, 225, 230, 0.14) 0%,
      transparent 55%
    );
    opacity: 0;
    transition: opacity 500ms ease;
    pointer-events: none;
  }
  .value-card:hover::before { opacity: 1; }

  .value-card:hover {
    transform: translateY(-5px);
    background: rgba(97, 225, 230, 0.045);
    border-color: rgba(97, 225, 230, 0.42);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
  }

  /* Contenedor del icono: chip cyan suave que se ilumina */
  .icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: rgba(97, 225, 230, 0.10);
    border: 1px solid rgba(97, 225, 230, 0.22);
    margin-bottom: 22px;
    transition:
      background 400ms ease,
      border-color 400ms ease,
      transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    z-index: 1;
  }
  .value-card:hover .icon-wrap {
    background: rgba(97, 225, 230, 0.18);
    border-color: var(--cyan);
    transform: scale(1.06) rotate(-2deg);
  }
  .value-card .icon {
    width: 34px;
    height: 34px;
    transition: filter 400ms ease;
  }
  .value-card:hover .icon {
    filter: drop-shadow(0 0 6px rgba(97, 225, 230, 0.7));
  }

  .value-card h3 {
    font-family: var(--font-title);
    font-size: 19px;
    font-weight: 700;
    color: var(--cream);
    letter-spacing: 0.2px;
    position: relative;
    z-index: 1;
  }
  .value-card p {
    margin-top: 12px;
    font-size: 14.8px;
    color: rgba(255, 248, 234, 0.82);   /* antes 0.68 — mucho más legible */
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  /* --------- OVERLAY ANIMADO A NIVEL DE CARD --------- */
  /* SVG que cubre toda la card con la temática del icono a baja opacidad,
     por detrás del contenido. */
  .val-fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.08;
    z-index: 0;
  }
  .value-card:hover .val-fx {
    opacity: 0.14;
    transition: opacity 400ms ease;
  }

  /* Card 1 (grid) — probes pulsando en intersecciones */
  @keyframes val-fx-probe-pulse {
    0%, 100% { transform: scale(0); opacity: 0; }
    40%      { transform: scale(1); opacity: 1; }
    75%      { transform: scale(1.6); opacity: 0.25; }
  }
  .val-fx-probe {
    transform-box: fill-box;
    transform-origin: center;
    animation: val-fx-probe-pulse 2.6s ease-out infinite;
  }
  .val-fx-probe:nth-of-type(2) { animation-delay: 0.3s; }
  .val-fx-probe:nth-of-type(3) { animation-delay: 0.6s; }
  .val-fx-probe:nth-of-type(4) { animation-delay: 0.9s; }
  .val-fx-probe:nth-of-type(5) { animation-delay: 1.2s; }
  .val-fx-probe:nth-of-type(6) { animation-delay: 1.5s; }
  .val-fx-probe:nth-of-type(7) { animation-delay: 1.8s; }

  /* Card 2 (AI) — brain pulse + sinapsis fluyendo */
  @keyframes val-fx-brain {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.35); }
  }
  .val-fx-brain {
    transform-box: fill-box;
    transform-origin: center;
    animation: val-fx-brain 2.2s ease-in-out infinite;
  }
  .val-fx-syn {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Deltas de nodos → (50,50): (18,22)→+32,+28  (82,25)→-32,+25
     (20,78)→+30,-28  (80,80)→-30,-30 */
  @keyframes val-fx-syn-1 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(32px, 28px); opacity: 0; }
  }
  @keyframes val-fx-syn-2 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(-32px, 25px); opacity: 0; }
  }
  @keyframes val-fx-syn-3 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(30px, -28px); opacity: 0; }
  }
  @keyframes val-fx-syn-4 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(-30px, -30px); opacity: 0; }
  }
  .val-fx-syn-1 { animation: val-fx-syn-1 2.2s linear infinite 0s; }
  .val-fx-syn-2 { animation: val-fx-syn-2 2.2s linear infinite 0.55s; }
  .val-fx-syn-3 { animation: val-fx-syn-3 2.2s linear infinite 1.1s; }
  .val-fx-syn-4 { animation: val-fx-syn-4 2.2s linear infinite 1.65s; }

  /* Card 3 (chart) — scan + data points */
  @keyframes val-fx-scan {
    0%   { transform: translateX(0); opacity: 0; }
    10%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translateX(97px); opacity: 0; }
  }
  .val-fx-scan {
    transform-box: fill-box;
    transform-origin: center;
    animation: val-fx-scan 4s ease-in-out infinite;
  }
  @keyframes val-fx-dp {
    0%, 55%, 100% { transform: scale(1); }
    65%, 80%      { transform: scale(1.7); }
  }
  .val-fx-dp {
    transform-box: fill-box;
    transform-origin: center;
    animation: val-fx-dp 4s ease-in-out infinite;
  }
  .val-fx-dp:nth-of-type(2) { animation-delay: 0.6s; }
  .val-fx-dp:nth-of-type(3) { animation-delay: 1.2s; }
  .val-fx-dp:nth-of-type(4) { animation-delay: 1.8s; }

  /* --------- ANIMACIONES DENTRO DEL ICONO --------- */

  /* Card 1 icono — viajero cyan por la diagonal + probes */
  @keyframes val-icon-traveler {
    0%   { transform: translate(0, 0); opacity: 0; }
    12%  { opacity: 1; }
    88%  { opacity: 1; }
    100% { transform: translate(10px, 10px); opacity: 0; }
  }
  .val-icon-traveler {
    transform-box: fill-box;
    transform-origin: center;
    animation: val-icon-traveler 2.2s linear infinite;
    filter: drop-shadow(0 0 3px rgba(97, 225, 230, 0.85));
  }
  @keyframes val-icon-probe {
    0%, 100% { transform: scale(0); opacity: 0; }
    40%      { transform: scale(1); opacity: 1; }
    75%      { transform: scale(1.4); opacity: 0.3; }
  }
  .val-icon-probe {
    transform-box: fill-box;
    transform-origin: center;
    animation: val-icon-probe 2.1s ease-out infinite;
  }
  .val-icon-probe-2 { animation-delay: 0.7s; }
  .val-icon-probe-3 { animation-delay: 1.4s; }

  /* Card 2 icono — núcleo pulsante + sinapsis */
  @keyframes val-icon-brain {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.22); }
  }
  .val-icon-brain {
    transform-box: fill-box;
    transform-origin: center;
    animation: val-icon-brain 1.6s ease-in-out infinite;
  }
  .val-icon-syn {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Deltas hacia (17,17) desde:
     (7,9)→+10,+8   (27,10)→-10,+7
     (8,25)→+9,-8   (26,25)→-9,-8 */
  @keyframes val-icon-syn-1 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(10px, 8px); opacity: 0; }
  }
  @keyframes val-icon-syn-2 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(-10px, 7px); opacity: 0; }
  }
  @keyframes val-icon-syn-3 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(9px, -8px); opacity: 0; }
  }
  @keyframes val-icon-syn-4 {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(-9px, -8px); opacity: 0; }
  }
  .val-icon-syn-1 { animation: val-icon-syn-1 1.8s linear infinite 0s; }
  .val-icon-syn-2 { animation: val-icon-syn-2 1.8s linear infinite 0.45s; }
  .val-icon-syn-3 { animation: val-icon-syn-3 1.8s linear infinite 0.9s; }
  .val-icon-syn-4 { animation: val-icon-syn-4 1.8s linear infinite 1.35s; }

  /* Card 3 icono — scan + data points + line-drawing */
  @keyframes val-icon-scan {
    0%   { transform: translateX(0); opacity: 0.85; }
    88%  { transform: translateX(24px); opacity: 0.85; }
    100% { transform: translateX(24px); opacity: 0; }
  }
  .val-icon-scan {
    transform-box: fill-box;
    transform-origin: center;
    animation: val-icon-scan 2.6s ease-in-out infinite;
  }
  @keyframes val-icon-dp {
    0%, 55%, 100% { transform: scale(1); }
    65%, 80%      { transform: scale(1.6); }
  }
  .val-icon-dp {
    transform-box: fill-box;
    transform-origin: center;
    animation: val-icon-dp 2.6s ease-in-out infinite;
  }
  .val-icon-dp-2 { animation-delay: 0.55s; }
  .val-icon-dp-3 { animation-delay: 1.1s; }

  /* --------- REVEAL ON SCROLL --------- */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease, transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }
  [data-reveal]:nth-child(1) { transition-delay: 0ms; }
  [data-reveal]:nth-child(2) { transition-delay: 120ms; }
  [data-reveal]:nth-child(3) { transition-delay: 240ms; }

  @media (max-width: 860px) {
    .value-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .value-card { padding: 28px 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    [data-vh] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .eyebrow-mark { width: 42px; transition: none; }
    .v-num::after { opacity: 1; transition: none; }
    .value-card,
    .icon-wrap,
    .value-card .icon {
      transition: none;
    }
    /* Desactivamos animaciones temáticas por icono */
    .val-icon-traveler, .val-icon-probe,
    .val-icon-brain, .val-icon-syn,
    .val-icon-scan, .val-icon-dp {
      animation: none;
    }
    .val-icon-traveler, .val-icon-probe,
    .val-icon-syn, .val-icon-scan {
      display: none;
    }
    /* Ocultamos el overlay a nivel de card */
    .val-fx { display: none; }
  }
</style>

<script>
  // Reveal escalonado de las 3 cards — se re-anima cada vez que vuelven
  // al viewport. Al salir se quita .revealed para que la próxima entrada
  // dispare la animación de nuevo.
  const cards = document.querySelectorAll<HTMLElement>('.values [data-reveal]');
  if (cards.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('revealed');
          else e.target.classList.remove('revealed');
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );
    cards.forEach((c) => observer.observe(c));
  }

  // Reveal escalonado del header (eyebrow → 3 frases del h2 → párrafo).
  // Cada elemento [data-vh] recibe un transition-delay proporcional a su
  // orden de aparición para que "caigan" en secuencia.
  const headItems = Array.from(
    document.querySelectorAll<HTMLElement>('.values [data-vh]'),
  );
  if (headItems.length) {
    // Asigna transition-delay en base al orden en el DOM
    headItems.forEach((el, i) => {
      el.style.transitionDelay = `${i * 140}ms`;
    });
    const headObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('revealed');
          else e.target.classList.remove('revealed');
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.2 },
    );
    headItems.forEach((el) => headObserver.observe(el));
  }
</script>
