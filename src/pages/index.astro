---
import Base from '@layouts/Base.astro';
import ScrollRoad from '@components/ScrollRoad.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import Problem from '@components/Problem.astro';
import Values from '@components/Values.astro';
import HowItWorks from '@components/HowItWorks.astro';
import Dashboard from '@components/Dashboard.astro';
import Simulation from '@components/Simulation.astro';
import Scalability from '@components/Scalability.astro';
