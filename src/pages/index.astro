---
import Base from '@layouts/Base.astro';
import ScrollRoad from '@components/ScrollRoad.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import Desafio from '@components/Desafio.astro';
import Problem from '@components/Problem.astro';
import Values from '@components/Values.astro';
import PorQueTroppo from '@components/PorQueTroppo.astro';
import ParaQuien from '@components/ParaQuien.astro';
import HowItWorks from '@components/HowItWorks.astro';
import Dashboard from '@components/Dashboard.astro';
import Resultados from '@components/Resultados.astro';
import Scalability from '@components/Scalability.astro';
import Video from '@components/Video.astro';
import Empresa from '@components/Empresa.astro';
import Feria from '@components/Feria.astro';
import Contacto from '@components/Contacto.astro';
import Footer from '@components/Footer.astro';
---

<Base>
  <ScrollRoad />
  <Header />
  <main>
    <Hero />
    <Problem />
    <Values />
    <PorQueTroppo />
    <HowItWorks />
    <Dashboard />
    <Resultados />
    <ParaQuien />
    <Scalability />
    <Video />
    <Empresa />
    <!-- Contacto → CTA principal (único) → Feria de Software -->
    <Contacto />
    <Desafio />
    <Feria />
  </main>
  <Footer />
</Base>
